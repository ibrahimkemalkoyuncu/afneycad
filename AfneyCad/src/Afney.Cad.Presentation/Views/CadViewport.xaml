<UserControl x:Class="Afney.Cad.Presentation.Views.CadViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#15191C">
        <skia:SKElement x:Name="CadCanvas" 
                        PaintSurface="OnPaintSurface" 
                        MouseMove="CadCanvas_MouseMove" 
                        MouseDown="CadCanvas_MouseDown"
                        MouseUp="CadCanvas_MouseUp"
                        MouseWheel="CadCanvas_MouseWheel"
                        KeyDown="CadCanvas_KeyDown"
                        Focusable="True"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
            <!-- AutoCAD Tarzı Sağ Tıklama Menüsü -->
            <skia:SKElement.ContextMenu>
                <ContextMenu Background="#2D2D30" Foreground="White">
                    <MenuItem Header="🔄 Pan" Click="OnContextMenu_Pan" />
                    <MenuItem Header="🔍 Zoom Extents" Click="OnContextMenu_ZoomExtents" />
                    <Separator Background="#555"/>
                    <MenuItem Header="✅ Select All" Click="OnContextMenu_SelectAll" />
                    <MenuItem Header="🧹 Clear Selection" Click="OnContextMenu_ClearSelection" />
                    <Separator Background="#555"/>
                    <MenuItem Header="↩️ Undo" Click="OnContextMenu_Undo" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="↪️ Redo" Click="OnContextMenu_Redo" InputGestureText="Ctrl+Y"/>
                    <Separator Background="#555"/>
                    <MenuItem Header="📐 Properties" Click="OnContextMenu_Properties" />
                </ContextMenu>
            </skia:SKElement.ContextMenu>
        </skia:SKElement>
        
        <!-- Viewport Overlay Debug/Info -->
        <Border Background="#44000000" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Padding="5" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CoordinateText" Text="X: 0, Y: 0" Foreground="Lime" FontSize="10" FontFamily="Consolas"/>
                <Separator Margin="5,0" Background="#666"/>
                <TextBlock x:Name="ZoomText" Text="Z: 1.0" Foreground="Orange" FontSize="10" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
