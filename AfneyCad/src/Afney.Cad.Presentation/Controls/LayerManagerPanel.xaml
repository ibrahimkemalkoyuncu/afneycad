<UserControl x:Class="Afney.Cad.Presentation.Controls.LayerManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E2226" MinWidth="230">

    <UserControl.Resources>
        <!-- Row hover style -->
        <Style x:Key="LayerRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3040"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F3A5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon toggle button (NO hover trigger here — triggers go inside Button.Style in template) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D3340"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search bar -->
            <RowDefinition Height="*"/>    <!-- Layer list -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#252A35" Padding="8,5">
            <DockPanel>
                <TextBlock Text="KATMANLAR" FontSize="10" FontWeight="Bold"
                           Foreground="#7AA0CC" VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <Button Content="⟳" Style="{StaticResource IconBtn}" FontSize="11"
                        Click="OnRefresh_Click" ToolTip="Katmanları Yenile"
                        DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- ── Search ─────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#1A1E28" Padding="4,3" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#666"/>
                <TextBox x:Name="SearchBox" Background="#252A35" Foreground="#CCC"
                         BorderBrush="#444" BorderThickness="1" Padding="4,2"
                         FontSize="11" ToolTip="Katman adıyla filtrele"
                         TextChanged="OnSearch_TextChanged"/>
            </DockPanel>
        </Border>

        <!-- ── Column Header + Layer List ────────────────────── -->
        <Border Grid.Row="2" Background="#1A1E28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column titles -->
                <Border Grid.Row="0" Background="#252A35" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="2,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="10" Foreground="#888" HorizontalAlignment="Center" ToolTip="Görünürlük"/>
                        <TextBlock Grid.Column="1" Text="❄"  FontSize="10" Foreground="#888" HorizontalAlignment="Center" ToolTip="Dondur"/>
                        <TextBlock Grid.Column="2" Text="🔒" FontSize="10" Foreground="#888" HorizontalAlignment="Center" ToolTip="Kilitle"/>
                        <TextBlock Grid.Column="3" Text="■"  FontSize="10" Foreground="#888" HorizontalAlignment="Center" ToolTip="Renk"/>
                        <TextBlock Grid.Column="4" Text="Katman Adı" FontSize="10" Foreground="#888" Margin="4,0"/>
                    </Grid>
                </Border>

                <!-- Layer rows -->
                <ListView x:Name="LayerList"
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ItemContainerStyle="{StaticResource LayerRowStyle}"
                          SelectionChanged="LayerList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 💡 Görünürlük — style only in Button.Style (no duplicate attribute) -->
                                <Button Grid.Column="0"
                                        Content="{Binding BulbIcon}"
                                        Tag="{Binding Name}"
                                        Click="OnVisibilityToggle_Click"
                                        ToolTip="Görünürlüğü değiştir">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- ❄ Dondur -->
                                <Button Grid.Column="1"
                                        Content="{Binding FreezeIcon}"
                                        Tag="{Binding Name}"
                                        Click="OnFreezeToggle_Click"
                                        ToolTip="Katmanı dondur/çözdür">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 🔒 Kilit -->
                                <Button Grid.Column="2"
                                        Content="{Binding LockIcon}"
                                        Tag="{Binding Name}"
                                        Click="OnLockToggle_Click"
                                        ToolTip="Katmanı kilitle/aç">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Foreground" Value="#FA0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- ■ Renk swatch (Tag ile renk hex'i taşınır) -->
                                <Button Grid.Column="3"
                                        Style="{StaticResource IconBtn}"
                                        Tag="{Binding Name}"
                                        Click="OnColorClick"
                                        ToolTip="Rengi değiştir"
                                        Margin="2,2">
                                    <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                               Fill="{Binding ColorBrush}"/>
                                </Button>

                                <!-- Katman adı -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Name}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           ToolTip="{Binding Description}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CCC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Foreground" Value="#4AA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ── Bottom Toolbar ────────────────────────────── -->
        <Border Grid.Row="3" Background="#252A35" Padding="4,4" BorderBrush="#333" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <Button Content="＋ Yeni" Style="{StaticResource TbBtn}"
                        Click="OnNewLayer_Click" ToolTip="Yeni katman ekle"/>
                <Button Content="✎ Yeniden Adlandır" Style="{StaticResource TbBtn}"
                        Click="OnRename_Click" ToolTip="Seçili katmanı yeniden adlandır"/>
                <Button Content="🗑 Sil" Style="{StaticResource TbBtn}"
                        Click="OnDelete_Click" ToolTip="Seçili katmanı sil"/>
                <Button Content="☀ Tümünü Göster" Style="{StaticResource TbBtn}"
                        Click="OnShowAll_Click" ToolTip="Tüm katmanları görünür yap"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
