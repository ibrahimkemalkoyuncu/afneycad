<UserControl x:Class="Afney.Cad.Presentation.Controls.CostDashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E2226" MinWidth="180">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,4">
            <Border Background="#252A35" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                <TextBlock Text="MALİYET TAKİBİ" Foreground="#7AA0CC" FontSize="10" FontWeight="Bold"/>
            </Border>

            <!-- Toplam -->
            <Border Background="#0A1F38" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="TOPLAM MALİYET" Foreground="#424559" FontSize="9"/>
                    <TextBlock x:Name="TxtTotal" Text="0" Foreground="#0A84FF" FontSize="22" FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtCurrency" Text="TRY" Foreground="#424559" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- Kalemler -->
            <Expander Header="Kalem Detayları" IsExpanded="True" Foreground="#7AA0CC" FontSize="10" FontWeight="Bold">
                <StackPanel Margin="4,6,0,0">
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Boru" Foreground="#888" FontSize="11" Width="70"/>
                        <TextBlock x:Name="TxtPipe" Text="0" Foreground="#0088FF" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Fitting" Foreground="#888" FontSize="11" Width="70"/>
                        <TextBlock x:Name="TxtFitting" Text="0" Foreground="#F39C12" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Cihaz" Foreground="#888" FontSize="11" Width="70"/>
                        <TextBlock x:Name="TxtFixture" Text="0" Foreground="#2ECC71" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="İşçilik" Foreground="#888" FontSize="11" Width="70"/>
                        <TextBlock x:Name="TxtLabor" Text="0" Foreground="#E74C3C" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Expander>

            <!-- İstatistikler -->
            <Expander Header="Proje İstatistikleri" IsExpanded="True" Foreground="#7AA0CC" FontSize="10" FontWeight="Bold" Margin="0,6,0,0">
                <StackPanel Margin="4,6,0,0">
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Boru Adedi" Foreground="#888" FontSize="11" Width="80"/>
                        <TextBlock x:Name="TxtPipeCount" Text="0" Foreground="#CCC" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Toplam Boy" Foreground="#888" FontSize="11" Width="80"/>
                        <TextBlock x:Name="TxtTotalLength" Text="0 m" Foreground="#CCC" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Cihaz Adedi" Foreground="#888" FontSize="11" Width="80"/>
                        <TextBlock x:Name="TxtFixtureCount" Text="0" Foreground="#CCC" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Fitting" Foreground="#888" FontSize="11" Width="80"/>
                        <TextBlock x:Name="TxtFittingCount" Text="0" Foreground="#CCC" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Expander>

            <!-- Yenile Butonu -->
            <Button Content="Yenile" Click="OnRefresh_Click" Height="28" Margin="0,10,0,0"
                    Background="#24273A" Foreground="#858899" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
