<Window x:Class="Afney.Cad.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Afney.Cad.Presentation.Views"
        xmlns:controls="clr-namespace:Afney.Cad.Presentation.Controls"
        mc:Ignorable="d"
        Icon="Resources/afneycad_icon.png"
        Title="AfneyCAD Mechanical Kernel" Height="800" Width="1200"
        WindowState="Maximized"
        Background="#1E1E1E" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content + Left Toolbar -->
            <RowDefinition Height="Auto"/> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="White">
            <MenuItem Header="_Dosya">
                <MenuItem Header="Yeni Proje..." Click="OnNewProject" FontWeight="Bold" Foreground="Orange"/>
                <Separator/>
                <MenuItem Header="Yeni Dosya" InputGestureText="Ctrl+N" Click="OnNewFile"/>
                <MenuItem Header="Yeni Pencere" InputGestureText="Ctrl+Shift+N" Click="OnNewWindow"/>
                <Separator/>
                <MenuItem Header="Dosya Aç..." InputGestureText="Ctrl+O" Click="OnOpenFile"/>
                <MenuItem Header="Klasör Aç..." InputGestureText="Ctrl+K Ctrl+O" Click="OnOpenFolder"/>
                <Separator/>
                <MenuItem Header="Kaydet" InputGestureText="Ctrl+S" Click="OnSave"/>
                <MenuItem Header="Farklı Kaydet..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAs"/>
                <Separator/>
                <MenuItem Header="Otomatik Kaydet" IsCheckable="True" IsChecked="True" Click="OnAutoSave"/>
                <Separator/>
                <MenuItem Header="Editörü Kapat" InputGestureText="Ctrl+F4" Click="OnCloseEditor"/>
                <MenuItem Header="Klasörü Kapat" InputGestureText="Ctrl+K F" Click="OnCloseFolder"/>
                <MenuItem Header="Pencereyi Kapat" InputGestureText="Alt+F4" Click="OnCloseWindow"/>
            </MenuItem>
            <!-- Diğer Menüler -->
            <MenuItem Header="_Görünüm">
                <MenuItem Header="Zoom Extents" Click="OnZoomExtents"/>
                <Separator/>
                <MenuItem Header="Project Navigator" IsCheckable="True" IsChecked="False" Click="OnToggleProjectNavigator"/>
                <MenuItem Header="Intelligence Panel" IsCheckable="True" IsChecked="False" Click="OnToggleIntelligencePanel"/>
            </MenuItem>
            <MenuItem Header="_Mühendislik">
                <MenuItem Header="⚙️ Hesap Standardı Seçimi..." Click="OnStandardSelection" Foreground="#FFFF9800" FontWeight="Bold" ToolTip="EN806/DIN1988/TS1258 norm seçimi"/>
                <Separator/>
                <MenuItem Header="Tam Sistem Analizi ve Çap Seçimi" Click="OnAutoPipeSizing"/>
                <MenuItem Header="Vitrifiyeleri Otomatik Bağla (Auto Branch)" Click="OnAutoBranchingClick" ToolTip="Seçilen odadaki tüm cihazları ana kolona bağlar."/>
                <Separator/>
                <MenuItem Header="📐 Boru Sihirbazı (Pipe Wizard)..." Click="OnPipeWizard" Foreground="#FF7CFC00" FontWeight="Bold" ToolTip="Şablonla otomatik tesisat üretimi"/>
                <MenuItem Header="🔧 Reseptör Kütüphanesi..." Click="OnFixtureLibrary" ToolTip="Vitrifiye kataloğu - sürükle bırak"/>
                <MenuItem Header="🧱 Duvara Paralel Boru Çiz..." Click="OnWallParallelRoute" Foreground="#FF7CFC00" ToolTip="Duvar kenarından ofsetli otomatik boru rotalama"/>
                <Separator/>
                <MenuItem Header="Dinamik Lejant Oluştur" Click="OnGenerateLegend" ToolTip="Kullanılan sembolleri ve hat tiplerini içeren tabloyu çizime ekler."/>
                <MenuItem Header="Metraj Listesi (BOQ)" Click="OnGenerateBOM"/>
                <MenuItem Header="Tüm Sistem Hidrolik Hesap Raporu" Click="OnGenerateHydraulicReport" Foreground="Cyan"/>
                <MenuItem Header="📊 Hesaplama Tablosu (Calculation Sheet)" Click="OnCalculationTable" Foreground="#FFFFCC00" FontWeight="Bold" ToolTip="Boru segmenti bazlı profesyonel hesap föyü"/>
                <MenuItem Header="Pompa ve Hidrofor Seçimi" Click="OnPumpSelection"/>
                <MenuItem Header="Kolon Şeması Oluştur (Riser)" Click="OnRiserGenerateCommand" />
                <Separator/>
                <MenuItem Header="Basınç Kaybı Hesabı" Click="OnPressureDropCalc"/>
                <MenuItem Header="🚿 Pis Su / Yağmur Suyu Hesabı..." Click="OnWasteWaterDesign" Foreground="#FF87CEEB" ToolTip="TS EN 12056 pis su ve yağmur suyu tasarımı"/>
                <MenuItem Header="🧯 Fosseptik/Rögar Boyutlandırma..." Click="OnSepticTankDesign" Foreground="#FFCC7722" ToolTip="TS 2873 fosseptik hacim ve rögar hesabı"/>
                <MenuItem Header="🔥 Yangın Söndürme (Sprinkler)..." Click="OnFireFightingDesign" Foreground="#FFFF4444" FontWeight="Bold" ToolTip="NFPA 13 / EN 12845 sprinkler sistemi tasarımı"/>
                <Separator/>
                <MenuItem Header="✏️ Otomatik Etiketleme (DN/Debi/Hız)" Click="OnAutoAnnotate" ToolTip="Tüm borulara çap, debi ve hız etiketlerini yazar"/>
                <MenuItem Header="🗑️ Etiketleri Temizle" Click="OnClearAnnotations"/>
                <MenuItem Header="🧊 3D Boru Görünümü..." Click="OnPipe3DView" ToolTip="Tesisat sisteminin 3D katı model görünümü"/>
            </MenuItem>
            <MenuItem Header="Bina">
                <MenuItem Header="Bina Özellikleri..." Click="OnBuildingProperties"/>
                <Separator/>
                <MenuItem Header="Kat Yöneticisi..." Click="OnLevelManager"/>
                <MenuItem Header="🏢 Çok Katlı Bina Yönetimi..." Click="OnMultiStoryManager" Foreground="#FF7CFC00" FontWeight="Bold" ToolTip="Kat tasarımı, kolon üretimi, kat kopyalama"/>
                <Separator/>
                <MenuItem Header="Birim Ayarları..." IsEnabled="False" ToolTip="Yakında"/>
                <Separator/>
                <MenuItem Header="Mimariyi Tara (Recognize)" Click="OnRecognizeArchitecture" ToolTip="Mimari layerları analiz ederek duvar ve kapıları tespit eder."/>
                <Separator/>
                <MenuItem Header="Mimariyi Ölçekle ve Blokla (WBlock)..." Click="OnWBlockCommand" Foreground="Cyan" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Mahal Analizi Export (JSON)..." Click="OnExportMahalData" Foreground="LimeGreen" FontWeight="Bold"/>
            </MenuItem>
            <MenuItem Header="_Raporlar" Foreground="#FFAADDFF">
                <MenuItem Header="📄 Sistem Raporu (HTML/CSV/RTF)..." Click="OnReportExport" FontWeight="Bold" ToolTip="Profesyonel mühendislik raporu dışa aktarma"/>
                <MenuItem Header="📋 Teknik Şartname Oluştur..." Click="OnSpecificationExport" ToolTip="TMMOB formatında 5 bölümlü teknik şartname"/>
                <MenuItem Header="📐 Kolon Şeması (SVG)..." Click="OnRiserDiagramExport" ToolTip="Kat bazlı dikey tesisat şeması — vektörel çıktı"/>
            </MenuItem>
            
            <MenuItem Header="AutoBLD" Foreground="#FFE64D">
                <MenuItem Header="Mimari Belirle (Define Building)..." Click="OnDefineBuilding"/>
             </MenuItem>
        </Menu>

        <!-- Top Mechanical Toolbar -->
        <ToolBarTray Grid.Row="1" Background="#2D2D30">
            <ToolBar Background="#2D2D30" Foreground="White">
                <TextBlock Text="MEKANİK HAT:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="Bold" Foreground="Orange"/>
                
                <TextBlock Text="Tip:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                <ComboBox x:Name="SystemTypeCombo" Width="100" SelectedIndex="0" SelectionChanged="OnMechanicalSettingsChanged">
                    <ComboBoxItem Content="Pis Su (Sanitary)" Tag="WasteWater"/>
                    <ComboBoxItem Content="Temiz Su (DomesticCold)" Tag="DomesticColdWater"/>
                    <ComboBoxItem Content="Sıcak Su (DomesticHot)" Tag="DomesticHotWater"/>
                </ComboBox>
        
                <TextBlock Text="Ø" VerticalAlignment="Center" Margin="5,0,2,0"/>
                <ComboBox x:Name="PipeSizeCombo" Width="60" SelectedIndex="2" SelectionChanged="OnMechanicalSettingsChanged">
                    <ComboBoxItem Content="50" Tag="50"/>
                    <ComboBoxItem Content="75" Tag="75"/>
                    <ComboBoxItem Content="110" Tag="110"/>
                    <ComboBoxItem Content="160" Tag="160"/>
                </ComboBox>

                <TextBlock Text="Mat:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                <ComboBox x:Name="MaterialCombo" Width="70" SelectedIndex="0" SelectionChanged="OnMechanicalSettingsChanged">
                    <ComboBoxItem Content="PVC" Tag="PVC"/>
                    <ComboBoxItem Content="PP-R" Tag="PPR"/>
                </ComboBox>
                
                <Separator/>
                <!-- Mühendislik Araçları -->
                <Button Content="🏢 Kat Yöneticisi" Click="OnLevelManager" Padding="5" Background="#333" Foreground="Yellow" Margin="2,0"/>
                <Button Content="🔍 Mimari Tara" Click="OnRecognizeArchitecture" Padding="5" Background="#333" Foreground="Orange" Margin="2,0" ToolTip="Layer isimlerinden duvar/kapı/pencere tespiti yapar"/>
                <Button Content="🏠 Akıllı Mahal" Click="OnSmartDetectRoomClick" Padding="5" Background="#333" Foreground="Cyan" Margin="2,0" ToolTip="Tek tıklama ile otomatik oda tanıma"/>
                <Button Content="🚿 Mahal Tanımla" Click="OnSelectRoom" Padding="5" Background="#333" Foreground="LimeGreen" Margin="2,0" ToolTip="Nokta tıklayarak manuel oda tanıma"/>
                <Separator/>
                <Button Content="🔗 Otomatik Bağla" Click="OnAutoBranchingClick" Padding="5" Background="#222" Foreground="#00FF7F" Margin="2,0" ToolTip="Cihazları kolona otomatik bağlar"/>
                <Button Content="🏗️ Kolon Bağlantısı" Click="OnRiserConnection" Padding="5" Background="#222" Foreground="#FF4500" Margin="2,0" ToolTip="Yatay hattı dikey kolona bağlar"/>
                <Separator/>
                <Button x:Name="View2DBtn" Content="2D" Click="OnToggle2DView" Padding="8,2" Background="Cyan" Foreground="Black" FontWeight="Bold" Margin="2,0"/>
                <Button x:Name="View3DBtn" Content="3D" Click="OnToggle3DView" Padding="8,2" Background="#444" Foreground="White" Margin="2,0"/>
                <Separator/>
                <Button Content="📊 HESAPLA" Click="OnRecalculateSystem" Padding="5" Background="OrangeRed" Foreground="White" FontWeight="Bold" Margin="2,0"/>
                <Button Content="📝 METRAJ (BOM)" Click="OnGenerateBOM" Padding="5" Background="#4CAF50" Foreground="White" Margin="2,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content Area (Navigator + Viewport + Intelligence) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Project Navigator -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="Auto"/> <!-- Tools (Left) -->
                <ColumnDefinition Width="*"/>    <!-- Viewport -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="Auto"/> <!-- Intelligence -->
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT PANEL: PROJECT NAVIGATOR -->
            <controls:ProjectNavigatorView x:Name="ProjectNavigatorPanel" Grid.Column="0" Width="220" BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Visibility="Collapsed"/>
            
            <GridSplitter Grid.Column="1" Width="4" Background="#1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- 2. LEFT TOOLBAR (FINE SANI STYLE) -->
            <ToolBarTray Grid.Column="2" Orientation="Vertical" Background="#333337" IsLocked="True">
                 <ToolBar Band="1" BandIndex="1" Background="#333337" Foreground="White">
                    <ToolBar.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Width" Value="45"/>
                            <Setter Property="Height" Value="45"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ToolBar.Resources>
                    
                    <Button Content="Line" Click="OnLineCommand" ToolTip="Çizgi (L)"/>
                    <Button Content="Circle" Click="OnCircleCommand" ToolTip="Daire (C)"/>
                    <Button Content="Pipe" Click="OnDrawPipeCommand" ToolTip="Boru Çiz (P)" Foreground="Orange" FontWeight="Bold"/>
                    <Button Content="WallFix" Click="OnPlaceFixtureOnWall" ToolTip="Duvara Cihaz Yerleştir" Foreground="Cyan"/>
                    <Separator/>
                    <Button Content="Move" ToolTip="Taşı (M)"/>
                    <Button Content="Copy" ToolTip="Kopyala (CO)"/>
                    <Separator/>
                    <Button Content="Mahal" Click="OnDefineMahalCommand" ToolTip="Mahal Tanımla (MA)" Foreground="LightGreen" FontWeight="Bold"/>
                    <Button Content="Analiz" Click="OnInspectMahalCommand" ToolTip="Mahal Analizi (MAN)" Foreground="Yellow"/>
                    <Separator/>
                    <Button Content="Hesap" Click="OnRecalculatePlumbing" ToolTip="Tesisat Hesapla" Foreground="OrangeRed" FontWeight="Bold"/>
                    <Button Content="Şema" Click="OnRiserGenerateCommand" ToolTip="Kolon Şeması Üret (KS)" Foreground="MediumPurple"/>
                    <Button Content="Spec" Click="OnAnalyzeSpecClick" ToolTip="Keşif Özeti &amp; Teknik Şartname (S21)" Foreground="#00FF7F" FontWeight="Bold"/>
                    <Button Content="İzo-Şema" Click="OnShowIsometricScheme" ToolTip="Canlı İzometrik Şema (S18)" Foreground="Cyan" FontWeight="Bold"/>
                </ToolBar>
            </ToolBarTray>

            <!-- 3. CENTER: VIEWPORT -->
            <Border Grid.Column="3" Background="#15191C" CornerRadius="0" Margin="0" BorderThickness="0">
                <TabControl x:Name="DocumentTabs" Background="Transparent" BorderThickness="0" Padding="0" 
                            SelectionChanged="OnTabChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="#2D2D2D" BorderBrush="#111" BorderThickness="0,0,1,0" Padding="12,6" CornerRadius="4,4,0,0" Margin="0,0,1,0">
                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock x:Name="TitleText" Text="{TemplateBinding Header}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                 <Button Grid.Column="1" Content="✕" Width="16" Height="16" FontSize="10" Background="Transparent" Foreground="#666" BorderThickness="0" Padding="0" Click="OnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                     <Button.Style>
                                                         <Style TargetType="Button">
                                                             <Setter Property="Template">
                                                                 <Setter.Value> 
                                                                     <ControlTemplate TargetType="Button">
                                                                         <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                         </Border>
                                                                     </ControlTemplate>
                                                                 </Setter.Value>
                                                             </Setter>
                                                             <Style.Triggers>
                                                                 <Trigger Property="IsMouseOver" Value="True">
                                                                     <Setter Property="Background" Value="#444"/>
                                                                     <Setter Property="Foreground" Value="Red"/>
                                                                 </Trigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </Button.Style>
                                                 </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#15191C"/> <!-- Aktif Tab Rengi, Viewport ile aynı -->
                                                <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                                <Setter TargetName="TitleText" Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                               <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <!-- Sekmeler kod tarafından eklenecek -->
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="4" Width="4" Background="#1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- 4. RIGHT PANEL: INTELLIGENCE & PROPERTIES -->
            <controls:IntelligencePanel Grid.Column="5" x:Name="RightPanel" Width="250" Visibility="Collapsed"/>
        </Grid>


        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KOMUT:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="Bold"/>
                    <TextBox x:Name="CommandInput" Width="200" Background="#2D2D30" Foreground="White" BorderBrush="#007ACC" KeyDown="CommandInput_KeyDown" CaretBrush="White"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CoordinateText" Text="0.0, 0.0, 0.0" FontFamily="Consolas"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="Zoom: 100%"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
