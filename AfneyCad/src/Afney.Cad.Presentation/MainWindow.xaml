<Window x:Class="Afney.Cad.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Afney.Cad.Presentation.Controls"
        mc:Ignorable="d"
        Icon="Resources/afneycad_icon.png"
        Title="AfneyCAD" Height="800" Width="1200"
        WindowState="Maximized"
        Background="#12141A" Foreground="#E1E4EE"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- ══ RENK KAYNAKLARI ══════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Bg1"       Color="#12141A"/>
        <SolidColorBrush x:Key="Bg2"       Color="#1A1C24"/>
        <SolidColorBrush x:Key="Bg3"       Color="#1E2029"/>
        <SolidColorBrush x:Key="Bg4"       Color="#24273A"/>
        <SolidColorBrush x:Key="Accent"    Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentDim" Color="#0066CC"/>
        <SolidColorBrush x:Key="Text1"     Color="#E1E4EE"/>
        <SolidColorBrush x:Key="Text2"     Color="#858899"/>
        <SolidColorBrush x:Key="Border1"   Color="#252836"/>
        <SolidColorBrush x:Key="Border2"   Color="#323548"/>
        <SolidColorBrush x:Key="Green"     Color="#2ECC71"/>
        <SolidColorBrush x:Key="Orange"    Color="#F39C12"/>
        <SolidColorBrush x:Key="Red"       Color="#E74C3C"/>

        <!-- ══ RİBBON BUTON STİLLERİ ════════════════════════════════════════════ -->

        <!-- Büyük Ikon Buton: Ana eylemler için — 68×72px -->
        <Style x:Key="RbnLarge" TargetType="Button">
            <Setter Property="Width"           Value="74"/>
            <Setter Property="Height"          Value="76"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#D4D6E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin"          Value="2,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3148"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RbnLargeAccent" TargetType="Button" BasedOn="{StaticResource RbnLarge}">
            <Setter Property="Foreground" Value="#70C4FF"/>
        </Style>
        <Style x:Key="RbnLargeGreen" TargetType="Button" BasedOn="{StaticResource RbnLarge}">
            <Setter Property="Foreground" Value="#2ECC71"/>
        </Style>
        <Style x:Key="RbnLargeOrange" TargetType="Button" BasedOn="{StaticResource RbnLarge}">
            <Setter Property="Foreground" Value="#F39C12"/>
        </Style>
        <Style x:Key="RbnLargeRed" TargetType="Button" BasedOn="{StaticResource RbnLarge}">
            <Setter Property="Foreground" Value="#E74C3C"/>
        </Style>

        <!-- Orta Buton: yatay düzen, okunabilir font -->
        <Style x:Key="RbnMed" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#D4D6E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Margin"          Value="2,2"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3148"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RbnMedAccent"  TargetType="Button" BasedOn="{StaticResource RbnMed}">
            <Setter Property="Foreground" Value="#60BAFF"/>
        </Style>
        <Style x:Key="RbnMedGreen"   TargetType="Button" BasedOn="{StaticResource RbnMed}">
            <Setter Property="Foreground" Value="#2ECC71"/>
        </Style>
        <Style x:Key="RbnMedOrange"  TargetType="Button" BasedOn="{StaticResource RbnMed}">
            <Setter Property="Foreground" Value="#F39C12"/>
        </Style>
        <Style x:Key="RbnMedRed"     TargetType="Button" BasedOn="{StaticResource RbnMed}">
            <Setter Property="Foreground" Value="#E74C3C"/>
        </Style>

        <!-- Küçük Buton: kompakt ama okunabilir -->
        <Style x:Key="RbnBtn" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#C0C3D6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Margin"          Value="2,2"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3148"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RbnAccent"  TargetType="Button" BasedOn="{StaticResource RbnBtn}">
            <Setter Property="Foreground" Value="#60BAFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RbnOk"      TargetType="Button" BasedOn="{StaticResource RbnBtn}">
            <Setter Property="Foreground" Value="#2ECC71"/>
        </Style>
        <Style x:Key="RbnWarn"    TargetType="Button" BasedOn="{StaticResource RbnBtn}">
            <Setter Property="Foreground" Value="#E74C3C"/>
        </Style>

        <!-- ══ AKTİVİTE ÇUBUĞU STİLİ (VS Code tarzı) ══════════════════════════ -->
        <Style x:Key="ActivityBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#7A7D94"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2233"/>
                                <Setter Property="Foreground"                  Value="#E1E4EE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Ribbon (TabControl spans 0+1) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>     <!-- Row 2: Content -->
            <RowDefinition Height="36"/>    <!-- Row 3: Status Bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  RIBBON                                                              -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#1A1C24"
                BorderBrush="#252836" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>   <!-- Quick Access Bar -->
                    <RowDefinition Height="Auto"/> <!-- Tabs + Content -->
                </Grid.RowDefinitions>

                <!-- ── Quick Access Bar ──────────────────────────────────────────── -->
                <Border Grid.Row="0" Background="#12141A" Padding="8,0">
                    <DockPanel>
                        <!-- Logo + Version -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Image Source="Resources/afneycad_icon.png" Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="AfneyCAD" FontWeight="Bold" Foreground="#0A84FF"
                                       FontSize="14" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <TextBlock Text=" v4.0" Foreground="#4A4D62" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                        <!-- Quick Access Buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button Content="📄" Click="OnNewFile"    ToolTip="Yeni (Ctrl+N)"      Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Button Content="📁" Click="OnOpenFile"   ToolTip="Aç (Ctrl+O)"        Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Button Content="💾" Click="OnSave"       ToolTip="Kaydet (Ctrl+S)"    Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Rectangle Width="1" Fill="#2E3148" Margin="6,6"/>
                            <Button Content="📂" Click="OnNewProject" ToolTip="Yeni Proje"         Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Rectangle Width="1" Fill="#2E3148" Margin="6,6"/>
                            <Button Content="ℹ" Click="OnProjectInfoCommand" ToolTip="Proje Bilgileri" Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Button Content="🖨" Click="OnPrintPreviewCommand" ToolTip="Baskı Önizleme" Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Rectangle Width="1" Fill="#2E3148" Margin="6,6"/>
                            <Button x:Name="BtnRecentFiles" Content="🕐" Click="OnRecentFilesClick" ToolTip="Son Açılan Dosyalar" Width="34" Height="30" Background="Transparent" Foreground="#A0A3B8" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                            <Popup x:Name="RecentFilesPopup" PlacementTarget="{Binding ElementName=BtnRecentFiles}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="#1A1C24" BorderBrush="#0A84FF" BorderThickness="1" CornerRadius="6"
                                        MinWidth="350" MaxHeight="400">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#14151C" Padding="10,6" CornerRadius="6,6,0,0">
                                            <TextBlock Text="  Son Açılan Dosyalar" Foreground="#70C4FF" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel x:Name="RecentFilesList" Grid.Row="1" Margin="4"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── Tab Control ───────────────────────────────────────────────── -->
                <TabControl Grid.Row="1" Background="#1E2029" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" Padding="18,9" Margin="0"
                                                Background="Transparent" Cursor="Hand">
                                            <TextBlock x:Name="TabText"
                                                       Text="{TemplateBinding Header}"
                                                       Foreground="#7A7D94"
                                                       FontSize="13" FontWeight="Medium"
                                                       FontFamily="Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background"       Value="#1E2029"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush"     Value="#0A84FF"/>
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,3,0,0"/>
                                                <Setter TargetName="TabText"   Property="Foreground"      Value="#E1E4EE"/>
                                                <Setter TargetName="TabText"   Property="FontWeight"      Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#1A1D28"/>
                                                <Setter TargetName="TabText"   Property="Foreground" Value="#C8CADC"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="TabText" Property="Foreground" Value="#333548"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ══════════════════════════════════════════════════════════ -->
                    <!-- TAB 1: SİSTEM                                             -->
                    <!-- ══════════════════════════════════════════════════════════ -->
                    <TabItem Header="1. Sistem" x:Name="TabSystem">
                        <Border Background="#1E2029" Padding="4,6,4,4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">

                                    <!-- Standart -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource RbnLargeAccent}"
                                                    Click="OnStandardSelection"
                                                    ToolTip="Hesap standardı seçin">
                                                <StackPanel>
                                                    <TextBlock Text="⚙" FontSize="24" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Norm" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Seçimi" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Standart" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bina Ayarları -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource RbnLarge}" Click="OnBuildingProperties" ToolTip="Bina özellikleri">
                                                    <StackPanel>
                                                        <TextBlock Text="🏠" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Özellikler" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}" Click="OnLevelManager" ToolTip="Kat Yöneticisi">
                                                    <StackPanel>
                                                        <TextBlock Text="📶" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Kat Yön." FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLargeAccent}" Click="OnMultiStoryManager" ToolTip="Çok Katlı Yöneticisi">
                                                    <StackPanel>
                                                        <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Çok Katlı" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Bina Ayarları" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Süreç -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource RbnLargeGreen}"
                                                    Click="OnConfirmSystemSettings"
                                                    ToolTip="Sonraki adımların kilidini açar">
                                                <StackPanel>
                                                    <TextBlock Text="✅" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Ayarları" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Onayla" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Süreç" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Katman Seçici -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,0,0">
                                                <Border x:Name="ActiveLayerColorDot"
                                                        Width="14" Height="14" CornerRadius="3"
                                                        Background="#FF00FF" VerticalAlignment="Center"
                                                        Margin="0,0,5,0" BorderBrush="#3A3D50" BorderThickness="1"/>
                                                <Grid>
                                                    <Button x:Name="LayerPickerBtn"
                                                            Width="170" Height="26"
                                                            Background="#14151C" Foreground="#C8CADC"
                                                            BorderBrush="#2E3045" BorderThickness="1"
                                                            FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="6,0,20,0"
                                                            Click="OnLayerPickerBtnClick"
                                                            ToolTip="Aktif katmanı seçin"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="LayerBtnBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <Grid>
                                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="{TemplateBinding Padding}"/>
                                                                        <TextBlock Text="▾" Foreground="#60BAFF"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,6,0" FontSize="11"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="LayerBtnBorder" Property="BorderBrush" Value="#0A84FF"/>
                                                                        <Setter TargetName="LayerBtnBorder" Property="Background" Value="#1A1D28"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock x:Name="ActiveLayerLabel" Text="0"
                                                                   Foreground="#C8CADC" FontFamily="Consolas" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Popup x:Name="LayerPickerPopup"
                                                           PlacementTarget="{Binding ElementName=LayerPickerBtn}"
                                                           Placement="Bottom" StaysOpen="False"
                                                           AllowsTransparency="True" PopupAnimation="Slide">
                                                        <Border Background="#1A1C24" BorderBrush="#0A84FF"
                                                                BorderThickness="1" CornerRadius="6"
                                                                MinWidth="320" MaxHeight="420">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Background="#14151C"
                                                                        Padding="10,5" CornerRadius="6,6,0,0">
                                                                    <TextBlock Text="  Katmanlar" Foreground="#60BAFF"
                                                                               FontSize="11" FontWeight="Bold"/>
                                                                </Border>
                                                                <ScrollViewer Grid.Row="1"
                                                                              VerticalScrollBarVisibility="Auto"
                                                                              MaxHeight="380"
                                                                              CanContentScroll="True">
                                                                    <ListBox x:Name="LayerPickerList"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                             SelectionMode="Single"
                                                                             VirtualizingPanel.IsVirtualizing="True">
                                                                        <ListBox.ItemContainerStyle>
                                                                            <Style TargetType="ListBoxItem">
                                                                                <Setter Property="Background"              Value="Transparent"/>
                                                                                <Setter Property="BorderThickness"         Value="0,0,0,1"/>
                                                                                <Setter Property="BorderBrush"            Value="#1E2029"/>
                                                                                <Setter Property="Padding"                 Value="4,3"/>
                                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#1F2A3E"/>
                                                                                        <Setter Property="BorderBrush" Value="#0A84FF"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter Property="Background" Value="#0A3A6A"/>
                                                                                        <Setter Property="BorderBrush" Value="#0A84FF"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="2,1" Height="28">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="26"/>
                                                                                        <ColumnDefinition Width="26"/>
                                                                                        <ColumnDefinition Width="26"/>
                                                                                        <ColumnDefinition Width="18"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Button Grid.Column="0" Content="{Binding VisibilityIcon}"
                                                                                            FontSize="12" Background="Transparent"
                                                                                            BorderThickness="0" Cursor="Hand"
                                                                                            ToolTip="Katmanı Gizle/Göster"
                                                                                            Tag="{Binding Name}"
                                                                                            Click="OnLayerVisibilityToggle_Click"/>
                                                                                    <Button Grid.Column="1" Content="{Binding FreezeIcon}"
                                                                                            FontSize="12" Background="Transparent"
                                                                                            BorderThickness="0" Cursor="Hand"
                                                                                            ToolTip="Katmanı Dondur/Çöz"
                                                                                            Tag="{Binding Name}"
                                                                                            Click="OnLayerFreezeToggle_Click">
                                                                                        <Button.Foreground><SolidColorBrush Color="#44CCFF"/></Button.Foreground>
                                                                                    </Button>
                                                                                    <Button Grid.Column="2" Content="{Binding LockIcon}"
                                                                                            FontSize="12" Background="Transparent"
                                                                                            BorderThickness="0" Cursor="Hand"
                                                                                            ToolTip="Katmanı Kilitle/Aç"
                                                                                            Tag="{Binding Name}"
                                                                                            Click="OnLayerLockToggle_Click">
                                                                                        <Button.Foreground><SolidColorBrush Color="#F39C12"/></Button.Foreground>
                                                                                    </Button>
                                                                                    <Border Grid.Column="3"
                                                                                            Width="14" Height="14" CornerRadius="3"
                                                                                            Background="{Binding ColorBrush}"
                                                                                            BorderBrush="#555" BorderThickness="1"
                                                                                            VerticalAlignment="Center"/>
