<Window x:Class="Afney.Cad.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Afney.Cad.Presentation.Views"
        xmlns:controls="clr-namespace:Afney.Cad.Presentation.Controls"
        mc:Ignorable="d"
        Icon="Resources/afneycad_icon.png"
        Title="AfneyCAD Mechanical Kernel" Height="800" Width="1200"
        WindowState="Maximized"
        Background="#1E1E1E" Foreground="White"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Ribbon -->
            <RowDefinition Height="Auto"/> <!-- Ribbon Panel -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM DARK RIBBON — AfneyCAD Professional                    -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR: Logo + Quick Access -->
                <Border Grid.Row="0" Background="#1B1B1C" Padding="4,2">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Image Source="Resources/afneycad_icon.png" Width="20" Height="20" Margin="4,0"/>
                            <TextBlock Text="AfneyCAD" FontWeight="Bold" Foreground="#00AAFF" FontSize="13" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="📁" Click="OnOpenFile" ToolTip="Dosya Aç (Ctrl+O)" Width="26" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13"/>
                            <Button Content="💾" Click="OnSave" ToolTip="Kaydet (Ctrl+S)" Width="26" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13"/>
                            <Button Content="📄" Click="OnNewFile" ToolTip="Yeni Dosya" Width="26" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13"/>
                            <Rectangle Width="1" Fill="#555" Margin="6,3"/>
                            <Button Content="📂" Click="OnNewProject" ToolTip="Yeni Proje" Width="26" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="" Foreground="#666" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- RIBBON TABS AREA -->
                <TabControl Grid.Row="1" Background="#2D2D30" BorderThickness="0" Padding="0" Margin="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" Padding="14,5" Margin="1,0" CornerRadius="3,3,0,0" Background="Transparent" Cursor="Hand">
                                            <TextBlock x:Name="TabText" Text="{TemplateBinding Header}" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#333337"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#007ACC"/>
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabText" Property="Foreground" Value="#00AAFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="RbnBtn" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#DDDDDD"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="RbnAccent" TargetType="Button" BasedOn="{StaticResource RbnBtn}">
                            <Setter Property="Foreground" Value="#00DDFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style x:Key="RbnWarn" TargetType="Button" BasedOn="{StaticResource RbnBtn}">
                            <Setter Property="Foreground" Value="#FF6644"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style x:Key="RbnOk" TargetType="Button" BasedOn="{StaticResource RbnBtn}">
                            <Setter Property="Foreground" Value="#44DD88"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ═══════ TAB 1: SİSTEM ═══════ -->
                    <TabItem Header="1. Sistem" x:Name="TabSystem">
                        <Border Background="#333337" Padding="6,4">
                            <WrapPanel>
                                <Border BorderBrush="#FF9800" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="⚙️ Norm Seçimi" Click="OnStandardSelection" Style="{StaticResource RbnAccent}" ToolTip="Hesap standardı"/>
                                        <TextBlock Text="Standart" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#FFD700" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🏠 Özellikler" Click="OnBuildingProperties" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="📶 Kat Yönetici" Click="OnLevelManager" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="🏢 Çok Katlı" Click="OnMultiStoryManager" Style="{StaticResource RbnAccent}"/>
                                        </StackPanel>
                                        <TextBlock Text="Bina Ayarları" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#007ACC" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="✅ Ayarları Onayla" Click="OnConfirmSystemSettings" Style="{StaticResource RbnOk}" ToolTip="Sonraki adımların kilidini açar"/>
                                        <TextBlock Text="Süreç" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ KATMAN SEÇİCİ (AutoCAD tarzı Button+Popup) ═══ -->
                                <Border BorderBrush="#5588BB" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Renk göstergesi (aktif katman) -->
                                            <Border x:Name="ActiveLayerColorDot"
                                                    Width="14" Height="14" CornerRadius="2"
                                                    Background="#FF00FF" VerticalAlignment="Center"
                                                    Margin="0,0,4,0" BorderBrush="#888" BorderThickness="1"/>

                                            <!-- Tıklanabilir Katman Seçim Butonu — Dropdown açar -->
                                            <Grid>
                                                <Button x:Name="LayerPickerBtn"
                                                        Width="170" Height="24"
                                                        Background="#1E2535" Foreground="White"
                                                        BorderBrush="#3A5070" BorderThickness="1"
                                                        FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,0,20,0"
                                                        Click="OnLayerPickerBtnClick"
                                                        ToolTip="Aktif katmanı seçin — katman listesini açar"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="LayerBtnBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="3">
                                                                <Grid>
                                                                    <ContentPresenter HorizontalAlignment="Left"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                    <!-- Ok ikonu sağda -->
                                                                    <TextBlock Text="▾" Foreground="#88AACC"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,5,0" FontSize="10"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="LayerBtnBorder" Property="BorderBrush" Value="#0078D7"/>
                                                                    <Setter TargetName="LayerBtnBorder" Property="Background" Value="#253045"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <!-- Aktif katman adı (kod tarafından güncellenir) -->
                                                    <TextBlock x:Name="ActiveLayerLabel"
                                                               Text="0"
                                                               Foreground="White"
                                                               FontFamily="Consolas" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- POPUP: Katman listesi -->
                                                <Popup x:Name="LayerPickerPopup"
                                                       PlacementTarget="{Binding ElementName=LayerPickerBtn}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Slide">
                                                    <Border Background="#1A1E2E"
                                                            BorderBrush="#3A5070" BorderThickness="1"
                                                            CornerRadius="4"
                                                            MinWidth="280" MaxHeight="300">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Başlık -->
                                                            <Border Grid.Row="0" Background="#252A3A" Padding="8,4" CornerRadius="4,4,0,0">
                                                                <TextBlock Text="  Katmanlar" Foreground="#88AACC"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           FontFamily="Segoe UI"/>
                                                            </Border>

                                                            <!-- Katman Listesi -->
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                                          MaxHeight="260">
                                                                <ListBox x:Name="LayerPickerList"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         SelectionMode="Single"
                                                                         VirtualizingPanel.IsVirtualizing="True">
                                                                    <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Padding" Value="2,1"/>
                                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#252A3A"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter Property="Background" Value="#1A3A6A"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ListBox.ItemContainerStyle>
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <!-- Her satır: [👁] [❄] [🔒] [■ renk] Katman Adı -->
                                                                            <Grid Margin="2,2" Height="22">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="22"/> <!-- Görünürlük -->
                                                                                    <ColumnDefinition Width="22"/> <!-- Dondur -->
                                                                                    <ColumnDefinition Width="22"/> <!-- Kilitle -->
                                                                                    <ColumnDefinition Width="14"/> <!-- Renk -->
                                                                                    <ColumnDefinition Width="*"/>  <!-- Katman Adı -->
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- 👁 Görünürlük (tıklanabilir) -->
                                                                                <Button Grid.Column="0"
                                                                                        Content="{Binding VisibilityIcon}"
                                                                                        FontSize="12" Background="Transparent"
                                                                                        BorderThickness="0" Cursor="Hand"
                                                                                        ToolTip="Katmanı Gizle/Göster"
                                                                                        Tag="{Binding Name}"
                                                                                        Click="OnLayerVisibilityToggle_Click"/>

                                                                                <!-- ❄ Dondur (tıklanabilir) -->
                                                                                <Button Grid.Column="1"
                                                                                        Content="{Binding FreezeIcon}"
                                                                                        FontSize="12" Background="Transparent"
                                                                                        BorderThickness="0" Cursor="Hand"
                                                                                        ToolTip="Katmanı Dondur/Çöz"
                                                                                        Tag="{Binding Name}"
                                                                                        Click="OnLayerFreezeToggle_Click">
                                                                                    <Button.Foreground>
                                                                                        <SolidColorBrush Color="#44CCFF"/>
                                                                                    </Button.Foreground>
                                                                                </Button>

                                                                                <!-- 🔒 Kilitle (tıklanabilir) -->
                                                                                <Button Grid.Column="2"
                                                                                        Content="{Binding LockIcon}"
                                                                                        FontSize="12" Background="Transparent"
                                                                                        BorderThickness="0" Cursor="Hand"
                                                                                        ToolTip="Katmanı Kilitle/Aç"
                                                                                        Tag="{Binding Name}"
                                                                                        Click="OnLayerLockToggle_Click">
                                                                                    <Button.Foreground>
                                                                                        <SolidColorBrush Color="#FFCC44"/>
                                                                                    </Button.Foreground>
                                                                                </Button>

                                                                                <!-- ■ Renk karesi -->
                                                                                <Border Grid.Column="3"
                                                                                        Width="12" Height="12"
                                                                                        CornerRadius="2"
                                                                                        Background="{Binding ColorBrush}"
                                                                                        BorderBrush="#555" BorderThickness="1"
                                                                                        VerticalAlignment="Center"/>

                                                                                <!-- Katman Adı — tıklanınca aktif yapar -->
                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="{Binding Name}"
                                                                                           Foreground="White"
                                                                                           FontFamily="Consolas"
                                                                                           FontSize="12"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="6,0,0,0"
                                                                                           Cursor="Hand"
                                                                                           MouseLeftButtonUp="OnLayerNameClick"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- Katman Yöneticisi Butonu -->
                                            <Button Content="🗂" Click="OnToggleLayerPanel"
                                                    Style="{StaticResource RbnBtn}"
                                                    ToolTip="Katman Yöneticisini Aç/Kapat"
                                                    Width="28" Height="24" Margin="4,0,0,0"
                                                    FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Text="Katman" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>


                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ═══════ TAB 2: UÇ NOKTALAR ═══════ -->
                    <TabItem Header="2. Uç Noktalar" x:Name="TabTerminals" IsEnabled="False">
                        <Border Background="#333337" Padding="6,4">
                            <WrapPanel>
                                <Border BorderBrush="#00CC88" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🤖 Otonom" Click="OnAutoDetectSpacesCommand" Style="{StaticResource RbnAccent}" ToolTip="Tüm mimariyi tara ve bütün odaları otonom tespit et"/>
                                            <Button Content="🏠 Akıllı" Click="OnSmartDetectRoomClick" Style="{StaticResource RbnOk}" ToolTip="Tıklanan bölgedeki odayı otomatik tanıma"/>
                                            <Button Content="📍 Manuel" Click="OnManualMahalDefine" Style="{StaticResource RbnBtn}" ToolTip="Manuel Mahal: Duvarları seçip Enter ile kapat"/>
                                            <Button Content="⬛ Dikdörtgen" Click="OnRectMahalDefine" Style="{StaticResource RbnBtn}" ToolTip="Dikdörtgen Mahal: 2 köşe tıkla — kapı/pencere boşluklarını görmezden gelir"/>
                                            <Button Content="🏷️ Tag" Click="OnDefineMahalCommand" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Mahal Tanımı" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="4,2,8,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="40">
                                            <Button Click="OnFixtureLibrary" Style="{StaticResource RbnBtn}" ToolTip="Reseptör Kütüphanesi" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 4 4 H 20 V 20 H 4 Z M 4 8 H 20 M 12 8 V 20" Stroke="#DDD" StrokeThickness="1" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Library" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnPlaceFixtureOnWall" Style="{StaticResource RbnBtn}" ToolTip="Duvara Cihaz Yerleştir" Margin="2,0" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 12 2 A 4 4 0 0 0 8 6 V 12 H 16 V 6 A 4 4 0 0 0 12 2 Z M 6 12 H 18 V 16 H 6 Z M 12 16 V 22" Stroke="#DDD" StrokeThickness="1" Fill="#555" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Fixture" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Kütüphane" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#007ACC" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="✅ Yükleri Onayla" Click="OnConfirmTerminals" Style="{StaticResource RbnOk}" ToolTip="Tesisat çiziminin kilidini açar"/>
                                        <TextBlock Text="Süreç" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ═══════ TAB 3: TESİSAT ═══════ -->
                    <TabItem Header="3. Tesisat" x:Name="TabRouting" IsEnabled="False">
                        <Border Background="#333337" Padding="4,4,4,2">
                            <WrapPanel>
                                <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="4,2,8,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="40">
                                            <Button Click="OnDrawPipeCommand" Style="{StaticResource RbnAccent}" ToolTip="Boru Çiz (P)" Margin="2,0" Width="40">
                                                <StackPanel>
                                                    <Path Data="M 2 8 L 22 8 M 2 16 L 22 16 M 2 8 V 16 M 22 8 V 16" Stroke="#00DDFF" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Pipe" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnWallParallelRoute" Style="{StaticResource RbnBtn}" ToolTip="Duvara Paralel Boru" Margin="2,0" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 4 2 V 22 M 10 2 V 22 M 4 6 H 10 M 4 12 H 10 M 4 18 H 10 M 16 6 V 18 M 14 6 H 18 M 14 18 H 18" Stroke="#DDD" StrokeThickness="1" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Parallel" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnDoublePipeRoute" Style="{StaticResource RbnAccent}" ToolTip="Cift Hat Ciz - Sicak+Soguk (TS 1258)" Margin="2,0" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 2 5 H 22 M 2 9 H 22 M 2 15 H 22 M 2 19 H 22" Stroke="#FF6666" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,1"/>
                                                    <TextBlock Text="CiftHat" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Boru Çizimi" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="4,2,8,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="40">
                                            <StackPanel Orientation="Vertical" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Eğim (%):" Foreground="#AAA" FontSize="9"/>
                                                <ComboBox x:Name="SlopeComboBox" Width="50" Height="20" SelectedIndex="0" Background="#3E3E42" Foreground="White" BorderThickness="0" SelectionChanged="OnMechanicalSettingsChanged">
                                                    <ComboBoxItem Content="0" />
                                                    <ComboBoxItem Content="1" />
                                                    <ComboBoxItem Content="1.5" />
                                                    <ComboBoxItem Content="2" />
                                                    <ComboBoxItem Content="3" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Tesisat Ayarları" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="4,2,8,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="40">
                                            <Button Click="OnPipeWizard" Style="{StaticResource RbnBtn}" ToolTip="Boru Makrosu/Sihirbazı" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 4 20 L 16 8 L 20 12 L 8 24 Z M 16 8 L 20 4 M 18 2 L 22 6" Stroke="#FFF" StrokeThickness="1" Fill="#44DD88" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Wizard" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnAutoBranchingClick" Style="{StaticResource RbnBtn}" ToolTip="Otomatik Şube Bağlantısı" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 8 12 A 4 4 0 1 1 8 4 A 4 4 0 1 1 8 12 M 16 20 A 4 4 0 1 1 16 12 A 4 4 0 1 1 16 20 M 10 9 L 14 15" Stroke="#AA66FF" StrokeThickness="1" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Auto-Con" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnConnectReceptors" Style="{StaticResource RbnOk}" ToolTip="Armatuerleri Ana Hatta Bagla (TS 1258)" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 4 12 A 3 3 0 1 0 4 6 A 3 3 0 1 0 4 12 M 20 12 A 3 3 0 1 0 20 6 A 3 3 0 1 0 20 12 M 7 9 L 17 9" Stroke="#44DD88" StrokeThickness="1.2" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Connect" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRiserConnection" Style="{StaticResource RbnBtn}" ToolTip="Kolon Bağlantısı" Width="40">
                                                <StackPanel>
                                                    <Path Data="M 8 22 V 2 M 16 22 V 2 M 4 18 H 20 M 4 12 H 20 M 4 6 H 20" Stroke="#DDD" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Riser" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Akıllı Bağlantı" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#87CEEB" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🚿 Pis Su" Click="OnWasteWaterDesign" Style="{StaticResource RbnBtn}" ToolTip="Pis Su / Yağmur"/>
                                            <Button Content="🧯 Fosseptik" Click="OnSepticTankDesign" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Pis Su Modülleri" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#FF4444" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="🔥 Sprinkler" Click="OnFireFightingDesign" Style="{StaticResource RbnWarn}"/>
                                        <TextBlock Text="Yangın" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="4,2,8,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="40">
                                            <Button Click="OnLineCommand" Style="{StaticResource RbnBtn}" ToolTip="Çizgi (L)" Width="40">
                                                <StackPanel>
                                                    <Path Data="M 4,20 L 20,4" Stroke="#00AAFF" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Line" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnCircleCommand" Style="{StaticResource RbnBtn}" ToolTip="Daire (C)" Width="40">
                                                <StackPanel>
                                                    <Path Data="M 12 4 A 8 8 0 1 1 12 20 A 8 8 0 1 1 12 4 Z" Stroke="#00AAFF" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Circle" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnTrimCommand" Style="{StaticResource RbnBtn}" ToolTip="Buda (TR)" Width="40">
                                                <StackPanel>
                                                    <Path Data="M 4 12 L 20 12 M 12 4 L 12 10 M 12 14 L 12 20" Stroke="#FF4444" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Trim" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnExtendCommand" Style="{StaticResource RbnBtn}" ToolTip="Uzat (EX)" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 4 12 L 14 12 M 16 4 L 16 20 M 14 12 L 10 9 M 14 12 L 10 15" Stroke="#44DD88" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Extend" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnMirrorCommand" Style="{StaticResource RbnBtn}" ToolTip="Ayna (MI)" Width="45">
                                                <StackPanel>
                                                    <Path Data="M 12 2 L 12 22 M 4 6 L 10 12 L 4 18 Z M 20 6 L 14 12 L 20 18 Z" Stroke="#FFBB00" StrokeThickness="1.5" Fill="#66FFBB00" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Mirror" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnExplodeCommand" Style="{StaticResource RbnBtn}" ToolTip="Patlat (X)" Width="50">
                                                <StackPanel>
                                                    <Path Data="M 6 6 L 10 10 M 18 6 L 14 10 M 12 14 L 12 20 M 10 14 L 6 18 M 14 14 L 18 18" Stroke="#AA88FF" StrokeThickness="2" StrokeDashArray="2 1" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="Explode" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Yardımcı Çizim" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#007ACC" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="✅ Boruyu Onayla" Click="OnConfirmRouting" Style="{StaticResource RbnOk}" ToolTip="Hesaplamanın kilidini açar"/>
                                        <TextBlock Text="Süreç" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ═══════ TAB 4: HESAP ═══════ -->
                    <TabItem Header="4. Hesap" x:Name="TabCalculation" IsEnabled="False">
                        <Border Background="#333337" Padding="6,4">
                            <WrapPanel>
                                <Border BorderBrush="#FF4444" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🛡️ Check System" Click="OnAuditSystem" Style="{StaticResource RbnWarn}" ToolTip="Açık uçları ve ters debileri bulur"/>
                                            <Button Content="💥 Çakışma Analizi" Click="OnClashDetectionClick" Style="{StaticResource RbnWarn}" ToolTip="3D Mimar-Tesisat BoundingBox çakışma analizi" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Validasyon &amp; Çakışma" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#0088FF" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📊 Sistem Analizi" Click="OnAutoPipeSizing" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="⚡ HESAPLA" Click="OnRecalculateSystem" Style="{StaticResource RbnOk}" ToolTip="Tüm sistemi hesapla"/>
                                            <Button Content="🔄 Tesisat (Sadece)" Click="OnRecalculatePlumbing" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Sizing Motoru" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#FFFF00" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📉 Basınç Kaybı" Click="OnPressureDropCalc" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="💧 Pompa" Click="OnPumpSelection" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Kritik Hat &amp; Cihaz" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ═══════ TAB 5: RAPOR & ÇIKTI ═══════ -->
                    <TabItem Header="5. Raporlar" x:Name="TabOutputs" IsEnabled="False">
                        <Border Background="#333337" Padding="6,4">
                            <WrapPanel>
                                <Border BorderBrush="#44DD88" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏️ Çapları Yazdır" Click="OnAutoAnnotate" Style="{StaticResource RbnOk}"/>
                                            <Button Content="🗑️ Temizle" Click="OnClearAnnotations" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="UI Anotasyon" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#FFCC00" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📊 Hesaplama Tab." Click="OnCalculationTable" Style="{StaticResource RbnAccent}"/>
                                            <Button Content="📈 Hidrolik Rapor" Click="OnGenerateHydraulicReport" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="📄 Sistem Raporu" Click="OnReportExport" Style="{StaticResource RbnBtn}" ToolTip="HTML/CSV/RTF"/>
                                        </StackPanel>
                                        <TextBlock Text="Föyler" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#AA66FF" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📐 Dikey (Kolon) Şema" Click="OnRiserDiagramExport" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="📊 İzo-Şema" Click="OnShowIsometricScheme" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Şemalar" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#007ACC" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📜 Lejant" Click="OnGenerateLegend" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="📝 Metraj (BOQ)" Click="OnGenerateBOQ_Click" Style="{StaticResource RbnOk}"/>
                                            <Button Content="📋 Şartname" Click="OnSpecificationExport" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Listeler" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ═══════ TAB 6: GÖRÜNÜM ═══════ -->
                    <TabItem Header="👁️ Görünüm" x:Name="TabView">
                        <Border Background="#333337" Padding="6,4">
                            <WrapPanel>
                                <Border BorderBrush="#007ACC" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <Button Content="🔎 Zoom Extents" Click="OnZoomExtents" Style="{StaticResource RbnBtn}"/>
                                        <TextBlock Text="Navigasyon" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#00DDFF" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="View2DBtn" Content="2D" Click="OnToggle2DView" Style="{StaticResource RbnAccent}" Width="36"/>
                                            <Button x:Name="View3DBtn" Content="3D" Click="OnToggle3DView" Style="{StaticResource RbnBtn}" Width="36"/>
                                            <Button Content="🧊 3D Boru" Click="OnPipe3DView" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Mod" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#555" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📁 Navigator" Click="OnToggleProjectNavigator" Style="{StaticResource RbnBtn}"/>
                                            <Button Content="🧠 Intelligence" Click="OnToggleIntelligencePanel" Style="{StaticResource RbnBtn}"/>
                                        </StackPanel>
                                        <TextBlock Text="Paneller" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Main Content Area (Navigator + Viewport + Intelligence) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Project Navigator -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="Auto"/> <!-- Tools (Left) -->
                <ColumnDefinition Width="*"/>    <!-- Viewport -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="Auto"/> <!-- Intelligence -->
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT PANEL: Navigator + Katmanlar (Tab-based dockable) -->
            <Border Grid.Column="0" Width="240"
                    BorderBrush="#3E3E42" BorderThickness="0,0,1,0"
                    x:Name="LeftPanelBorder" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab bar -->
                        <RowDefinition Height="*"/>    <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Mini tab strip -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#252A35" Height="28">
                        <Button x:Name="TabNavBtn" Content="📁 Proje" FontSize="10"
                                Background="#1F3A5F" Foreground="White"
                                BorderThickness="0" Padding="8,4" Cursor="Hand"
                                Click="OnLeftTab_Navigator"/>
                        <Button x:Name="TabLayerBtn" Content="🗂 Katmanlar" FontSize="10"
                                Background="Transparent" Foreground="#AAA"
                                BorderThickness="0" Padding="8,4" Cursor="Hand"
                                Click="OnLeftTab_Layers"/>
                    </StackPanel>

                    <!-- Navigator (görünürlük koda bağlı) -->
                    <controls:ProjectNavigatorView x:Name="ProjectNavigatorPanel"
                                                   Grid.Row="1"
                                                   Visibility="Collapsed"/>

                    <!-- Layer Manager -->
                    <controls:LayerManagerPanel x:Name="LayerPanel"
                                                Grid.Row="1"
                                                Visibility="Visible"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>


            <!-- 2. LEFT TOOLBAR (FINE SANI STYLE) -->
            <ToolBarTray Grid.Column="2" Orientation="Vertical" Background="#333337" IsLocked="True">
                 <ToolBar Band="1" BandIndex="1" Background="#333337" Foreground="White">
                    <ToolBar.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Width" Value="45"/>
                            <Setter Property="Height" Value="45"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ToolBar.Resources>
                    
                    <Button Content="Line" Click="OnLineCommand" ToolTip="Çizgi (L)"/>
                    <Button Content="Circle" Click="OnCircleCommand" ToolTip="Daire (C)"/>
                    <Button Content="Trim" Click="OnTrimCommand" ToolTip="Buda (TR)" Foreground="#FF4444" FontWeight="Bold"/>
                    <Button Content="Extend" Click="OnExtendCommand" ToolTip="Uzat (EX)" Foreground="#44DD88" FontWeight="Bold"/>
                    <Button Content="Mirror" Click="OnMirrorCommand" ToolTip="Ayna (MI)" Foreground="#FFBB00" FontWeight="Bold"/>
                    <Button Content="Explode" Click="OnExplodeCommand" ToolTip="Patlat (X)" Foreground="#AA88FF" FontWeight="Bold"/>
                    <Button Content="Pipe" Click="OnDrawPipeCommand" ToolTip="Boru Çiz (P)" Foreground="Orange" FontWeight="Bold"/>
                    <Button Content="WallFix" Click="OnPlaceFixtureOnWall" ToolTip="Duvara Cihaz Yerleştir" Foreground="Cyan"/>
                    <Separator/>
                    <Button Content="Move" ToolTip="Taşı (M)"/>
                    <Button Content="Copy" ToolTip="Kopyala (CO)"/>
                    <Separator/>
                    <Button Content="Otonom" Click="OnAutoDetectSpacesCommand" ToolTip="Tüm Mimariyi Tara (ATO)" Foreground="#00DDFF" FontWeight="Bold"/>
                    <Button Content="Mahal" Click="OnDefineMahalCommand" ToolTip="Mahal Tanımla (MA)" Foreground="LightGreen" FontWeight="Bold"/>
                    <Button Content="Analiz" Click="OnInspectMahalCommand" ToolTip="Mahal Analizi (MAN)" Foreground="Yellow"/>
                    <Separator/>
                    <Button Content="Hesap" Click="OnRecalculatePlumbing" ToolTip="Tesisat Hesapla" Foreground="OrangeRed" FontWeight="Bold"/>
                    <Button Content="Şema" Click="OnRiserGenerateCommand" ToolTip="Kolon Şeması Üret (KS)" Foreground="MediumPurple"/>
                    <Button Content="Spec" Click="OnAnalyzeSpecClick" ToolTip="Keşif Özeti &amp; Teknik Şartname (S21)" Foreground="#00FF7F" FontWeight="Bold"/>
                    <Button Content="İzo-Şema" Click="OnShowIsometricScheme" ToolTip="Canlı İzometrik Şema (S18)" Foreground="Cyan" FontWeight="Bold"/>
                </ToolBar>
            </ToolBarTray>

            <!-- 3. CENTER: VIEWPORT -->
            <Border Grid.Column="3" Background="#15191C" CornerRadius="0" Margin="0" BorderThickness="0">
                <TabControl x:Name="DocumentTabs" Background="Transparent" BorderThickness="0" Padding="0" 
                            SelectionChanged="OnTabChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="#2D2D2D" BorderBrush="#111" BorderThickness="0,0,1,0" Padding="12,6" CornerRadius="4,4,0,0" Margin="0,0,1,0">
                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock x:Name="TitleText" Text="{TemplateBinding Header}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                 <Button Grid.Column="1" Content="✕" Width="16" Height="16" FontSize="10" Background="Transparent" Foreground="#666" BorderThickness="0" Padding="0" Click="OnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                     <Button.Style>
                                                         <Style TargetType="Button">
                                                             <Setter Property="Template">
                                                                 <Setter.Value> 
                                                                     <ControlTemplate TargetType="Button">
                                                                         <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                         </Border>
                                                                     </ControlTemplate>
                                                                 </Setter.Value>
                                                             </Setter>
                                                             <Style.Triggers>
                                                                 <Trigger Property="IsMouseOver" Value="True">
                                                                     <Setter Property="Background" Value="#444"/>
                                                                     <Setter Property="Foreground" Value="Red"/>
                                                                 </Trigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </Button.Style>
                                                 </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#15191C"/>
                                                <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                                <Setter TargetName="TitleText" Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                               <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <!-- Sekmeler kod tarafından eklenecek -->
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="4" Width="4" Background="#1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- 4. RIGHT PANEL: INTELLIGENCE & PROPERTIES -->
            <controls:IntelligencePanel Grid.Column="5" x:Name="RightPanel" Width="250" Visibility="Collapsed"/>
        </Grid>


        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KOMUT:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="Bold"/>
                    <TextBox x:Name="CommandInput" Width="200" Background="#2D2D30" Foreground="White" BorderBrush="#007ACC" KeyDown="CommandInput_KeyDown" CaretBrush="White"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CoordinateText" Text="0.0, 0.0, 0.0" FontFamily="Consolas"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <ProgressBar x:Name="MainProgressBar" Width="100" Height="15" IsIndeterminate="True" Visibility="Collapsed" Margin="5,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <!-- KISAYOL KONTROLLERİ -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <!-- ORTHO KONTROLÜ -->
                    <ToggleButton x:Name="BtnOrthoMode" Content="Ortho (F8)" Click="OnOrthoModeToggle" IsChecked="False" Width="70" Margin="0,0,15,0" Background="#333337" Foreground="#AAAAAA" BorderThickness="0" ToolTip="Dik Açılı Çizim (F8)"/>
                    
                    <TextBlock Text="OSNAP:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" ToolTip="Kenetleme Araçları"/>
                    <ToggleButton x:Name="BtnOsnapMaster" Content="Açık" IsChecked="True" Width="40" Margin="2,0" Click="OnOsnapMasterToggle" Background="#333337" Foreground="#00DDFF" BorderThickness="0"/>
                    <Rectangle Width="1" Fill="#555" Margin="4,2"/>
                    <ToggleButton x:Name="BtnOsnapEnd" Content="Uç Nokta" IsChecked="True" Width="60" Margin="2,0" Click="OnOsnapFlagToggle" Background="#333337" Foreground="White" BorderThickness="0" ToolTip="Endpoint"/>
                    <ToggleButton x:Name="BtnOsnapMid" Content="Orta" IsChecked="True" Width="40" Margin="2,0" Click="OnOsnapFlagToggle" Background="#333337" Foreground="White" BorderThickness="0" ToolTip="Midpoint"/>
                    <ToggleButton x:Name="BtnOsnapCen" Content="Merkez" IsChecked="True" Width="55" Margin="2,0" Click="OnOsnapFlagToggle" Background="#333337" Foreground="White" BorderThickness="0" ToolTip="Center"/>
                    <ToggleButton x:Name="BtnOsnapPerp" Content="Dik" IsChecked="True" Width="35" Margin="2,0" Click="OnOsnapFlagToggle" Background="#333337" Foreground="White" BorderThickness="0" ToolTip="Perpendicular"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="Zoom: 100%"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
