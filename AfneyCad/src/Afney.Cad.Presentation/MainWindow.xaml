                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnToggleColdWater"  Content="💧 Temiz Su"     Click="OnToggleColdWater"  Style="{StaticResource RbnBtn}" Tag="MEP_TEMIZ_SU"     ToolTip="Temiz su katmanını göster/gizle"/>
                                            <Button x:Name="BtnToggleHotWater"   Content="🔴 Sıcak Su"     Click="OnToggleHotWater"   Style="{StaticResource RbnBtn}" Tag="MEP_SICAK_SU"     ToolTip="Sıcak su katmanını göster/gizle"/>
