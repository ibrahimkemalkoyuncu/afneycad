                                    <!-- Mimari Giriş -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource RbnLargeAccent}"
                                                        Click="OnBuildingProperties"
                                                        ToolTip="Bina/Aktif Kat Belirle — Mimari çizimi programa girin">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Home}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Mimari" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Belirle" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnLevelManager"
                                                        ToolTip="Katman Yöneticisi">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Layers}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Katman" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Yönet" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnMultiStoryManager"
                                                        ToolTip="Kat Kopyala — Tesisatı başka kata kopyala">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Layers}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Kat" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Kopyala" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Mimari Giriş" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mimari Elemanlar -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnRecognizeArchitecture"
                                                        ToolTip="Mimari Eleman Seç — DWG çizgilerini tanı">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Brick}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Eleman" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Tanı" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnSmartBimConvert"
                                                        ToolTip="DWG → BIM Dönüşüm">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="DWG→" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="BIM" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnArchitecturalLibrary"
                                                        ToolTip="Yapı Elemanları Kütüphanesi">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Package}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Kütüphane" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Mimari Elemanlar" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Blok / WBlock -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource RbnLargeGreen}"
                                                        Click="OnBlockCommand"
                                                        ToolTip="Blok Tanımla (BLOCK)">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Rectangle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Blok" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Tanımla" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnWBlockCommand"
                                                        ToolTip="Blok Oluştur / Dışa Kaydet (WBLOCK)">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Save}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="WBlock" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Kaydet" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnInsertCommand"
                                                        ToolTip="Blok Ekle (INSERT)">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.TrayDownload}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Blok" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Ekle" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Blok İşlemleri" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ölçüm / Görünüm -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource RbnLargeOrange}"
                                                        Click="OnDistCommand"
                                                        ToolTip="Uzaklık Ölç (DIST) — İki nokta arası mesafe">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.Ruler}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Uzaklık" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnScaleVerifyCommand"
                                                        ToolTip="Ölçek Doğrula — Mimardan gelen çizimin birimi yanlışsa, bilinen bir ölçüyle (ör. kapı genişliği) karşılaştırıp tüm çizimi düzeltin">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.CheckCircle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Ölçek" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Doğrula" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnTitleBlock"
                                                        ToolTip="Pafta / Antet Ekle">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.FileDocument}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Pafta" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Antet" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}"
                                                        Click="OnToggle3DView"
                                                        ToolTip="3D Görünüm — Aksonometrik">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.CubeOutline}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="3D" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="Görünüm" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Ölçüm / Görünüm" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════════ -->
                    <!-- TAB 8: GÖRÜNÜM                                            -->
                    <!-- ══════════════════════════════════════════════════════════ -->
                    <TabItem Header="Görünüm" x:Name="TabView">
                        <Border Background="#1E2029" Padding="4,6,4,4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">

                                    <!-- Navigasyon -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource RbnLargeAccent}" Click="OnZoomExtents" ToolTip="Tüm çizimi sığdır">
                                                <StackPanel>
                                                    <Path Data="{StaticResource Ico.Search}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Zoom" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Extents" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Navigasyon" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2D / 3D Mod -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="View2DBtn" Style="{StaticResource RbnLargeAccent}" Click="OnToggle2DView">
                                                    <StackPanel>
                                                        <TextBlock Text="2D" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Görünüm" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="View3DBtn" Style="{StaticResource RbnLarge}" Click="OnToggle3DView">
                                                    <StackPanel>
                                                        <TextBlock Text="3D" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock Text="Görünüm" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RbnLarge}" Click="OnPipe3DView" ToolTip="3D Boru Görünümü">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource Ico.CubeOutline}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,0,0"/>
                                                        <TextBlock Text="3D Boru" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Görünüm Modu" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sistem Görünürlüğü -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4"
                                            BorderBrush="#252836" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnToggleColdWater"  Click="OnToggleColdWater"  Style="{StaticResource RbnBtn}" Tag="MEP_TEMIZ_SU"     ToolTip="Temiz su göster/gizle">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.WaterDrop}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Temiz Su" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnToggleHotWater"   Click="OnToggleHotWater"   Style="{StaticResource RbnBtn}" Tag="MEP_SICAK_SU"     ToolTip="Sıcak su göster/gizle" Margin="2,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.Circle}" Fill="#E74C3C" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Sıcak Su" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnToggleWasteWater" Click="OnToggleWasteWater" Style="{StaticResource RbnBtn}" Tag="MEP_PIS_SU"       ToolTip="Pis su göster/gizle" Margin="2,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.Circle}" Fill="#8D6E63" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Pis Su" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Button x:Name="BtnToggleFire"       Click="OnToggleFire"       Style="{StaticResource RbnBtn}" Tag="MEP_YANGIN"       ToolTip="Yangın göster/gizle">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.Fire}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Yangın" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnToggleGas"        Click="OnToggleGas"        Style="{StaticResource RbnBtn}" Tag="MEP_GAZ"          ToolTip="Gaz göster/gizle" Margin="2,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.Fire}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Gaz" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnToggleVent"       Click="OnToggleVent"       Style="{StaticResource RbnBtn}" Tag="MEP_HAVALANDIRMA" ToolTip="Havalandırma göster/gizle" Margin="2,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Ico.Fan}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Havaland." VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Button Click="OnShowAllSystems" Style="{StaticResource RbnOk}" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Ico.CheckCircle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Tümünü Göster" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Sistem Görünürlüğü" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Paneller -->
                                    <Border Margin="0,0,2,0" Padding="6,0,6,4">
                                        <StackPanel>
                                            <Button Click="OnToggleProjectNavigator" Style="{StaticResource RbnMed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Navigator" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnToggleIntelligencePanel" Style="{StaticResource RbnMed}" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Ico.Lightbulb}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Intelligence" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Paneller" Foreground="#6B6F88" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  CONTENT AREA                                                        -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>   <!-- Col 0: Activity Bar -->
                <ColumnDefinition Width="Auto"/> <!-- Col 1: Left Panel -->
                <ColumnDefinition Width="4"/>    <!-- Col 2: Splitter -->
                <ColumnDefinition Width="*"/>    <!-- Col 3: Viewport -->
                <ColumnDefinition Width="4"/>    <!-- Col 4: Splitter -->
                <ColumnDefinition Width="Auto"/> <!-- Col 5: Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- ── Aktivite Çubuğu (VS Code tarzı) ─────────────────────────── -->
            <Border Grid.Column="0"
                    Background="#12141A"
                    BorderBrush="#252836" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top">
                    <Button x:Name="TabNavBtn"
                            Style="{StaticResource ActivityBtn}"
                            Click="OnLeftTab_Navigator"
                            ToolTip="Proje Gezgini">
                        <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="TabLayerBtn"
                            Style="{StaticResource ActivityBtn}"
                            Click="OnLeftTab_Layers"
                            ToolTip="Katman Yöneticisi">
                        <Path Data="{StaticResource Ico.Layers}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ActivityBtn}"
                            Click="OnInspectMahalCommand"
                            ToolTip="Mahal Analizi">
                        <Path Data="{StaticResource Ico.Search}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ActivityBtn}"
                            Click="OnToggleIntelligencePanel"
                            ToolTip="Akıllı Asistan">
                        <Path Data="{StaticResource Ico.Lightbulb}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── Sol Panel: Proje / Katmanlar ─────────────────────────────── -->
            <Border Grid.Column="1" Width="220"
                    Background="#1A1C24"
                    BorderBrush="#252836" BorderThickness="0,0,1,0"
                    x:Name="LeftPanelBorder" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel başlık -->
                    <Border Grid.Row="0" Background="#12141A" Padding="12,6"
                            BorderBrush="#252836" BorderThickness="0,0,0,1">
                        <TextBlock Text="PROJE GEZGİNİ" Foreground="#7AA0CC"
                                   FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Navigator ve Layer panelleri -->
                    <controls:ProjectNavigatorView x:Name="ProjectNavigatorPanel"
                                                   Grid.Row="1"
                                                   Visibility="Collapsed"/>
                    <controls:LayerManagerPanel x:Name="LayerPanel"
                                                Grid.Row="1"
                                                Visibility="Visible"/>

                    <!-- Özellikler Paneli (FINE MEP sol panel) -->
                    <controls:PropertiesPanel x:Name="EntityPropertiesPanel"
                                               Grid.Row="1"
                                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="4"
                          Background="#252836" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── Viewport ──────────────────────────────────────────────────── -->
            <Border Grid.Column="3" Background="#0E1014">
                <DockPanel>
                    <!-- Sekme çubuğu -->
                    <Border DockPanel.Dock="Top" Background="#1A1C24"
                            BorderBrush="#252836" BorderThickness="0,0,0,1" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋" Click="OnNewFile"   ToolTip="Yeni Sekme"
                                    Width="24" Height="20"
                                    Background="#24273A" Foreground="#60BAFF"
                                    BorderThickness="0" FontSize="12" Cursor="Hand" Margin="0,0,2,0"/>
                            <Button Click="OnOpenFile"  ToolTip="Dosya Aç"
                                    Width="24" Height="20"
                                    Background="#24273A" Foreground="#858899"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                            <TextBlock x:Name="TxtTabCount" Text="" Foreground="#35374A"
                                       FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="DocumentTabs" Background="Transparent" BorderThickness="0" Padding="0"
                                SelectionChanged="OnTabChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border"
                                                    Background="#1A1C24"
                                                    BorderBrush="#252836" BorderThickness="0,0,1,0"
                                                    Padding="14,7" CornerRadius="0" Margin="0,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TitleText"
                                                               Text="{TemplateBinding Header}"
                                                               Foreground="#565870" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Content="✕"
                                                            Width="16" Height="16" FontSize="9"
                                                            Background="Transparent" Foreground="#424559"
                                                            BorderThickness="0" Padding="0"
                                                            Click="OnCloseTab_Click"
                                                            Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#2E3045"/>
                                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border"    Property="Background"       Value="#0E1014"/>
                                                    <Setter TargetName="Border"    Property="BorderBrush"      Value="#0A84FF"/>
                                                    <Setter TargetName="Border"    Property="BorderThickness"  Value="0,2,1,0"/>
                                                    <Setter TargetName="TitleText" Property="Foreground"       Value="#E1E4EE"/>
                                                    <Setter TargetName="TitleText" Property="FontWeight"       Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="#C8CADC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <!-- Sekmeler kod tarafından eklenir -->
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="4" Width="4"
                          Background="#252836" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── Sağ Panel: Intelligence ───────────────────────────────────── -->
            <controls:IntelligencePanel Grid.Column="5" x:Name="RightPanel"
                                        Width="260" Visibility="Collapsed"/>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  STATUS BAR                                                           -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Background="#0E1014"
              Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Komut girişi -->
                <ColumnDefinition Width="1"/>     <!-- Ayırıcı -->
                <ColumnDefinition Width="*"/>     <!-- Durum metni -->
                <ColumnDefinition Width="Auto"/>  <!-- CAD Toggles -->
                <ColumnDefinition Width="Auto"/>  <!-- Koordinatlar -->
                <ColumnDefinition Width="Auto"/>  <!-- Zoom -->
            </Grid.ColumnDefinitions>

            <!-- Komut Girişi -->
            <Border Grid.Column="0" Background="#1A1C24"
                    Padding="6,0" BorderBrush="#252836" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▶" Foreground="#0A84FF" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="CommandInput"
                             Width="240" Height="24"
                             Background="#12141A" Foreground="#E1E4EE"
                             BorderBrush="#0A84FF" BorderThickness="1"
                             CaretBrush="White" FontFamily="Consolas" FontSize="13"
                             Padding="6,2" VerticalContentAlignment="Center"
                             KeyDown="CommandInput_KeyDown"
                             ToolTip="Komut girin (L=Çizgi, C=Daire, P=Boru, DIM=Ölçü...)"/>
                </StackPanel>
            </Border>
            <ProgressBar Grid.Column="0" x:Name="MainProgressBar"
                         Height="2" IsIndeterminate="True" Visibility="Collapsed"
                         VerticalAlignment="Bottom"
                         Foreground="#0A84FF" Background="Transparent"/>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Fill="#252836"/>

            <!-- Durum Metni -->
            <Border Grid.Column="2" Padding="10,0">
                <TextBlock x:Name="StatusText"
                           Text="Hazır — Komut girin veya araç seçin."
                           Foreground="#6B6F88" FontSize="12.5"
                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
            </Border>

            <!-- CAD Toggles: ORTHO, SNAP, POLAR -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <ToggleButton x:Name="BtnOrthoMode"
                              Content="ORTHO" FontSize="11" FontFamily="Consolas"
                              Padding="8,4" Margin="3,0"
                              Background="#12141A" Foreground="#6B6F88"
                              BorderBrush="#2E3148" BorderThickness="1"
                              ToolTip="Ortho Modu (F8)">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"   Value="#0A1F38"/>
                                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#0A84FF"/>
                                                <Setter Property="Foreground"                    Value="#00DDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1C24"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton x:Name="BtnOsnapMode"
                              Content="OSNAP" FontSize="11" FontFamily="Consolas"
                              Padding="8,4" Margin="3,0"
                              Background="#12141A" Foreground="#6B6F88"
                              BorderBrush="#2E3148" BorderThickness="1"
                              IsChecked="True"
                              ToolTip="Object Snap (F3)" Click="OnOsnapModeToggle">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"  Value="#0A1F38"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                                                <Setter Property="Foreground"                   Value="#00DDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1C24"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton x:Name="BtnPolarMode"
                              Content="POLAR" FontSize="11" FontFamily="Consolas"
                              Padding="8,4" Margin="3,0"
                              Background="#12141A" Foreground="#6B6F88"
                              BorderBrush="#2E3148" BorderThickness="1"
                              ToolTip="Polar Tracking (F10)" Click="OnPolarModeToggle">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"  Value="#0A1F38"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                                                <Setter Property="Foreground"                   Value="#00DDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1C24"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton x:Name="BtnOTrackMode"
                              Content="OTRACK" FontSize="11" FontFamily="Consolas"
                              Padding="8,4" Margin="3,0"
                              Background="#12141A" Foreground="#6B6F88"
                              BorderBrush="#2E3148" BorderThickness="1"
                              ToolTip="Object Snap Tracking (F11)" Click="OnOTrackModeToggle">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"  Value="#0A1F38"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0A84FF"/>
                                                <Setter Property="Foreground"                   Value="#00DDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1C24"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>

            <!-- Zoom -->
            <Border Grid.Column="5" Background="#1A1C24"
                    Padding="10,0" BorderBrush="#252836" BorderThickness="1,0,0,0">
                <TextBlock x:Name="ZoomText"
                           Text="Zoom: 100%"
                           Foreground="#7A7D94" FontSize="12"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
            </Border>
        </Grid>

    </Grid>
</Window>
