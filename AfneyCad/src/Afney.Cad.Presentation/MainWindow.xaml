                                            <Button x:Name="BtnToggleGas"        Content="💨 Gaz"           Click="OnToggleGas"        Style="{StaticResource RbnBtn}" Tag="MEP_GAZ"          ToolTip="Gaz katmanını göster/gizle"/>
                                            <Button x:Name="BtnToggleVent"       Content="🌀 Havalandırma" Click="OnToggleVent"       Style="{StaticResource RbnBtn}" Tag="MEP_HAVALANDIRMA" ToolTip="Havalandırma katmanını göster/gizle"/>
                                            <Button Content="✅ Tümünü Göster"   Click="OnShowAllSystems"  Style="{StaticResource RbnBtn}" ToolTip="Tüm sistem katmanlarını göster"/>
                                        </StackPanel>
                                        <TextBlock Text="Sistem Görünürlüğü" Foreground="#666" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#00DDFF" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="4,2">
