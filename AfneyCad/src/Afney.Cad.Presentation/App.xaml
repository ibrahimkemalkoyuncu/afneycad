<Application x:Class="Afney.Cad.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- AutoCAD Dark Theme Colors -->
            <SolidColorBrush x:Key="DarkBackground" Color="#1e1e1e"/>
            <SolidColorBrush x:Key="MediumDark" Color="#2d2d2d"/>
            <SolidColorBrush x:Key="LightDark" Color="#3e3e42"/>
            <SolidColorBrush x:Key="CanvasBackground" Color="#212830"/>
            <SolidColorBrush x:Key="AccentRed" Color="#D32F2F"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#007ACC"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
            
            <!-- GLOBAL STYLES -->

            <!-- Menu Style -->
            <Style TargetType="Menu">
                <Setter Property="Background" Value="{StaticResource MediumDark}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            
            <!-- MenuItem Style (Basit versiyon, koyu tema uyumlu) -->
            <!-- Not: Tam ControlTemplate olmadan Hover renklerini değiştirmek zordur.
                 Ancak Background/Foreground burada set edilirse en azından okunur olur. -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="Black"/> <!-- Varsayılan Windows Menü Arkaplanı Beyazdır, yazı Siyah olmalı -->
                <Style.Triggers>
                     <!-- Eğer Parent Menu ise (Top Level) -->
                     <Trigger Property="Role" Value="TopLevelHeader">
                         <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                     </Trigger>
                     <Trigger Property="Role" Value="TopLevelItem">
                         <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                     </Trigger>
                     <!-- Submenu Item (Açılır Menü) -->
                     <Trigger Property="Role" Value="SubmenuItem">
                         <Setter Property="Foreground" Value="Black"/> <!-- Standart Windows Popup Beyazdır -->
                     </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ContextMenu Style -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="White"/> 
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
