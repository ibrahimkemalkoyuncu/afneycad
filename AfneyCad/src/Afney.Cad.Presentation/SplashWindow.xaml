<Window x:Class="Afney.Cad.Presentation.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AfneyCAD 2026" 
        Height="500" Width="800"
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2b2b2b">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Background Graphics -->
        <Grid Grid.RowSpan="3">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e1e1e" Offset="0.0"/>
                    <GradientStop Color="#2d2d2d" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <!-- Red Accent Line -->
            <Rectangle Height="4" VerticalAlignment="Top" Fill="#D32F2F"/>
            
            <!-- Bottom Glow -->
            <Rectangle Height="200" VerticalAlignment="Bottom" Opacity="0.1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#D32F2F" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Main Content -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- LOGO: Big A -->
            <Border Width="120" Height="120" Background="#D32F2F" CornerRadius="12" HorizontalAlignment="Center">
                <TextBlock Text="A" FontFamily="Segoe UI" FontSize="90" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Margin="0,-15,0,0"/>
            </Border>
            
            <!-- APP NAME -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="AfneyCAD" FontSize="48" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0"/>
                <TextBlock Text="2026" FontSize="48" FontWeight="Light" Foreground="#E0E0E0"/>
            </StackPanel>
            
            <TextBlock Text="Professional Edition" FontSize="16" Foreground="#AAAAAA" 
                      HorizontalAlignment="Center" Margin="0,5,0,0" FontStyle="Italic"/>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Width="500" Height="4" 
                    Background="#333333" Foreground="#D32F2F" Margin="0,40,0,10" 
                    Minimum="0" Maximum="100" Value="0"/>

        <!-- Status Text -->
        <StackPanel Grid.Row="2" Margin="20,0,20,20">
            <TextBlock x:Name="StatusText" Text="Initializing..." Foreground="#888888" 
                      FontSize="12" FontFamily="Consolas" HorizontalAlignment="Left"/>
            <TextBlock Text="© 2026 Afney Software House. All rights reserved." 
                      Foreground="#555555" FontSize="10" HorizontalAlignment="Right" 
                      Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
