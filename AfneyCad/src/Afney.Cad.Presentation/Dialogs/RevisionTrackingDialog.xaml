<Window x:Class="Afney.Cad.Presentation.Dialogs.RevisionTrackingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Proje Revizyon Yönetimi — Rev.A/B/C Takibi"
        Height="680" Width="1050"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252530" BorderBrush="#555" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#1A1A3A" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.ClipboardList}" Fill="#FFD740" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Proje Revizyon Yönetimi" FontSize="15" FontWeight="Bold" Foreground="#FFD740"/>
                <TextBlock Text="  Rev.A / Rev.B / Rev.C — Değişiklik Takibi · Mühendis Onay Akışı · Pafta Revizyon Tablosu"
                           FontSize="10" Foreground="#998840" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt butonlar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#AAAACC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Width="130" Margin="0,0,8,0" Click="ExportReport_Click" Background="#455A64">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.FileDocument}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Revizyon Raporu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Width="110" Margin="0,0,8,0" Click="SaveJson_Click" Background="#1B5E20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Save}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="JSON Kaydet" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Width="110" Margin="0,0,8,0" Click="LoadJson_Click" Background="#4A148C">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="JSON Yükle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <TabControl Background="#252535" BorderThickness="0">

            <!-- ───── SEKME 1: REVİZYON LİSTESİ ───── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.ClipboardList}" Fill="{StaticResource IconFillAccent}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Revizyon Listesi" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <!-- Araçlar -->
                    <Border DockPanel.Dock="Top" Background="#1A1A3A" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Yeni Revizyon" Width="120" Click="AddRevision_Click" Background="#1B5E20" Margin="0,0,6,0"/>
                            <Button Width="90" Click="EditRevision_Click" Background="#0D3060" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Ico.Pencil}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="70" Click="DeleteRevision_Click" Background="#6D0000" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Ico.Trash}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sil" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Durum Değiştir:" Margin="0,0,6,0" Foreground="#AAA"/>
                            <Button Width="90" Click="Approve_Click" Background="#1B5E20" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Ico.CheckCircle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Onayla" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="90" Click="Publish_Click" Background="#0D47A1" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Ico.TrayUpload}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yayınla" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="70" Click="Cancel_Click" Background="#6D0000" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Ico.Close}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="İptal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Revizyon tablosu -->
                        <DataGrid x:Name="RevGrid" Grid.Column="0" AutoGenerateColumns="False"
                                  SelectionChanged="RevGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rev." Binding="{Binding RevCode}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#FFD740"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tarih"       Binding="{Binding DateStr}"     Width="80"/>
                                <DataGridTextColumn Header="Açıklama"    Binding="{Binding Description}" Width="200"/>
                                <DataGridTextColumn Header="Mühendis"    Binding="{Binding Engineer}"    Width="90"/>
                                <DataGridTextColumn Header="Kontrol"     Binding="{Binding Checker}"     Width="90"/>
                                <DataGridTextColumn Header="Onay"        Binding="{Binding Approver}"    Width="90"/>
                                <DataGridTextColumn Header="Durum"       Binding="{Binding StatusLabel}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Sağ: Detay / Değişiklik notu -->
                        <Border Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="DEĞİŞİKLİK NOTU" Foreground="#FFD740" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailRevCode" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFD740" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailStatus" Text="—" Foreground="#90CAF9" Margin="0,0,0,8"/>
                                <Separator Background="#333" Margin="0,0,0,8"/>
                                <TextBlock Text="Açıklama:" Foreground="#888" FontSize="10"/>
                                <TextBlock x:Name="DetailDesc" Text="—" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="Değişiklik Detayı:" Foreground="#888" FontSize="10"/>
                                <TextBox   x:Name="DetailNotice" IsReadOnly="True" Text="—" TextWrapping="Wrap"
                                           Height="120" Background="#0A0A1A" Foreground="#AAA"
                                           VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" VerticalContentAlignment="Top"/>
                                <TextBlock Text="Değişen Alanlar:" Foreground="#888" FontSize="10"/>
                                <TextBlock x:Name="DetailAreas" Text="—" TextWrapping="Wrap" Foreground="#A5D6A7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ───── SEKME 2: YENİ REVİZYON GİRİŞİ ───── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Plus}" Fill="{StaticResource IconFillAccent}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni Revizyon" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#0D1117" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Revizyon Açıklaması:" Foreground="#FFD740" FontWeight="Bold" Margin="0,6"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtDesc" Margin="0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Değişiklik Nedeni:" Margin="0,6"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CboReason" Margin="0,6" IsEditable="True"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Değişiklik Notu (Detay):" Margin="0,6"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtChangeNotice"
                                           Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                           VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                           Margin="0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Değişen Alanlar:" Margin="0,6"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtChangedAreas"
                                           Margin="0,6" ToolTip="Virgülle ayırın: Soğuk Su, Pis Su, Isıtma..."/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Hazırlayan Mühendis:" Margin="0,6"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtEngineer" Margin="0,6"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Kontrol Eden:" Margin="0,6"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtChecker" Margin="0,6"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Onaylayan:" Margin="0,6"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtApprover" Margin="0,6"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Başlangıç Durumu:" Margin="0,6"/>
                                <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="CboInitStatus" Margin="0,6" SelectedIndex="0">
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ico.FileDocument}" Fill="White" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Taslak" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ico.Search}" Fill="White" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Kontrol Bekliyor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ico.CheckCircle}" Fill="White" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Onaylandı" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ico.TrayUpload}" Fill="White" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Yayınlandı" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Button Width="200" HorizontalAlignment="Left"
                                Click="AddRevision_Click" Background="#1B5E20" Height="34" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.CheckCircle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Revizyon Ekle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───── SEKME 3: PROJE BAŞLIK BİLGİSİ ───── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.OfficeBuilding}" Fill="{StaticResource IconFillAccent}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Proje Başlığı" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <Border Background="#0D1117" CornerRadius="4" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Proje Adı:" Margin="0,6"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtProjName" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Proje Numarası:" Margin="0,6"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtProjNumber" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="İşveren / Müşteri:" Margin="0,6"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtClient" Margin="0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pafta Başlığı:" Margin="0,6"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtDrawingTitle" Margin="0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pafta Numarası:" Margin="0,6"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtDrawingNumber" Margin="0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ölçek:" Margin="0,6"/>
                            <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="CboScale" Margin="0,6" IsEditable="True">
                                <ComboBoxItem Content="1:50"/><ComboBoxItem Content="1:100"/>
                                <ComboBoxItem Content="1:200"/><ComboBoxItem Content="1:500"/>
                                <ComboBoxItem Content="1:20"/> <ComboBoxItem Content="Ölçeksiz"/>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Proje Aşaması:" Margin="0,6"/>
                            <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="CboPhase" Margin="0,6">
                                <ComboBoxItem Content="Ön Proje"/>
                                <ComboBoxItem Content="Kesin Proje"/>
                                <ComboBoxItem Content="Uygulama Projesi" IsSelected="True"/>
                                <ComboBoxItem Content="As-Built (Yapıldığı Gibi)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sorumlu Mühendis:" Margin="0,6"/>
                            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TxtRespEng" Margin="0,6"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Firma Adı:" Margin="0,6"/>
                            <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TxtCompany" Margin="0,6"/>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
