<Window x:Class="Afney.Cad.Presentation.Dialogs.PipeWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 Boru Sihirbazı (Pipe Wizard) — AfneyCAD" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🏗️ Tesisat Şablonu Seçin" FontSize="20" FontWeight="Bold" Foreground="#7CFC00" Margin="0,0,0,15"/>
        <ListBox Grid.Row="1" x:Name="TemplateList" Background="#252535" Foreground="White" BorderBrush="#555"
                 SelectionChanged="TemplateList_SelectionChanged" FontSize="14" Padding="5">
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock x:Name="DescriptionText" Text="" Foreground="#AAA" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="FixtureCountText" Text="" Foreground="#00BFFF" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Sistem Tipi:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="SystemTypeCombo" Width="200" Background="#333" Foreground="Black" SelectedIndex="0">
                <ComboBoxItem Content="Soğuk Su"/>
                <ComboBoxItem Content="Sıcak Su"/>
                <ComboBoxItem Content="Pis Su"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="✅ Yerleştir" Click="Place_Click" Width="120" Height="35" Background="#2E8B57" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0"/>
            <Button Content="İptal" Click="Cancel_Click" Width="80" Height="35" Background="#555" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
