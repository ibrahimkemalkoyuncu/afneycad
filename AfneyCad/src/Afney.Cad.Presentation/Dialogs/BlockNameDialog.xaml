<Window x:Class="Afney.Cad.Presentation.Dialogs.BlockNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Blok Tanımı" Height="180" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D2D30" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BLOK İSMİ GİRİN" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="LightGray"/>
        
        <TextBox x:Name="NameInput" Grid.Row="1" Height="30" Background="#1E1E1E" Foreground="White" BorderBrush="#007ACC" VerticalContentAlignment="Center" Padding="5"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OLUŞTUR" Click="Ok_Click" Width="90" Height="28" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="İPTAL" IsCancel="True" Width="80" Height="28" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
