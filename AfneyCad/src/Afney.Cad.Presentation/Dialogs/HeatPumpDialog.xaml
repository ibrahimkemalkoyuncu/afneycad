<Window x:Class="Afney.Cad.Presentation.Dialogs.HeatPumpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌡️ Isı Pompası — COP / SCOP / SEER (TS EN 14825)"
        Height="660" Width="960"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#0D1117" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌡️ Isı Pompası Seçimi" FontSize="15" FontWeight="Bold" Foreground="#FFD740"/>
                <TextBlock Text="  TS EN 14825 — SCOP / SEER Mevsimsel Performans · Yıllık Enerji · CO₂ Analizi"
                           FontSize="10" Foreground="#888" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#AAAACC" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Giriş -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="HESAP GİRDİLERİ" FontSize="10" Foreground="#FFD740" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="#0D1117" CornerRadius="4" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Isıtma Yükü (kW):" Margin="0,6"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtHeatLoad" Text="10" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Soğutma Yükü (kW):" Margin="0,6"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtCoolLoad" Text="8" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Şehir:" Margin="0,6"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CboCity" Margin="0,6" SelectedIndex="0">
                                <ComboBoxItem Content="İstanbul"/><ComboBoxItem Content="Ankara"/>
                                <ComboBoxItem Content="İzmir"/><ComboBoxItem Content="Bursa"/>
                                <ComboBoxItem Content="Erzurum"/><ComboBoxItem Content="Antalya"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tasarım Sıcaklığı (°C):" Margin="0,6"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtDesignTemp" Text="-3" Margin="0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Beslenme Sıcaklığı (°C):" Margin="0,6"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtSupplyTemp" Text="35" Margin="0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Emisyon Sistemi:" Margin="0,6"/>
                            <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="CboEmission" Margin="0,6" SelectedIndex="0">
                                <ComboBoxItem Content="Yerden Isıtma (W35)"/>
                                <ComboBoxItem Content="Fan-Coil (W45)"/>
                                <ComboBoxItem Content="Radyatör (W55-70)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Takviye Isıtıcı:" Margin="0,6"/>
                            <CheckBox  Grid.Row="6" Grid.Column="1" x:Name="ChkBackup" IsChecked="True"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,6"
                                       Content="Dahil et"/>
                        </Grid>

                        <Button Content="🔢 Hesapla" Width="200" HorizontalAlignment="Left"
                                Margin="0,16,0,0" Height="34" FontSize="13"
                                Click="Calculate_Click" Background="#0D47A1"/>

                        <Separator Background="#333" Margin="0,12"/>
                        <TextBlock Text="KATALOG FİLTRESİ" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CboCatalogManuf" Margin="0,0,0,6" SelectedIndex="0">
                            <ComboBoxItem Content="Tüm Markalar"/>
                            <ComboBoxItem Content="Daikin"/>
                            <ComboBoxItem Content="Vaillant"/>
                            <ComboBoxItem Content="Mitsubishi"/>
                            <ComboBoxItem Content="Bosch"/>
                        </ComboBox>
                        <DataGrid x:Name="CatalogGrid" MaxHeight="250" AutoGenerateColumns="False"
                                  Background="#252535" Foreground="White" CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                                  RowBackground="#252535" AlternatingRowBackground="#2A2A3E"
                                  SelectionChanged="CatalogGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0D3060"/>
                                    <Setter Property="Foreground" Value="#90CAF9"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Model"     Binding="{Binding ModelName}"    Width="120"/>
                                <DataGridTextColumn Header="Isıtma kW" Binding="{Binding HeatingKw}"   Width="70"/>
                                <DataGridTextColumn Header="SCOP"      Binding="{Binding SCOP_35}"      Width="55"/>
                                <DataGridTextColumn Header="Sınıf"     Binding="{Binding EnergyClass}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Sonuçlar -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="ANALİZ SONUÇLARI" FontSize="10" Foreground="#FFD740" FontWeight="Bold" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Önerilen ünite -->
                        <Border Background="#0D1117" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ÖNERİLEN ÜNİTE" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ResUnit"   Text="—" FontSize="14" FontWeight="Bold" Foreground="#FFD740" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ResSeries" Text="—" Foreground="#888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ResClass"  Text="—" Foreground="#A5D6A7" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PERFORMANS" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SCOP:" Foreground="#888" FontSize="11"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResSCOP" Text="—" Foreground="#80DEEA" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SEER:" Foreground="#888" FontSize="11"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResSEER" Text="—" Foreground="#EF9A9A" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="COP +7°C:" Foreground="#888" FontSize="11"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResCOP" Text="—" Foreground="#CE93D8" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Takviye:" Foreground="#888" FontSize="11"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResBackup" Text="—" Foreground="#FFCC02" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Yıllık enerji -->
                        <Border Background="#0D1117" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="YILLIK ISINMA" FontSize="9" Foreground="#90CAF9" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResHeatKwh" Text="—" FontSize="16" FontWeight="Bold" Foreground="#EF9A9A"/>
                                    <TextBlock Text="kWh/yıl" Foreground="#888" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="YILLIK SOĞUTMA" FontSize="9" Foreground="#90CAF9" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResCoolKwh" Text="—" FontSize="16" FontWeight="Bold" Foreground="#80DEEA"/>
                                    <TextBlock Text="kWh/yıl" Foreground="#888" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="TOPLAM ELEKTRİK" FontSize="9" Foreground="#90CAF9" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResElec" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFCC02"/>
                                    <TextBlock Text="kWh/yıl" Foreground="#888" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="CO₂ EMİSYONU" FontSize="9" Foreground="#90CAF9" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResCO2" Text="—" FontSize="16" FontWeight="Bold" Foreground="#A5D6A7"/>
                                    <TextBlock Text="kg/yıl" Foreground="#888" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Uyarılar -->
                        <Border x:Name="WarnBorder" Background="#1A0D0D" CornerRadius="4" Padding="14" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠ UYARILAR" FontSize="10" Foreground="#FFCC02" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ResWarnings" Text="" Foreground="#FF8A80" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Öneri metni -->
                        <Border Background="#0D2A0D" CornerRadius="4" Padding="14">
                            <TextBlock x:Name="ResRecommendation" Text="Hesap için 'Hesapla' butonuna basın."
                                       Foreground="#A5D6A7" TextWrapping="Wrap" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
