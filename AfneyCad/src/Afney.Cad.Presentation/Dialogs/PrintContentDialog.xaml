<Window x:Class="Afney.Cad.Presentation.Dialogs.PrintContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baskı İçeriği — AfneyCAD"
        Height="520" Width="480" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="BASKI İÇERİĞİ" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Rapora dahil edilecek bölümleri seçin" FontSize="10" Foreground="#90CAF9"/>
            </StackPanel>
        </Border>

        <!-- İçerik -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12">
            <StackPanel>

                <!-- Proje Bilgileri -->
                <GroupBox Header="Proje Bilgileri">
                    <StackPanel>
                        <CheckBox x:Name="ChkProjectInfo"  Content="📋 Proje Adı ve Genel Bilgiler"  IsChecked="True"/>
                        <CheckBox x:Name="ChkCalcDate"     Content="📅 Hesap Tarihi ve Versiyon"      IsChecked="True"/>
                        <CheckBox x:Name="ChkEngineer"     Content="👷 Mühendis İmza Alanı"           IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Hesap Föyü -->
                <GroupBox Header="Hesap Föyü">
                    <StackPanel>
                        <CheckBox x:Name="ChkCalcTable"    Content="📊 Segment Hesap Tablosu (tüm satırlar)" IsChecked="True"/>
                        <CheckBox x:Name="ChkWarningsOnly" Content="⚠ Yalnızca Uyarılı Segmentler"         IsChecked="False"/>
                        <CheckBox x:Name="ChkNormRef"      Content="📖 Norm Referans Tablosu (TS EN 12056-2)" IsChecked="True"/>
                        <CheckBox x:Name="ChkSummaryBar"   Content="📈 Özet Satırı (toplam, uyarı sayısı)"  IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ek Hesaplar -->
                <GroupBox Header="Ek Hesaplar">
                    <StackPanel>
                        <CheckBox x:Name="ChkSeptic"       Content="🪣 Foseptik / Kapalı Çukur Hesabı"     IsChecked="False"/>
                        <CheckBox x:Name="ChkPump"         Content="⚙ Pis Su Pompası Hesabı"               IsChecked="False"/>
                        <CheckBox x:Name="ChkBom"          Content="📦 Keşif Listesi (Malzeme Metrajı)"     IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Çıktı Biçimi -->
                <GroupBox Header="Çıktı Biçimi">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Çıktı Türü:" VerticalAlignment="Center" Margin="0,4,10,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbHtml"   Content="HTML (Tarayıcı)" Foreground="White" IsChecked="True" Margin="0,0,16,0" GroupName="OutFmt"/>
                            <RadioButton x:Name="RbWord"   Content="Word (.doc)"     Foreground="White" Margin="0,0,16,0" GroupName="OutFmt"/>
                            <RadioButton x:Name="RbPdf"    Content="PDF"             Foreground="White" GroupName="OutFmt"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Proje Adı:" VerticalAlignment="Center" Margin="0,6,10,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtProjectName"
                                   Text="AfneyCAD Projesi" Background="#2A2A3E" Foreground="White"
                                   BorderBrush="#555" Padding="4,3" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mühendis:" VerticalAlignment="Center" Margin="0,6,10,4"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtEngineerName"
                                   Background="#2A2A3E" Foreground="White"
                                   BorderBrush="#555" Padding="4,3" Margin="0,4"/>
                    </Grid>
                </GroupBox>

                <!-- Durum -->
                <Border x:Name="StatusBorder" Background="#0A1A0A" CornerRadius="4"
                        Padding="10,8" Visibility="Collapsed" BorderBrush="#2E7D32" BorderThickness="1">
                    <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="#A5D6A7" FontSize="11"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Butonlar -->
        <Border Grid.Row="2" Background="#1B1B2E" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🖨 Rapor Oluştur" Click="Print_Click"
                        Background="#2E7D32" Margin="0,0,8,0" Width="150"/>
                <Button Content="Kapat" Click="Close_Click" Background="#444" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
