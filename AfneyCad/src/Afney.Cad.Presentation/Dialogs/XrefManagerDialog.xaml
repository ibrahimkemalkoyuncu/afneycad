<Window x:Class="Afney.Cad.Presentation.Dialogs.XrefManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dış Kaynak (Xref) Yöneticisi — AfneyCAD"
        Height="500" Width="680" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="DIŞ KAYNAK (XREF) YÖNETİCİSİ" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Ekran çizimleri olarak kaydedilmiş blokları yönetin ve bağlayın" FontSize="10" Foreground="#90CAF9"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="XrefGrid" Margin="12,10,12,4"
                  SelectionChanged="XrefGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad"           Binding="{Binding DisplayName}" Width="120"/>
                <DataGridTextColumn Header="Blok Adı"     Binding="{Binding BlockName}"   Width="160"/>
                <DataGridTextColumn Header="Nesne Sayısı" Binding="{Binding EntityCount}" Width="100"/>
                <DataGridTextColumn Header="Durum"        Binding="{Binding StatusText}"  Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Eylem Butonları -->
        <Border Grid.Row="2" Background="#252535" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAttach"   Click="Attach_Click"
                        Background="#2E7D32" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Link}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Bağla (Referans Ekle)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDetach"   Click="Detach_Click"
                        Background="#B71C1C" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Scissors}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Ayır" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TxtHint" VerticalAlignment="Center" Foreground="#90CAF9" FontSize="10"
                           Text="Bir blok seçin ve 'Bağla' ile çizime yerleştirin."/>
            </StackPanel>
        </Border>

        <!-- Xref bilgi + Kapat -->
        <Border Grid.Row="3" Background="#1B1B2E" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtInfo" VerticalAlignment="Center" Foreground="#90CAF9" FontSize="10" Margin="0,0,20,0"
                           Text="Blok eklemek için önce 'Ekran Çizimi' ile yakalayın."/>
                <Button Content="Kapat" Click="Close_Click" Background="#444" Width="80" Margin="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
