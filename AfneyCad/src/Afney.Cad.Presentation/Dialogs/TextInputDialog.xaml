<Window x:Class="Afney.Cad.Presentation.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metin Girin" Height="200" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C24" Foreground="#E1E4EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Text="Çizime eklenecek metin:" FontSize="12" Margin="0,0,0,10" Foreground="#858899"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Height="36"
                 Background="#12141A" Foreground="#E1E4EE"
                 BorderBrush="#0A84FF" BorderThickness="1"
                 CaretBrush="White" FontFamily="Consolas" FontSize="14"
                 VerticalContentAlignment="Center" Padding="8,0"
                 AcceptsReturn="False"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="EKLE" Click="Ok_Click" Width="90" Height="30" Margin="0,0,10,0"
                    Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="İPTAL" IsCancel="True" Width="80" Height="30"
                    Background="#24273A" Foreground="#858899" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
