<Window x:Class="Afney.Cad.Presentation.Dialogs.EnergyRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♻ Isı Geri Kazanım (ERV/HRV) — EN 308 / ASHRAE 84" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B5E20"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#123016" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.Refresh}" Fill="#81C784" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Isı Geri Kazanım Ünitesi (ERV/HRV)" FontSize="15" FontWeight="Bold" Foreground="#81C784"/>
                <TextBlock Text="  Duyulur/Gizli Isı Geri Kazanımı ve Yıllık Tasarruf (EN 308 / ASHRAE 84)" FontSize="10" Foreground="#66BB6A" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Click="Calculate_Click" Background="#1B5E20" Width="100" Margin="0,0,8,0" Content="Hesapla"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="#1B2B3B" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="ÜNİTE VE HAVA KOŞULLARI" FontSize="10" Foreground="#81C784" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="ERV Tipi:" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CboErvType" Width="220">
                            <ComboBoxItem Content="Plakalı Eşanjör" IsSelected="True"/>
                            <ComboBoxItem Content="Döner Tamburlu (Entalpik)"/>
                            <ComboBoxItem Content="Isı Borusu"/>
                            <ComboBoxItem Content="Dolaşımlı Serpantin"/>
                            <ComboBoxItem Content="Membranlı Plaka (Entalpik)"/>
                        </ComboBox>
                        <TextBlock Text="  Debi (m³/h):" Margin="16,0,8,0"/>
                        <TextBox x:Name="TxtAirFlow" Text="500" Width="70"/>
                        <TextBlock Text="  Çalışma Saati/Yıl:" Margin="16,0,8,0"/>
                        <TextBox x:Name="TxtOperatingHours" Text="4000" Width="70"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Dış T (°C):" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtOutdoorT" Text="-12" Width="50"/>
                            <TextBlock Text="  Dış RH (%):" Margin="12,0,8,0"/>
                            <TextBox x:Name="TxtOutdoorRH" Text="80" Width="50"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="İç T (°C):" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtIndoorT" Text="22" Width="50"/>
                            <TextBlock Text="  İç RH (%):" Margin="12,0,8,0"/>
                            <TextBox x:Name="TxtIndoorRH" Text="50" Width="50"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Özel Verim (opsiyonel, 0-1, boş=katalog ortalaması):" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtCustomEff" Text="" Width="60"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#123016" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Text="Henüz hesap yapılmadı." Foreground="#81C784" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VERİM" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResEfficiency" Text="—" FontSize="13" FontWeight="Bold" Foreground="#A5D6A7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BESLEME ÇIKIŞ SICAKLIĞI" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResSupplyTemp" Text="—" FontSize="13" FontWeight="Bold" Foreground="#A5D6A7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DUYULUR GERİ KAZANIM" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResSensibleKW" Text="—" FontSize="13" FontWeight="Bold" Foreground="#A5D6A7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="BASINÇ KAYBI" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResPressureDrop" Text="—" FontSize="13" FontWeight="Bold" Foreground="#A5D6A7"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="YILLIK ENERJİ TASARRUFU" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResAnnualSavings" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFD740"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="YILLIK CO2 TASARRUFU" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResAnnualCO2" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFD740"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
