<Window x:Class="Afney.Cad.Presentation.Dialogs.TechnicalSpecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teknik Şartname Oluştur" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C24" Foreground="#E1E4EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TEKNİK ŞARTNAME" FontSize="14" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,0,14"/>

        <GroupBox Grid.Row="1" Header="Proje Bilgileri" Foreground="#7AA0CC" BorderBrush="#252836" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Firma Adı:" Foreground="#858899" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtCompany" Grid.Column="1" Text="AfneyCAD Mühendislik" Height="24" Background="#12141A" Foreground="#E1E4EE" BorderBrush="#252836" Padding="4,0" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Proje Adı:" Foreground="#858899" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtProject" Grid.Row="1" Grid.Column="1" Height="24" Background="#12141A" Foreground="#E1E4EE" BorderBrush="#252836" Padding="4,0" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Mühendis:" Foreground="#858899" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtEngineer" Grid.Row="2" Grid.Column="1" Height="24" Background="#12141A" Foreground="#E1E4EE" BorderBrush="#252836" Padding="4,0" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="Standart:" Foreground="#858899" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbStandard" Grid.Row="3" Grid.Column="1" Height="24" Background="#12141A" Foreground="#E1E4EE" SelectedIndex="0">
                    <ComboBoxItem Content="TS 11154 / TS EN 806"/>
                    <ComboBoxItem Content="DIN 1988-300"/>
                    <ComboBoxItem Content="ASPE / IPC 2021"/>
                    <ComboBoxItem Content="BS 6700"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="İçerik Seçenekleri" Foreground="#7AA0CC" BorderBrush="#252836" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <CheckBox x:Name="ChkBOM" Content="Malzeme Listesi (BOM)" Foreground="#E1E4EE" IsChecked="True" Margin="0,0,20,4"/>
                <CheckBox x:Name="ChkMontaj" Content="Montaj Notları" Foreground="#E1E4EE" IsChecked="True" Margin="0,0,20,4"/>
                <CheckBox x:Name="ChkCost" Content="Maliyet Özeti" Foreground="#E1E4EE" IsChecked="True" Margin="0,0,20,4"/>
            </WrapPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="HTML Oluştur" Click="OnGenerate_Click" Width="110" Height="32"
                    Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="İptal" IsCancel="True" Width="80" Height="32"
                    Background="#24273A" Foreground="#858899" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
