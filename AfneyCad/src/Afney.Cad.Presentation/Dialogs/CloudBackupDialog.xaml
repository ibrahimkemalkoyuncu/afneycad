<Window x:Class="Afney.Cad.Presentation.Dialogs.CloudBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="☁️ Bulut Yedekleme — AfneyCAD" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.Cloud}" Fill="#90CAF9" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Bulut Yedekleme" FontSize="15" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  OneDrive · Google Drive · Dropbox ile entegre" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Kapat" Width="80" Background="#333" Click="Close_Click"/>
        </StackPanel>

        <StackPanel>
            <!-- Hedef Klasör -->
            <GroupBox Header="Yedekleme Hedefi" Foreground="#90CAF9" BorderBrush="#444" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtBackupDir" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="2" Click="BrowseDir_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Gözat..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </GroupBox>

            <!-- Otomatik Yedek -->
            <GroupBox Header="Otomatik Yedekleme" Foreground="#90CAF9" BorderBrush="#444" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="ChkAutoBackup" Content="Otomatik yedeklemeyi etkinleştir" Margin="0,0,16,0" Checked="AutoBackup_Changed" Unchecked="AutoBackup_Changed"/>
                        <TextBlock Text="Aralık:" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbInterval" Width="100" SelectionChanged="Interval_Changed">
                            <ComboBoxItem Content="5 dakika"/>
                            <ComboBoxItem Content="15 dakika" IsSelected="True"/>
                            <ComboBoxItem Content="30 dakika"/>
                            <ComboBoxItem Content="60 dakika"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="TxtAutoStatus" Text="Durum: Devre dışı" Foreground="#90CAF9" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <!-- Manuel Yedek -->
            <GroupBox Header="Manuel Yedek" Foreground="#90CAF9" BorderBrush="#444" Padding="8,6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button Width="130" Click="BackupNow_Click" Background="#1B5E20" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.Cloud}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Şimdi Yedekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TxtLastBackup" Text="Son yedek: —" Foreground="#A5D6A7" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <!-- Yedek Listesi -->
            <GroupBox Header="Mevcut Yedekler (Son 20)" Foreground="#90CAF9" BorderBrush="#444" Padding="8,6">
                <StackPanel>
                    <DataGrid x:Name="BackupGrid" Height="160" AutoGenerateColumns="False" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dosya Adı"  Binding="{Binding FileName}"  Width="*"/>
                            <DataGridTextColumn Header="Boyut (KB)" Binding="{Binding SizeKb}"    Width="90"/>
                            <DataGridTextColumn Header="Oluşturma"  Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120" Click="RefreshList_Click" Background="#37474F">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Listeyi Yenile" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="110" Click="OpenFolder_Click" Background="#37474F" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Klasörü Aç" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
