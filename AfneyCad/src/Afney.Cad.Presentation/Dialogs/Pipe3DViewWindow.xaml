<Window x:Class="Afney.Cad.Presentation.Dialogs.Pipe3DViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧊 3D Boru Görünümü — AfneyCAD" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" Background="#1A1A2E" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="3D Boru Modeli" FontSize="18" FontWeight="Bold" Foreground="#00BFFF" VerticalAlignment="Center"/>
            <TextBlock Text="LOD:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <ComboBox x:Name="LodCombo" Width="150" Background="#333" Foreground="Black" SelectedIndex="1" SelectionChanged="Lod_Changed">
                <ComboBoxItem Content="LOD 100 (Basit)"/>
                <ComboBoxItem Content="LOD 200 (Standart)"/>
                <ComboBoxItem Content="LOD 300 (Detaylı)"/>
            </ComboBox>
            <Button Click="Refresh_Click" Width="80" Height="28" Margin="15,0" Background="#005A9C" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Ico.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#555" BorderThickness="1" Background="#0A0A1A">
            <Viewport3D x:Name="MainViewport">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" Position="5000,5000,5000" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="60"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#444"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D x:Name="ModelGroup"/>
            </Viewport3D>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10">
            <TextBlock x:Name="StatsText" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Kapat" Click="Close_Click" Width="80" Height="30" HorizontalAlignment="Right" Margin="20,0,0,0" Background="#555" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
