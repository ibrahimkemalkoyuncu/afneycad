<Window x:Class="Afney.Cad.Presentation.Dialogs.SheetSetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📑 Pafta Seti Yöneticisi — Sheet Set Manager"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#1A1A3A" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.ClipboardList}" Fill="#FFD740" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Pafta Seti Yöneticisi" FontSize="15" FontWeight="Bold" Foreground="#FFD740"/>
                <TextBlock Text="  Tüm paftaları listele · elle ekle/sil/sırala · proje dosyasıyla birlikte kalıcı kaydedilir"
                           FontSize="10" Foreground="#998840" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt butonlar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#AAAACC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <!-- Araçlar -->
        <Border DockPanel.Dock="Top" Background="#1A1A3A" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Width="110" Click="AddSheet_Click" Background="#1B5E20" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Plus}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Pafta Ekle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="70" Click="DeleteSheet_Click" Background="#6D0000" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Trash}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Sil" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="36" Click="MoveUp_Click" Background="#0D3060" Margin="0,0,4,0" ToolTip="Yukarı Taşı" Content="▲"/>
                <Button Width="36" Click="MoveDown_Click" Background="#0D3060" Margin="0,0,16,0" ToolTip="Aşağı Taşı" Content="▼"/>
                <Button Width="130" Click="ExportIndex_Click" Background="#455A64" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.FileDocument}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Pafta İndeksi (HTML)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="SheetGrid" Grid.Column="0" AutoGenerateColumns="False"
                      SelectionChanged="SheetGrid_SelectionChanged" MouseDoubleClick="SheetGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pafta No" Binding="{Binding Number}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#FFD740"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Disiplin"     Binding="{Binding Discipline}"  Width="70"/>
                    <DataGridTextColumn Header="Çizim Adı"    Binding="{Binding Name}"        Width="220"/>
                    <DataGridTextColumn Header="Açıklama / Proje" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Durum"        Binding="{Binding Status}"      Width="90"/>
                    <DataGridTextColumn Header="Kayıt Tarihi" Binding="{Binding Registered, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Sağ: yeni pafta formu -->
            <Border Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="YENİ PAFTA" Foreground="#FFD740" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                    <TextBlock Text="Pafta No (boş = otomatik):" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtNumber" Margin="0,0,0,8"/>

                    <TextBlock Text="Disiplin (M/E/HVAC...):" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtDiscipline" Text="M" Margin="0,0,0,8"/>

                    <TextBlock Text="Çizim Adı:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtName" Margin="0,0,0,8"/>

                    <TextBlock Text="Açıklama / Proje:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtDescription" Margin="0,0,0,8"/>

                    <TextBlock Text="Durum:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtStatus" Text="Taslak" Margin="0,0,0,8"/>

                    <Button Content="+ Ekle" Click="AddSheet_Click" Background="#1B5E20" Margin="0,4,0,0"/>

                    <Separator Background="#333" Margin="0,12,0,12"/>
                    <TextBlock Text="Seçili pafta çift tıklanınca Pafta İndeksi (HTML) raporu açılır ve ilgili kayıt vurgulanır."
                               TextWrapping="Wrap" Foreground="#777" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
