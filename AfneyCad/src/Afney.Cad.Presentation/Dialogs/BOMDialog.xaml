<Window x:Class="Afney.Cad.Presentation.Dialogs.BOMDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Malzeme Metraj Listesi (BOM)" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BORU METRAJ LİSTESİ" FontWeight="Bold" Foreground="LimeGreen" Margin="0,0,0,10"/>
        
        <DataGrid x:Name="PipeGrid" Grid.Row="1" Background="#2D2D2D" Foreground="White" BorderThickness="0" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding PipeGroups}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Çap (DN)" Binding="{Binding Diameter}" Width="100"/>
                <DataGridTextColumn Header="Sistem" Binding="{Binding SystemType}" Width="*"/>
                <DataGridTextColumn Header="Toplam Uzunluk (m)" Binding="{Binding TotalLength, StringFormat={}{0:F2}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="VİTRİFİYE VE CİHAZ LİSTESİ" FontWeight="Bold" Foreground="Cyan" Margin="0,20,0,10"/>

        <DataGrid x:Name="FixtureGrid" Grid.Row="3" Background="#2D2D2D" Foreground="White" BorderThickness="0" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding FixtureGroups}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cihaz Tipi" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="Adet" Binding="{Binding Count}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="EXCEL'E AKTAR" Width="120" Height="30" Margin="0,0,10,0" Background="#1D6F42" Foreground="White" BorderThickness="0"/>
            <Button Content="KAPAT" IsCancel="True" Width="100" Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
