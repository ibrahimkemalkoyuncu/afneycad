<Window x:Class="Afney.Cad.Presentation.Dialogs.MahalInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahal Bilgileri" Height="250" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D2D30" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MAHAL TANIMLA" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="Orange"/>
        
        <TextBlock Grid.Row="1" Text="Mahal Adı:" Margin="0,0,0,5"/>
        <TextBox x:Name="MahalNameBox" Grid.Row="2" Background="#1E1E1E" Foreground="White" BorderBrush="#007ACC" Padding="5" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Mahal Tipi:" Margin="0,0,0,5"/>
        <ComboBox x:Name="TypeCombo" Grid.Row="4" Background="#1E1E1E" Foreground="White" BorderBrush="#007ACC">
            <ComboBoxItem Content="Oda" IsSelected="True"/>
            <ComboBoxItem Content="Mutfak"/>
            <ComboBoxItem Content="Banyo"/>
            <ComboBoxItem Content="WC"/>
            <ComboBoxItem Content="Antre/Hol"/>
            <ComboBoxItem Content="Balkon"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="TAMAM" Click="Ok_Click" Width="80" Height="28" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="İPTAL" IsCancel="True" Width="80" Height="28" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
