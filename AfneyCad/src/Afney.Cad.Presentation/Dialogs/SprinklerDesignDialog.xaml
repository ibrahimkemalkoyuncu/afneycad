<Window x:Class="Afney.Cad.Presentation.Dialogs.SprinklerDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔥 Sprinkler Hesabı — NFPA 13 / TS EN 12845"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252530" BorderBrush="#555" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#0D1117" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.Fire}" Fill="#FFD740" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Sprinkler Sistemi Tasarımı" FontSize="15" FontWeight="Bold" Foreground="#FFD740"/>
                <TextBlock Text="  NFPA 13 Yoğunluk/Alan Metodu — Tehlike Sınıfı · Debi · Boru Boyutu · Basınç"
                           FontSize="10" Foreground="#888" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#AAAACC" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Giriş -->
            <Border Grid.Column="0" Background="#0D1117" CornerRadius="4" Padding="14">
                <StackPanel>
                    <TextBlock Text="SİSTEM PARAMETRELERİ" FontSize="10" Foreground="#FFD740" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tehlike Sınıfı:" Foreground="#FFD740" FontWeight="Bold" Margin="0,6"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CboHazard" Margin="0,6" SelectedIndex="1"
                                   SelectionChanged="CboHazard_SelectionChanged">
                            <ComboBoxItem Content="Hafif Tehlike (Light)"/>
                            <ComboBoxItem Content="Orta Tehlike 1 (OH1)"/>
                            <ComboBoxItem Content="Orta Tehlike 2 (OH2)"/>
                            <ComboBoxItem Content="Yüksek Tehlike 1 (EH1)"/>
                            <ComboBoxItem Content="Yüksek Tehlike 2 (EH2)"/>
                            <ComboBoxItem Content="ESFR"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Korunan Alan (m²):" Margin="0,6"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtArea" Text="500" Margin="0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="K-faktörü (L/dak/√bar):" Margin="0,6"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CboKFactor" Margin="0,6" SelectedIndex="0">
                            <ComboBoxItem Content="57 (K5.6 — küçük orfis)"/>
                            <ComboBoxItem Content="80 (K8 — standart)"/>
                            <ComboBoxItem Content="115 (K11.2 — büyük orfis)"/>
                            <ComboBoxItem Content="202 (K20 — ESFR)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Kapsama (m²/sprinkler):" Margin="0,6"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtCoverage" Text="12" Margin="0,6"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Basınç (bar):" Margin="0,6"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtMinPress" Text="0.70" Margin="0,6"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Statik Basınç (bar):" Margin="0,6"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtStaticPress" Text="7.0" Margin="0,6"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Sprinkler Tipi:" Margin="0,6"/>
                        <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="CboType" Margin="0,6" SelectedIndex="0">
                            <ComboBoxItem Content="Sarkık (Pendent)"/>
                            <ComboBoxItem Content="Dik (Upright)"/>
                            <ComboBoxItem Content="Yan Duvar (Sidewall)"/>
                            <ComboBoxItem Content="ESFR"/>
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Kuru Sistem:" Margin="0,6"/>
                        <CheckBox  Grid.Row="7" Grid.Column="1" x:Name="ChkDryPipe" Foreground="White"
                                   Content="Kuru boru (don riski)" VerticalAlignment="Center" Margin="0,6"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tehlike Açıklaması:" Margin="0,6"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtHazardDesc" Text="—"
                                   Foreground="#90CAF9" FontSize="10" TextWrapping="Wrap" Margin="0,6"/>
                    </Grid>

                    <Button Width="200" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Height="34" FontSize="13"
                            Click="Calculate_Click" Background="#B71C1C">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.Calculator}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Hesapla" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Sonuçlar -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="HESAP SONUÇLARI" FontSize="10" Foreground="#FFD740" FontWeight="Bold" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#0D1117" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TASARIM" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResDensity"    Text="—" Foreground="#EF9A9A" FontSize="13" FontWeight="Bold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="ResDesignArea" Text="—" Foreground="#888" FontSize="10"/>
                                    <TextBlock x:Name="ResActiveSpr"  Text="—" Foreground="#FFCC02" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ResTotalSpr"   Text="—" Foreground="#888" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DEBİ" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResFlow"     Text="—" Foreground="#80DEEA" FontSize="14" FontWeight="Bold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="ResFlowM3h"  Text="—" Foreground="#888" FontSize="10"/>
                                    <TextBlock x:Name="ResSprFlow"  Text="—" Foreground="#CE93D8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#0D1117" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BASINÇ" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResMinPress"  Text="—" Foreground="#EF9A9A" FontSize="13" FontWeight="Bold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="ResResidual"  Text="—" Foreground="#A5D6A7" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="BORU BOYUTU" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                                    <TextBlock x:Name="ResMainPipe"   Text="—" Foreground="#FFD740" FontSize="14" FontWeight="Bold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="ResBranchPipe" Text="—" Foreground="#FFCC02" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#0D2A0D" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="{StaticResource Ico.CheckCircle}" Fill="#A5D6A7" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="UYUMLULUK" FontSize="10" Foreground="#A5D6A7" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="ResCompliance" Text="—" Foreground="#A5D6A7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="WarnBorder" Background="#1A0D0D" CornerRadius="4" Padding="14" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="{StaticResource Ico.Warning}" Fill="#FFCC02" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="UYARILAR" FontSize="10" Foreground="#FFCC02" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="ResWarnings" Text="" Foreground="#FF8A80" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
