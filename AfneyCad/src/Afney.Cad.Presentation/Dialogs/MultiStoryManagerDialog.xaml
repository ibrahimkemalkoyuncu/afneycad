<Window x:Class="Afney.Cad.Presentation.Dialogs.MultiStoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏢 Çok Katlı Bina Yönetimi — AfneyCAD" Height="550" Width="700"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252530" BorderBrush="#555" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ÇOK KATLI BİNA YÖNETİMİ" FontSize="18" FontWeight="Bold" Foreground="#7CFC00" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Hızlı Oluştur:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Kat Sayısı:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="FloorCountInput" Width="50" Text="5" Background="#333" Foreground="White" VerticalContentAlignment="Center"/>
            <TextBlock Text="Kat Yüks. (mm):" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox x:Name="FloorHeightInput" Width="60" Text="3000" Background="#333" Foreground="White" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="BasementCheck" Content="Bodrum" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
            <Button Click="CreateBuilding_Click" Width="170" Height="28" Margin="15,0,0,0" Background="#2E8B57" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Ico.OfficeBuilding}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Standart Bina Oluştur" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="FloorGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#252535" Foreground="White" RowBackground="#2A2A3A" AlternatingRowBackground="#1E1E2E"
                  BorderBrush="#555" GridLinesVisibility="All" CanUserSortColumns="True"
                  ColumnHeaderHeight="32" RowHeight="26">

            <!-- Kolon Başlık Stili: Koyu Tema Uyumlu -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1B2A3C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="6,0,4,0"/>
                    <Setter Property="BorderBrush" Value="#3A5070"/>
                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A3D55"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Satır Stili -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A3A4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- Hücre Stili -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Sıra" Binding="{Binding Order}" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kat Adı" Binding="{Binding Name}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7FC3FF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kot (mm)" Binding="{Binding Elevation, StringFormat=F0}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A0FFAA"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Yükseklik (mm)" Binding="{Binding Height, StringFormat=F0}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A0FFAA"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="50"/>
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityIds.Count}" Width="55">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD080"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kolon" Binding="{Binding RiserIds.Count}" Width="55">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD080"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10">
            <!-- Kat kopyalama -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Hedef Kat:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,6,0"/>
                <ComboBox x:Name="TargetFloorCombo" Width="160" Height="28" Background="#333" Foreground="White"
                          DisplayMemberPath="Name" ToolTip="Kopyalama / kolon için hedef kat"/>
                <Button Click="CopyFloor_Click" Width="130" Height="28"
                        Background="#005A9C" Foreground="White" BorderThickness="0" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.ClipboardList}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Kat Kopyala" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Kolon oluşturma -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sistem:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,6,0"/>
                <ComboBox x:Name="RiserSystemCombo" Width="110" Height="28" Background="#333" Foreground="White">
                    <ComboBoxItem Content="Soğuk Su"  IsSelected="True"/>
                    <ComboBoxItem Content="Sıcak Su"/>
                    <ComboBoxItem Content="Pis Su"/>
                    <ComboBoxItem Content="Yangın"/>
                    <ComboBoxItem Content="Gaz"/>
                    <ComboBoxItem Content="Yağmur"/>
                </ComboBox>
                <TextBlock Text="DN:" VerticalAlignment="Center" Foreground="#AAA" Margin="10,0,4,0"/>
                <ComboBox x:Name="RiserDnCombo" Width="70" Height="28" Background="#333" Foreground="White">
                    <ComboBoxItem Content="DN25"/>
                    <ComboBoxItem Content="DN32"/>
                    <ComboBoxItem Content="DN40"/>
                    <ComboBoxItem Content="DN50" IsSelected="True"/>
                    <ComboBoxItem Content="DN65"/>
                    <ComboBoxItem Content="DN80"/>
                    <ComboBoxItem Content="DN100"/>
                    <ComboBoxItem Content="DN125"/>
                    <ComboBoxItem Content="DN150"/>
                </ComboBox>
                <Button Click="CreateRiser_Click" Width="130" Height="28"
                        Background="#2E6B2E" Foreground="White" BorderThickness="0" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Link}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Kolon Oluştur" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="InfoText" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="4" Content="Kapat" Click="Close_Click" Width="80" Height="30" HorizontalAlignment="Right" Background="#555" Foreground="White" BorderThickness="0"/>
    </Grid>
</Window>
