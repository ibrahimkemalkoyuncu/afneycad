<Window x:Class="Afney.Cad.Presentation.Dialogs.PumpGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Pompaj Grubu Seçimi — AfneyCAD"
        Height="680" Width="1000" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0D47A1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="⚙" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="POMPAJ GRUBU SEÇİMİ" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Paralel / Seri pompa kombinasyonu — Q-H karakteristik analizi"
                               FontSize="10" Foreground="#90CAF9"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sol Panel: Girişler -->
        <Border Grid.Row="1" Grid.Column="0" Background="#252535" Padding="12" BorderBrush="#333" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Pompa Seçimi -->
                    <TextBlock Text="POMPA MODELİ" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPump" Height="28" Margin="0,0,0,10"
                              SelectionChanged="CmbPump_SelectionChanged"/>

                    <!-- Kombinasyon Tipi -->
                    <TextBlock Text="KOMBİNASYON" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border Background="#1A1A2E" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton x:Name="RbParallel" Content="Paralel (Q toplar, H aynı)"
                                         IsChecked="True" Checked="Combination_Changed"/>
                            <RadioButton x:Name="RbSeries"   Content="Seri (H toplar, Q aynı)"
                                         Checked="Combination_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Pompa Sayısı -->
                    <TextBlock Text="POMPA SAYISI" FontSize="10" Foreground="#90CAF9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbN1" Content="1" GroupName="PCount" IsChecked="True" Margin="0,0,10,0" Checked="PumpCount_Changed"/>
                        <RadioButton x:Name="RbN2" Content="2" GroupName="PCount" Margin="0,0,10,0" Checked="PumpCount_Changed"/>
                        <RadioButton x:Name="RbN3" Content="3" GroupName="PCount" Checked="PumpCount_Changed"/>
                    </StackPanel>

                    <Separator Background="#333" Margin="0,4,0,10"/>

                    <!-- Sistem Eğrisi Parametreleri -->
                    <TextBlock Text="SİSTEM EĞRİSİ" FontSize="10" Foreground="#80CBC4" FontWeight="Bold" Margin="0,0,0,4"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Statik Yük (mSS):" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtStaticHead" Text="15" TextChanged="SystemCurve_Changed"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tasarım Debisi (m³/h):" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtDesignFlow" Text="10" TextChanged="SystemCurve_Changed"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tasarım Basma (mSS):" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtDesignHead" Text="30" TextChanged="SystemCurve_Changed"/>
                    </Grid>

                    <Separator Background="#333" Margin="0,4,0,10"/>

                    <!-- Çalışma Noktası Bilgisi -->
                    <TextBlock Text="ÇALIŞMA NOKTASI" FontSize="10" Foreground="#FFD54F" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Border Background="#1A2A1A" CornerRadius="4" Padding="8,6" BorderBrush="#2E7D32" BorderThickness="1" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="TxtOpFlow" Text="Q: —" FontSize="12"/>
                            <TextBlock x:Name="TxtOpHead" Text="H: —" FontSize="12" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtOpStatus" Text="—" FontSize="10" Foreground="#80CBC4" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Kombine Pompa Bilgisi -->
                    <TextBlock Text="KOMBİNE PERFORMANS" FontSize="10" Foreground="#FFCC80" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Border Background="#1A1A2A" CornerRadius="4" Padding="8,6" BorderBrush="#1565C0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtGroupMaxFlow" Text="Max Q: —" FontSize="11"/>
                            <TextBlock x:Name="TxtGroupMaxHead" Text="Max H: —" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtGroupPower"   Text="Toplam Güç: —" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Q-H Grafiği -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0F0F1E" Margin="0">
            <skia:SKElement x:Name="ChartElement" PaintSurface="Chart_Paint"/>
        </Border>

        <!-- Legand -->
        <Border Grid.Row="2" Grid.Column="1" Background="#181828" Padding="10,6">
            <WrapPanel Orientation="Horizontal">
                <Border Background="#1565C0" Width="30" Height="3" Margin="4,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Tek Pompa" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11"/>
                <Border Background="#FFD54F" Width="30" Height="3" Margin="4,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Kombinasyon" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11"/>
                <Border Background="#FF7043" Width="30" Height="2" Margin="4,0,4,0" VerticalAlignment="Center"
                        BorderBrush="#FF7043" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                    <Border.Effect><DashStyle/></Border.Effect>
                </Border>
                <TextBlock Text="Sistem Eğrisi" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11"/>
                <Ellipse Width="8" Height="8" Fill="#69F0AE" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Text="Çalışma Noktası" VerticalAlignment="Center" FontSize="11"/>
            </WrapPanel>
        </Border>

        <!-- Butonlar -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#1B1B2E" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📄 HTML Rapor" Click="ExportHtml_Click" Margin="0,0,8,0"/>
                <Button Content="Kapat" Click="Close_Click" Background="#444" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
