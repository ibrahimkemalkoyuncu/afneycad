<Window x:Class="Afney.Cad.Presentation.Dialogs.MahalDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahal Tanımı"
        Height="520" Width="480"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1A1A1F"
        Foreground="White"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Ortak TextBox stili -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#252530"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#444"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="White"/>
        </Style>

        <!-- Ortak ComboBox stili -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"       Value="#252530"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#444"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,3"/>
            <Setter Property="FontSize"         Value="13"/>
            <!-- NE: Açılan liste (popup) öğe stili
                 NEDEN: ComboBox.Foreground, popup içindeki ComboBoxItem'lara miras geçmez.
                 Bu Setter olmadan sistem varsayılanı (genelde koyu zeminde siyah metin)
                 kullanılır ve liste öğeleri "görünmez" gibi durur — sadece hover/seçili
                 öğe (mavi vurgu) görünür kalır. -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label stili -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#AAAAAA"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Vurgu buton (Kaydet) -->
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background"      Value="#007ACC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0090E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Normal buton (İptal) -->
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Background"      Value="#333340"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#555"/>
            <Setter Property="Padding"         Value="20,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Başlık -->
            <RowDefinition Height="Auto"/>  <!-- Ad + Tip giriş -->
            <RowDefinition Height="Auto"/>  <!-- Tip öneri paneli -->
            <RowDefinition Height="Auto"/>  <!-- Alan + Çevre bilgisi -->
            <RowDefinition Height="Auto"/>  <!-- Vitrifiye başlığı -->
            <RowDefinition Height="*"/>     <!-- Vitrifiye tablosu -->
            <RowDefinition Height="Auto"/>  <!-- Toplam FU -->
            <RowDefinition Height="Auto"/>  <!-- Butonlar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════ BAŞLIK ══════════════════════════ -->
        <Border Grid.Row="0" Background="#0D1117" Padding="20,14,20,14"
                BorderBrush="#007ACC" BorderThickness="0,0,0,2">
            <StackPanel>
                <TextBlock Text="🏠 MAHAL TANIMI"
                           FontSize="17" FontWeight="Bold"
                           Foreground="#00AAFF"/>
                <TextBlock x:Name="MahalSubHeaderText"
                           Text="Yeni Mahal"
                           FontSize="11" Foreground="#888"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════ GİRİŞ ALANLARI ══════════════════════ -->
        <Border Grid.Row="1" Background="#1E1E2A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mahal Adı -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MAHAL ADI *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MahalNameInput"
                             Style="{StaticResource DarkTextBox}"
                             MaxLength="80"
                             ToolTip="Zorunlu alan — mahal adını girin (örn: Banyo, Mutfak)"/>
                </StackPanel>

                <!-- Mahal Tipi -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="MAHAL TİPİ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MahalTypeCombo"
                              Style="{StaticResource DarkComboBox}"
                              SelectedIndex="1"
                              SelectionChanged="OnMahalTypeChanged">
                        <!-- Konut -->
                        <ComboBoxItem Content="— KONUT —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Banyo"/>
                        <ComboBoxItem Content="WC"/>
                        <ComboBoxItem Content="Mutfak"/>
                        <ComboBoxItem Content="Mutfak + Banyo"/>
                        <ComboBoxItem Content="Oturma Odası"/>
                        <ComboBoxItem Content="Yatak Odası"/>
                        <ComboBoxItem Content="Çocuk Odası"/>
                        <ComboBoxItem Content="Çamaşır Odası"/>
                        <ComboBoxItem Content="Koridor"/>
                        <ComboBoxItem Content="Antre"/>
                        <ComboBoxItem Content="Balkon"/>
                        <ComboBoxItem Content="Depo"/>
                        <!-- Ofis -->
                        <ComboBoxItem Content="— OFİS —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Ofis"/>
                        <ComboBoxItem Content="Ofis (Açık Plan)"/>
                        <ComboBoxItem Content="Ofis WC (Erkek)"/>
                        <ComboBoxItem Content="Ofis WC (Kadın)"/>
                        <ComboBoxItem Content="Toplantı Odası"/>
                        <!-- Ticari -->
                        <ComboBoxItem Content="— TİCARİ —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Restoran Mutfak"/>
                        <ComboBoxItem Content="Otel Odası Banyo"/>
                        <!-- Hastane -->
                        <ComboBoxItem Content="— HASTANE —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Hasta Odası"/>
                        <ComboBoxItem Content="Ameliyathane"/>
                        <ComboBoxItem Content="Hastane WC"/>
                        <!-- Eğitim -->
                        <ComboBoxItem Content="— EĞİTİM —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Sınıf"/>
                        <ComboBoxItem Content="Okul WC"/>
                        <ComboBoxItem Content="Laboratuvar"/>
                        <!-- Endüstri -->
                        <ComboBoxItem Content="— ENDÜSTRİ —" IsEnabled="False" FontWeight="Bold" Foreground="#888"/>
                        <ComboBoxItem Content="Soyunma/Duş"/>
                        <!-- Diğer -->
                        <ComboBoxItem Content="Diğer"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ TİP ÖNERİ PANELİ ══════════════════════ -->
        <Border x:Name="TypeHintPanel" Grid.Row="2" Background="#1A2218" Padding="20,8"
                BorderBrush="#2A4A2A" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TypeHintTitle" FontSize="11" FontWeight="Bold"
                               Foreground="#66BB66" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TypeHintDetail" FontSize="11"
                               Foreground="#AAAAAA" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="AddStandardSetBtn" Grid.Column="1"
                        Content="+ Standart Set Ekle"
                        Click="OnAddStandardFixtureSet"
                        Visibility="Collapsed"
                        Background="#1A5C1A" Foreground="White" BorderThickness="0"
                        Padding="10,5" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ══════════════════════ ALAN & ÇEVRE ══════════════════════ -->
        <Border Grid.Row="3" Background="#181820" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Alan -->
                <Border Background="#1E2B1E" CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ALAN"
                                   FontSize="10" Foreground="#66AA66"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AreaText"
                                   Text="— m²"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#44DD88"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Çevre -->
                <Border Background="#1E2020" CornerRadius="6" Padding="14,8">
                    <StackPanel>
                        <TextBlock Text="ÇEVRE"
                                   FontSize="10" Foreground="#6699AA"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PerimeterText"
                                   Text="— m"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#44BBDD"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════════ VİTRİFİYE BAŞLIK ══════════════════════ -->
        <Border Grid.Row="4" Background="#1A1A22" Padding="20,8,20,4">
            <TextBlock Text="BAĞLI VİTRİFİYE / SARFIYAT BİRİMLERİ"
                       FontSize="10" FontWeight="Bold"
                       Foreground="#00CCAA"/>
        </Border>

        <!-- ══════════════════════ VİTRİFİYE TABLOSU ══════════════════════ -->
        <DataGrid x:Name="FixtureGrid"
                  Grid.Row="5"
                  Margin="20,0,20,0"
                  Background="#16161E"
                  Foreground="#DDDDDD"
                  BorderThickness="1"
                  BorderBrush="#2A2A38"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#252530"
                  RowBackground="#16161E"
                  AlternatingRowBackground="#1C1C26"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"    Value="#1E1E2A"/>
                    <Setter Property="Foreground"    Value="#00AAFF"/>
                    <Setter Property="FontWeight"    Value="Bold"/>
                    <Setter Property="FontSize"      Value="11"/>
                    <Setter Property="Padding"       Value="10,6"/>
                    <Setter Property="BorderBrush"   Value="#2A2A38"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cihaz / Reseptör"
                                    Binding="{Binding FixtureType}"
                                    Width="*"/>
                <DataGridTextColumn Header="LU (Yük Birimi)"
                                    Binding="{Binding LoadUnits, StringFormat={}{0:F2}}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground"          Value="#FFAA44"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <!-- Boş durum mesajı -->
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGrid">
                                        <Border Background="#16161E" Padding="20">
                                            <TextBlock Text="Bu mahalde henüz vitrifiye tanımlanmamış."
                                                       Foreground="#555" FontStyle="Italic"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
        </DataGrid>

        <!-- ══════════════════════ TOPLAM FU ══════════════════════ -->
        <Border Grid.Row="6"
                Background="#1A1A22"
                BorderBrush="#333340" BorderThickness="0,1,0,0"
                Padding="20,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TOPLAM YÜK BİRİMİ (∑LU)"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#888"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TotalFUText"
                               Text="0.00"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#FF9900"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" FU"
                               FontSize="13" Foreground="#886644"
                               VerticalAlignment="Bottom"
                               Margin="2,0,0,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ BUTONLAR ══════════════════════ -->
        <Border Grid.Row="7"
                Background="#0D0D14"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ValidationMsg"
                           Text=""
                           Foreground="#FF5555"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button x:Name="CancelButton"
                        Content="İPTAL"
                        Style="{StaticResource CancelBtn}"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                        Content="KAYDET"
                        Style="{StaticResource SaveBtn}"
                        Click="OnSaveClick"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
