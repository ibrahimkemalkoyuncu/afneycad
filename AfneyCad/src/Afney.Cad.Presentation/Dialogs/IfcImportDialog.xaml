<Window x:Class="Afney.Cad.Presentation.Dialogs.IfcImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IFC İçeri Aktar — AfneyCAD" Height="520" Width="640"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#005A9C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Grid.Row="0" Text="IFC DOSYASI İÇERİ AKTARMA" FontSize="16" FontWeight="Bold"
                   Foreground="#AADDFF" Margin="0,0,0,14"/>

        <!-- Dosya Seçimi -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtFilePath" IsReadOnly="True" Grid.Column="0"
                     Text="IFC dosyası seçilmedi..." Foreground="#888"/>
            <Button Grid.Column="1" Content="📂 Dosya Seç" Click="BrowseFile_Click"
                    Margin="8,0,0,0" Width="100"/>
        </Grid>

        <!-- İçeri Aktarılacak Elemanlar -->
        <GroupBox Grid.Row="2" Header="İçeri Aktarılacak IFC Elemanları" Margin="0,0,0,12"
                  BorderBrush="#445" Foreground="White">
            <StackPanel Margin="8,6">
                <CheckBox x:Name="ChkWalls"   Content="Duvarlar (IfcWall, IfcWallStandardCase)" IsChecked="True"/>
                <CheckBox x:Name="ChkSlabs"   Content="Döşemeler (IfcSlab)" IsChecked="True"/>
                <CheckBox x:Name="ChkWindows" Content="Pencereler (IfcWindow)" IsChecked="True"/>
                <CheckBox x:Name="ChkDoors"   Content="Kapılar (IfcDoor)" IsChecked="True"/>
                <CheckBox x:Name="ChkSpaces"  Content="Mekanlar (IfcSpace — etiket olarak)" IsChecked="True"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Ölçek faktörü:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ScaleCombo" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="1:1 (metre → mm × 1000)"/>
                        <ComboBoxItem Content="1:1 (mm — olduğu gibi)"/>
                        <ComboBoxItem Content="1:100 (cm → mm × 10)"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Önizleme Log -->
        <Border Grid.Row="3" BorderBrush="#445" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PreviewLog"
                           Text="Dosya seçilince içerik analizi burada görünür."
                           Foreground="#888" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- İlerleme -->
        <ProgressBar Grid.Row="4" x:Name="ImportProgress" Height="6" Margin="0,10,0,6"
                     Minimum="0" Maximum="100" Value="0" Foreground="#4080FF"/>

        <!-- Butonlar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="🔍 Önizle" Click="Preview_Click" Width="90" Margin="0,0,10,0"/>
            <Button Content="✅ İçeri Aktar" Click="Import_Click" Width="110"
                    Background="#2E8B57" x:Name="BtnImport" IsEnabled="False"/>
            <Button Content="İptal" Click="Cancel_Click" Width="70" Margin="10,0,0,0" Background="#444"/>
        </StackPanel>
    </Grid>
</Window>
