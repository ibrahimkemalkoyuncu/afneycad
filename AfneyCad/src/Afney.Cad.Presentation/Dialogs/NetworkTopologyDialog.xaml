<Window x:Class="Afney.Cad.Presentation.Dialogs.NetworkTopologyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔗 Boru Ağı Topoloji Analizi — AfneyCAD" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔗 Boru Ağı Topoloji Analizi" FontSize="14" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  Döngü · Açık Uç · Kritik Yol" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔍 Analiz Et" Width="110" Margin="0,0,8,0" Click="Analyze_Click" Background="#1B5E20"/>
                <Button Grid.Column="2" Content="🎯 Kritik Yolu Seç" Width="130" Margin="0,0,8,0" Click="SelectCriticalPath_Click" Background="#4A148C"/>
                <Button Grid.Column="3" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Özet Paneli -->
            <Border Grid.Row="0" Background="#252535" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtLoops" Text="—" FontSize="24" FontWeight="Bold" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                        <TextBlock Text="Döngü" Foreground="#667" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtOpenEnds" Text="—" FontSize="24" FontWeight="Bold" Foreground="#FFA040" HorizontalAlignment="Center"/>
                        <TextBlock Text="Açık Uç" Foreground="#667" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtComponents" Text="—" FontSize="24" FontWeight="Bold" Foreground="#FF6666" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bileşen" Foreground="#667" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtCritical" Text="—" FontSize="18" FontWeight="Bold" Foreground="#44DD88" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kritik Yol (m)" Foreground="#667" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detay Listesi -->
            <ListBox Grid.Row="1" x:Name="SummaryList" SelectionMode="Single"/>
        </Grid>
    </DockPanel>
</Window>
