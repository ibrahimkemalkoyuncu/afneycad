<Window x:Class="Afney.Cad.Presentation.Dialogs.PressureDropReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kritik Hat Basınç Kaybı Raporu" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="HİDROLİK HESAP VE KRİTİK HAT RAPORU" FontSize="20" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,10"/>
        
        <!-- Summary Info -->
        <Border Grid.Row="1" Background="#2D2D2D" Padding="15" CornerRadius="5" Margin="0,0,0,20">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Sistem Tipi" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="SystemTypeText" Text="Pis Su" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="En Dezavantajlı Uç" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="FixtureText" Text="Lavabo (L1)" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Maksimum Hız" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="MaxVelocityText" Text="1.45 m/s" FontSize="16" FontWeight="SemiBold" Foreground="#4CAF50"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Toplam Boru Boyu" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TotalLengthText" Text="24.5 m" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="SegmentsGrid" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="#252525" Foreground="White" 
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#333" RowBackground="#252525" AlternatingRowBackground="#2D2D2D">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Boru ID" Binding="{Binding PipeId}" Width="100"/>
                <DataGridTextColumn Header="Çap (mm)" Binding="{Binding Diameter, StringFormat={}{0:F0}}" Width="80"/>
                <DataGridTextColumn Header="Boy (m)" Binding="{Binding Length, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="Debi (m³/h)" Binding="{Binding FlowRate, StringFormat={}{0:F2}}" Width="100"/>
                <DataGridTextColumn Header="Hız (m/s)" Binding="{Binding Velocity, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="Kayp (mSS)" Binding="{Binding PressureDrop, StringFormat={}{0:F4}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Orange"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Statik (m)" Binding="{Binding StaticHead, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="Kümülatif (mSS)" Binding="{Binding CumulativeLoss, StringFormat={}{0:F3}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Calculation Matrix -->
        <Grid Grid.Row="3" Margin="0,20,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <UniformGrid Columns="2" Width="300">
                    <TextBlock Text="Toplam Sürtünme Kaybı:" Foreground="#CCC"/>
                    <TextBlock x:Name="LinearLossText" Text="4.25 mSS" HorizontalAlignment="Right" FontWeight="Bold"/>
                    
                    <TextBlock Text="Toplam Statik Yükseklik:" Foreground="#CCC"/>
                    <TextBlock x:Name="StaticHeadText" Text="6.00 m" HorizontalAlignment="Right" FontWeight="Bold"/>

                    <TextBlock Text="Min. İşletme Basıncı:" Foreground="#CCC"/>
                    <TextBlock x:Name="ResidualPressureText" Text="5.00 mSS" HorizontalAlignment="Right" FontWeight="Bold"/>
                    
                    <Separator Grid.ColumnSpan="2" Background="#444" Margin="0,5"/>
                    
                    <TextBlock Text="GEREKEN POMPA BASINCI:" Foreground="Orange" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TotalPressureText" Text="15.25 mSS" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="Orange"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="POMPA ÖNER" Click="PumpSuggest_Click" Width="140" Height="35" Margin="0,0,10,0" Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="DIŞA AKTAR (HTML)" Click="Export_Click" Width="140" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="TAMAM" Width="100" Height="35" Click="Close_Click" Background="Orange" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
