<Window x:Class="Afney.Cad.Presentation.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş" Width="380" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1C24" Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Grid.Row="0" Foreground="#A0A3B8" FontSize="13" Margin="0,0,0,10"/>

        <TextBox x:Name="InputBox" Grid.Row="1"
                 Background="#12141A" Foreground="White"
                 BorderBrush="#0A84FF" BorderThickness="1"
                 Padding="8,6" FontSize="14" Height="34"
                 CaretBrush="White" FontFamily="Consolas"
                 VerticalContentAlignment="Center"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Tamam" Click="Ok_Click" Width="80" Height="32"
                    Background="#0A84FF" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" FontSize="13" Cursor="Hand"
                    Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="İptal" Click="Cancel_Click" Width="70" Height="32"
                    Background="#24273A" Foreground="#858899" BorderThickness="0"
                    FontSize="13" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
