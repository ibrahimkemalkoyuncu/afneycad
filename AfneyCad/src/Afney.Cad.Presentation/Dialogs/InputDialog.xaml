<Window x:Class="Afney.Cad.Presentation.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş" Width="340" Height="140"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E2226" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Grid.Row="0" Foreground="#CCC" FontSize="12" Margin="0,0,0,6"/>

        <TextBox x:Name="InputBox" Grid.Row="1"
                 Background="#252A35" Foreground="White"
                 BorderBrush="#4A90D9" BorderThickness="1"
                 Padding="6,4" FontSize="12"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Tamam" Click="Ok_Click" Width="70" Height="26"
                    Background="#2A6FBC" Foreground="White" BorderThickness="0"
                    Margin="0,0,6,0" IsDefault="True"/>
            <Button Content="İptal" Click="Cancel_Click" Width="60" Height="26"
                    Background="#444" Foreground="#CCC" BorderThickness="0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
