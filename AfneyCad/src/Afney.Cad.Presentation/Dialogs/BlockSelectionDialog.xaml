<Window x:Class="Afney.Cad.Presentation.Dialogs.BlockSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blok Seçimi" Height="300" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D2D30" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EKLENECEK BLOĞU SEÇİN" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="Orange"/>
        
        <ListBox x:Name="BlockList" Grid.Row="1" Background="#1E1E1E" Foreground="White" BorderThickness="0" SelectionMode="Single" MouseDoubleClick="BlockList_MouseDoubleClick">
             <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="📁" Margin="0,0,5,0" Foreground="Orange"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="TAMAM" Click="Ok_Click" Width="80" Height="25" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="İPTAL" IsCancel="True" Width="80" Height="25" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
