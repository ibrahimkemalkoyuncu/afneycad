<Window x:Class="Afney.Cad.Presentation.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Proje Oluştur" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI" Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Modern Scrollbar Style Placeholder (Simplified) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#2D2D2D"/>
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Left Panel) -->
        <Border Grid.Column="0" Background="#252525" Padding="15">
            <StackPanel>
                <TextBlock Text="AFNEY CAD" FontSize="20" FontWeight="Bold" Foreground="Orange" Margin="10,0,0,30"/>
                
                <TextBlock Text="KONUMLAR" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="10,0,0,10"/>
                
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Projeler (CALC)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.History}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Son Kullanılanlar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.CheckCircle}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Favoriler" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Background="#333" Margin="0,15"/>

                <TextBlock Text="SİSTEM" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="10,0,0,10"/>
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Belgelerim" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Monitor}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Masaüstü" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Globe}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Ağ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content (Right Panel) -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- File List -->
                <RowDefinition Height="Auto"/> <!-- Footer Controls -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Proje Seçimi" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                <Border Background="#2D2D2D" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" MinWidth="300">
                    <DockPanel>
                        <Path Data="{StaticResource Ico.Folder}" Fill="Orange" Width="13" Height="13" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="C:\AFNEY_SANI\CALC" Foreground="#AAA" FontFamily="Consolas"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- File List -->
            <Border Grid.Row="1" Background="#252525" CornerRadius="6" Padding="1">
                <ListView x:Name="ProjectListView" Background="Transparent" BorderThickness="0" Foreground="#DDD"
                          SelectionChanged="ProjectListView_SelectionChanged" FontSize="13">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="#AAA"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Name="Border" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Proje Adı" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Tarih" Width="150" DisplayMemberBinding="{Binding Date}"/>
                            <GridViewColumn Header="Tür" Width="120" DisplayMemberBinding="{Binding Type}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Footer (Inputs & Action) -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Input Area -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Proje Adı" Foreground="#888" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="ProjectNameBox" Height="40" Background="#252525" Foreground="White" BorderBrush="#444" 
                             VerticalContentAlignment="Center" Padding="10,0" FontSize="14" CaretBrush="Orange">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="Yeni bir isim girerek proje oluşturabilir veya listeden seçerek mevcut projeyi açabilirsiniz." 
                               FontSize="11" Foreground="#666" Margin="2,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,0">
                    <Button Content="İptal" Click="Cancel_Click" Style="{StaticResource ModernBtn}" Width="100" Height="40" Background="#333" Margin="0,0,10,0"/>
                    <Button Content="PROJEYİ AÇ / OLUŞTUR" Click="Save_Click" IsDefault="True"
                            Width="180" Height="40" FontSize="13" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernBtn}">
                                <Setter Property="Background" Value="Orange"/> <!-- Afney Acent -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFAA00"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
