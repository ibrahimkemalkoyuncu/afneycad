<Window x:Class="Afney.Cad.Presentation.Dialogs.WasteWaterDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pis Su / Yağmur Suyu Tasarımı — AfneyCAD"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#252535" Margin="8">

        <!-- ===== SEKME 1: KATMAN / MODÜL YÖNETİMİ ===== -->
        <TabItem Header="Katmanlar">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="UYGULAMA KATMANLARINI SEÇ"
                           FontSize="15" FontWeight="Bold" Foreground="#87CEEB" Margin="0,0,0,10"/>

                <GroupBox Grid.Row="1" Header="Aktif Modül" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbColdWater"  Content="Temiz Su (Soğuk)"  GroupName="Module" Foreground="White" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbHotWater"   Content="Temiz Su (Sıcak)"  GroupName="Module" Foreground="White" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbWasteWater" Content="Pis Su"            GroupName="Module" Foreground="White" IsChecked="True" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbRainWater"  Content="Yağmur Suyu"       GroupName="Module" Foreground="White"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Görünür Katmanlar (birden fazla seçilebilir)" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="ChkShowCold"  Content="MEP-COLD  — Temiz Soğuk Su" Foreground="#4FC3F7" IsChecked="False" Margin="0,4"/>
                        <CheckBox x:Name="ChkShowHot"   Content="MEP-HOT   — Temiz Sıcak Su"  Foreground="#EF9A9A" IsChecked="False" Margin="0,4"/>
                        <CheckBox x:Name="ChkShowWaste" Content="MEP-WASTE — Pis Su"          Foreground="#A1887F" IsChecked="True"  Margin="0,4"/>
                        <CheckBox x:Name="ChkShowRain"  Content="MEP-RAIN  — Yağmur Suyu"    Foreground="#64B5F6" IsChecked="False" Margin="0,4"/>
                        <CheckBox x:Name="ChkShowFire"  Content="MEP-FIRE  — Yangın"          Foreground="#EF5350" IsChecked="False" Margin="0,4"/>
                        <CheckBox x:Name="ChkShowGas"   Content="MEP-GAS   — Doğalgaz"        Foreground="#FFB74D" IsChecked="False" Margin="0,4"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Uygula" Click="ApplyLayers_Click" Width="120"
                            Background="#1565C0" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                    <Button Content="Tümünü Göster" Click="ShowAllLayers_Click" Width="120"
                            Background="#2E7D32" Style="{StaticResource ActionBtn}"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== SEKME 2: PİS SU HESABI ===== -->
        <TabItem Header="Pis Su Hesabı">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="PİS SU HESABI — TS EN 12056-2"
                               FontSize="15" FontWeight="Bold" Foreground="#87CEEB"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Hesap Yöntemi:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MethodCombo" Width="260" Background="#333" Foreground="Black" SelectedIndex="1">
                            <ComboBoxItem Content="System I  — Tam Kapasite (Hastane, Endüstri)"/>
                            <ComboBoxItem Content="System II — Konut (K=0.5) [Varsayılan]"/>
                            <ComboBoxItem Content="System III — Ticari/Ofis (K=0.7)"/>
                            <ComboBoxItem Content="System IV — Özel / Her cihaz tam kapasite"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="DrainageGrid"
                          AutoGenerateColumns="False" CanUserAddRows="True"
                          Background="#2A2A3A" Foreground="White"
                          RowBackground="#2A2A3A" AlternatingRowBackground="#252535"
                          BorderBrush="#555" GridLinesVisibility="All" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cihaz Adı"      Binding="{Binding FixtureName}"    Width="*"/>
                        <DataGridTextColumn Header="DU"             Binding="{Binding DU}"             Width="60"/>
                        <DataGridTextColumn Header="Adet"           Binding="{Binding Count}"          Width="60"/>
                        <DataGridCheckBoxColumn Header="Sürekli Akış" Binding="{Binding IsContinuous}" Width="90"/>
                        <DataGridTextColumn Header="Q_sürekli (lt/s)" Binding="{Binding ContinuousFlow}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Content="Hesapla (TS EN 12056-2)"
                        Click="CalcWaste_Click" Width="200" Height="34"
                        HorizontalAlignment="Left" Margin="0,8,0,0"
                        Background="#005A9C" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <TextBlock Grid.Row="3" x:Name="WasteResultText"
                           Foreground="#00FF88" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas"/>
            </Grid>
        </TabItem>

        <!-- ===== SEKME 3: YAĞMUR SUYU HESABI ===== -->
        <TabItem Header="Yağmur Suyu">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="YAĞMUR SUYU HESABI — TS EN 12056-3"
                           FontSize="15" FontWeight="Bold" Foreground="#87CEEB" Margin="0,0,0,8"/>

                <GroupBox Grid.Row="1" Header="Hesap Parametreleri" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Yağış Yoğunluğu (lt/s·ha):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="RainfallInput" Width="80" Text="300"
                                 Background="#333" Foreground="White" Padding="4,2"/>
                        <TextBlock Text="[Türkiye: 300 lt/s·ha — 5dk, 5 yıl]"
                                   Foreground="#888" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <!-- Düşme Alanları tablosu -->
                <DataGrid Grid.Row="2" x:Name="CatchmentGrid"
                          AutoGenerateColumns="False" CanUserAddRows="True"
                          Background="#2A2A3A" Foreground="White"
                          RowBackground="#2A2A3A" AlternatingRowBackground="#252535"
                          BorderBrush="#555" GridLinesVisibility="All" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Alan Adı"         Binding="{Binding Name}"              Width="*"/>
                        <DataGridTextColumn Header="Alan (m²)"        Binding="{Binding AreaM2}"            Width="90"/>
                        <DataGridTextColumn Header="Akış Katsayısı C" Binding="{Binding RunoffCoefficient}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Yağmur Düşme Alanı Çiz"
                            Click="DrawCatchment_Click" Width="180" Height="32"
                            Background="#1565C0" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                    <Button Content="Hesapla (TS EN 12056-3)"
                            Click="CalcRain_Click" Width="180" Height="32"
                            Background="#005A9C" Style="{StaticResource ActionBtn}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" x:Name="RainResultText"
                           Foreground="#00FF88" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas"/>
            </Grid>
        </TabItem>

        <!-- ===== SEKME 4: KOLON ARAÇLARI ===== -->
        <TabItem Header="Kolon Araçları">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="KOLON TANIMLAMA VE TEMİZLEME ARAÇLARI"
                           FontSize="15" FontWeight="Bold" Foreground="#87CEEB" Margin="0,0,0,10"/>

                <!-- Bölünmüş Kolon -->
                <GroupBox Grid.Row="1" Header="Bölünmüş Kolon (Alt+Üst Segment)" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alt Bot (m):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtLowerBot" Text="0"   Background="#333" Foreground="White" Padding="4,2"/>
                        <TextBlock Grid.Column="2" Text="Alt Top (m):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Grid.Column="3" x:Name="TxtLowerTop" Text="3"   Background="#333" Foreground="White" Padding="4,2"/>
                        <TextBlock Grid.Column="4" Text="Üst Bot (m):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Grid.Column="5" x:Name="TxtUpperBot" Text="3"   Background="#333" Foreground="White" Padding="4,2"/>
                        <TextBlock Grid.Column="6" Text="Üst Top (m):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Grid.Column="7" x:Name="TxtUpperTop" Text="6"   Background="#333" Foreground="White" Padding="4,2"/>
                        <Button Grid.Column="8" Content="Bölünmüş Kolon Oluştur"
                                Click="CreateSplitColumn_Click" Width="180"
                                Background="#4A148C" Style="{StaticResource ActionBtn}"
                                Margin="8,0,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Tesisat Kopyalama Doğrulama -->
                <GroupBox Grid.Row="2" Header="Tesisat Kopyalama — Kolon Borusu Kontrolü" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#FFA726" FontSize="12" Margin="0,0,0,8">
                            ⚠ OtoNET Kuralı: Tesisat kopyalanırken kolon boruları (dikey PipeEntity) seçime dahil edilmemelidir.
                            Aşağıdaki buton seçili nesnelerdeki kolon borularını tespit eder ve raporlar.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Seçimi Doğrula (Kolon Tespiti)"
                                    Click="ValidateCopySelection_Click" Width="220"
                                    Background="#E65100" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                            <Button Content="Kolonları Çıkar ve Kopyala"
                                    Click="FilterAndCopy_Click" Width="200"
                                    Background="#2E7D32" Style="{StaticResource ActionBtn}"/>
                        </StackPanel>
                        <TextBlock x:Name="CopyValidationResult" Foreground="#00FF88"
                                   FontSize="12" FontFamily="Consolas"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Boşaltma Noktası (Rögar) -->
                <GroupBox Grid.Row="3" Header="Boşaltma Noktası (Rögar) Tanımla" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,8">
                            Zemin katta tüm kolonlar birleştirildikten sonra tesisatın tahliye noktasına
                            (rögar) boşaltma noktası yerleştirin. Yağmur suyu için ayrı noktalar oluşturabilirsiniz.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Pis Su Rögar Noktası Yerleştir"
                                    Click="PlaceSewerOutlet_Click" Width="220"
                                    Background="#4E342E" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                            <Button Content="Yağmur Suyu Boşaltma Noktası"
                                    Click="PlaceRainOutlet_Click" Width="220"
                                    Background="#1565C0" Style="{StaticResource ActionBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </TabItem>

        <!-- ===== SEKME 5: TEMİZLEME ve DOĞRULAMA ===== -->
        <TabItem Header="Tesisatı Kabul Et">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TESİSATI KABUL ET — SİSTEM DOĞRULAMA"
                           FontSize="15" FontWeight="Bold" Foreground="#87CEEB" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Background="#252535" BorderBrush="#444466"
                        BorderThickness="1" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ValidationLog"
                                   Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap">
Hazır. "Tesisatı Kabul Et" butonuna basarak pis su ve yağmur suyu tesisatını doğrulayın.

Kontrol edilen koşullar:
  ✓ Her WasteWater ağında en az 1 DrainageOutletEntity (rögar)
  ✓ Her RainWater ağında en az 1 DrainageOutletEntity (yağmur boşaltma)
  ✓ Açık uçlar (bağlantısız boru sonu)
  ✓ Kolon boruları bağlantısı
  ✓ Sistem topolojisi tutarlılığı
                        </TextBlock>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Tesisatı Kabul Et"
                            Click="AcceptSystem_Click" Width="180" Height="38"
                            Background="#1B5E20" Foreground="White"
                            BorderThickness="0" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                    <Button Content="Temizle / Sıfırla"
                            Click="ClearLog_Click" Width="120" Height="38"
                            Background="#37474F" Foreground="White"
                            BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
