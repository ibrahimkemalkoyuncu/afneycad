<Window x:Class="Afney.Cad.Presentation.Dialogs.DimensionStyleManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ölçü Stili Yöneticisi — AfneyCAD" Height="520" Width="660"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="Black"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <TextBlock Text="Ölçü Stili Yöneticisi" FontSize="15" FontWeight="Bold" Foreground="#90CAF9"/>
        </Border>

        <!-- Alt buton çubuğu -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="" Foreground="#77AA77"/>
                <Button x:Name="BtnSetActive" Grid.Column="1" Content="Aktif Yap" Width="100" Margin="0,0,8,0"
                        Click="SetActive_Click" Background="#1B5E20"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stil listesi -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnNew" Content="+ Yeni" Width="70" Margin="0,0,4,0" Click="New_Click"/>
                    <Button x:Name="BtnDelete" Content="Sil" Width="60" Background="#7A2020" Click="Delete_Click"/>
                </StackPanel>
                <ListBox x:Name="StyleList" SelectionChanged="StyleList_SelectionChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- Detay editörü -->
            <Border Grid.Column="2" Background="#252535" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="STİL DETAYI" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ad:"/>
                        <TextBox Grid.Column="1" x:Name="TxtName" LostFocus="TxtName_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Metin Yüksekliği (mm):"/>
                        <TextBox Grid.Column="1" x:Name="TxtTextHeight" LostFocus="Field_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ok Boyu (mm):"/>
                        <TextBox Grid.Column="1" x:Name="TxtArrowSize" LostFocus="Field_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Uzatma Boşluğu (mm):"/>
                        <TextBox Grid.Column="1" x:Name="TxtExtLineGap" LostFocus="Field_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Uzatma Aşımı (mm):"/>
                        <TextBox Grid.Column="1" x:Name="TxtExtLineOver" LostFocus="Field_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hassasiyet (ondalık):"/>
                        <TextBox Grid.Column="1" x:Name="TxtPrecision" LostFocus="Field_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Birim Formatı:"/>
                        <ComboBox Grid.Column="1" x:Name="CmbUnitFormat" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="mm"/>
                            <ComboBoxItem Content="cm"/>
                            <ComboBoxItem Content="m"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ok Başı Stili:"/>
                        <ComboBox Grid.Column="1" x:Name="CmbArrowStyle" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="Filled"/>
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="Dot"/>
                            <ComboBoxItem Content="Architectural"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="ChkShowUnits" Content="Birim göster" Margin="140,4,0,0" Checked="Field_CheckChanged" Unchecked="Field_CheckChanged"/>

                    <Separator Background="#444" Margin="0,12,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dosyaya Kaydet" Width="130" Margin="0,0,8,0" Click="SaveToFile_Click"/>
                        <Button Content="Dosyadan Yükle" Width="130" Click="LoadFromFile_Click"/>
                    </StackPanel>
                    <TextBlock Text="(dimension_styles.json — AfneyCAD ayarlar klasörü)" Foreground="#667" FontSize="9" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
