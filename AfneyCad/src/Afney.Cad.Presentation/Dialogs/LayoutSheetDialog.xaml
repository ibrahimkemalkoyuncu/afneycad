<Window x:Class="Afney.Cad.Presentation.Dialogs.LayoutSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pafta Düzeni — AfneyCAD"
        Height="600" Width="780" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="PAFTA DÜZENİ" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Kat çizimlerini pafta sayfasına yerleştirin · Blok Ekle · Patlat" FontSize="10" Foreground="#90CAF9"/>
            </StackPanel>
        </Border>

        <!-- Ana İçerik: Sol + Sağ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Mevcut Bloklar -->
            <GroupBox Grid.Column="0" Header="Mevcut Bloklar (Ekran Çizimleri)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="BlockListGrid" SelectionChanged="BlockListGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad"     Binding="{Binding DisplayName}" Width="100"/>
                            <DataGridTextColumn Header="Nesneler" Binding="{Binding EntityCount}" Width="80"/>
                            <DataGridTextColumn Header="Durum"  Binding="{Binding StatusText}"  Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- X/Y Offset Girişi -->
                    <Grid Grid.Row="1" Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox   Grid.Column="1" x:Name="TxtOffsetX" Text="0" Background="#2A2A3E"
                                   Foreground="White" BorderBrush="#555" Padding="4,3" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox   Grid.Column="3" x:Name="TxtOffsetY" Text="0" Background="#2A2A3E"
                                   Foreground="White" BorderBrush="#555" Padding="4,3"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Offset (mm) — boş bırakılırsa otomatik yerleştirilir"
                               FontSize="9" Foreground="#666" Margin="0,0,0,4"/>

                    <Button Grid.Row="3" x:Name="BtnInsert" Content="➕ Paftaya Ekle (Blok Ekle)"
                            Click="Insert_Click" Background="#2E7D32" IsEnabled="False" Margin="0,2,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Ayraç -->
            <GridSplitter Grid.Column="1" Width="4" Background="#333" HorizontalAlignment="Stretch"/>

            <!-- Sağ: Paftadaki Bloklar -->
            <GroupBox Grid.Column="2" Header="Paftadaki Yerleştirilen Bloklar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="PlacedGrid" SelectionChanged="PlacedGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Blok"  Binding="{Binding BlockName}"  Width="130"/>
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding PosX}"     Width="80"/>
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding PosY}"     Width="80"/>
                            <DataGridTextColumn Header="Ölçek"  Binding="{Binding Scale}"    Width="60"/>
                            <DataGridTextColumn Header="Durum"  Binding="{Binding Status}"   Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnExplode" Content="💥 Patlat (Bir Kez!)"
                                Click="Explode_Click" Background="#F57F17" IsEnabled="False"/>
                        <Button x:Name="BtnRemoveRef" Content="🗑 Kaldır"
                                Click="RemoveRef_Click" Background="#B71C1C" IsEnabled="False"/>
                        <Button Content="🔄 Yenile" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Alt: Durum + Kapat -->
        <Border Grid.Row="2" Background="#1B1B2E" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗒 Antet Ekle" Click="TitleBlock_Click" Background="#5D4037" Margin="0,0,8,0"/>
                    <Button Content="💾 DXF Çıktı" Click="ExportDxf_Click"  Background="#1B5E20" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"
                               Foreground="#90CAF9" FontSize="10" TextWrapping="Wrap"
                               Text="⚠ Patlat işlemi yalnızca bir kez yapılmalıdır."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Kapat" Click="Close_Click" Background="#444" Width="80" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
