<Window x:Class="Afney.Cad.Presentation.Dialogs.DefineBuildingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏢 Floor Manager &amp; Stacking - AfneyCAD Engine" Height="500" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#252526" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel LastChildFill="True" Margin="0,0,0,15">
            <TextBlock Text="BUILDING ASSEMBLY ENGINE (FineSANI Methodology)" FontSize="18" FontWeight="Bold" Foreground="#FFE64D"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="MASTER ORIGIN:" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,10,0"/>
                <Border Background="#3E3E42" Padding="8,3" CornerRadius="3">
                    <TextBlock Text="(0, 0, 0)" FontWeight="Bold" Foreground="LimeGreen"/>
                </Border>
                <Button Content="Change" Foreground="Cyan" Background="Transparent" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Kat Listesi Başlığı -->
        <TextBlock Grid.Row="1" Text="FLOOR LEVELS &amp; MEP INTEGRATION" FontWeight="Bold" Foreground="#888" Margin="0,0,0,5"/>

        <!-- Kat Listesi (DataGrid) -->
        <DataGrid x:Name="LevelsGrid" Grid.Row="2" Background="#1E1E1E" Foreground="White" BorderBrush="#3E3E42"
                  AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding FloorNumber}" Width="30"/>
                <DataGridTextColumn Header="Floor Name" Binding="{Binding LevelName}" Width="120"/>
                <DataGridTextColumn Header="Elevation (m)" Binding="{Binding Elevation}" Width="90"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source File" Binding="{Binding BlockName}" Width="*"/>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="WBLOCK" Click="WBlock_Click" Width="60" Height="22" FontSize="9" Background="#3E3E42" Foreground="White" Margin="0,0,5,0"/>
                                <Button Content="EDIT" Click="EditLevel_Click" Width="60" Height="22" FontSize="9" Background="#007ACC" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stacking Options -->
        <Border Grid.Row="3" Background="#2D2D30" Padding="10" Margin="0,15,0,0" BorderBrush="#3E3E42" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox Content="Same Base Point (0,0,0)" IsChecked="True" Foreground="#DDD" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <CheckBox Content="Auto Align Risers (XY)" IsChecked="True" Foreground="#DDD" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <CheckBox Content="Detect MEP Conflicts" IsChecked="True" Foreground="#DDD" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <CheckBox Content="Recalculate Systems" IsChecked="True" Foreground="#DDD" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Smart Feedback Panel -->
        <Border Grid.Row="4" Background="#1A1A1A" Margin="0,10,0,0" Padding="10" CornerRadius="4">
            <StackPanel x:Name="FeedbackPanel">
                <TextBlock Text="SMART ENGINE FEEDBACK:" FontWeight="Bold" FontSize="11" Foreground="#FF5555" Margin="0,0,0,3"/>
                <TextBlock x:Name="FeedbackText" Text="• All floors aligned to Master Origin. Ready for 3D stacking." Foreground="#AAA" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="5" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="AddFloorBtn" Content="ADD FLOOR" Click="AddFloor_Click" Width="100" Background="#3E3E42" Foreground="White" BorderThickness="0" Padding="10,5"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="PREVIEW 3D" Click="Show3D_Click" Width="110" Background="#5D1F1F" Foreground="#FF9999" BorderBrush="#FF4444" BorderThickness="1" Margin="0,0,10,0"/>
                <Button Content="STACK FLOORS (BIM)" Click="Stack_Click" Width="160" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="CANCEL" Click="Cancel_Click" Width="80" Background="#3E3E42" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
