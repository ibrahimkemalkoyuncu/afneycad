<Window x:Class="Afney.Cad.Presentation.Dialogs.DwgImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG/DXF İçeri Aktar — AfneyCAD" Height="560" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C24" Foreground="#E1E4EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Text="DWG / DXF İÇERİ AKTAR" FontSize="16" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,0,14"/>

        <!-- Dosya Seçimi -->
        <GroupBox Grid.Row="1" Header="Dosya" Foreground="#7AA0CC" BorderBrush="#252836" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFilePath" Height="28" IsReadOnly="True"
                         Background="#12141A" Foreground="#D4D6E8" BorderBrush="#252836"
                         FontFamily="Consolas" FontSize="12" Padding="6,0" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Gözat..." Click="OnBrowse_Click" Width="80" Height="28"
                        Background="#24273A" Foreground="#D4D6E8" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" FontSize="12"/>
                <Button Grid.Column="2" Content="Analiz Et" Click="OnAnalyze_Click" Width="90" Height="28"
                        Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="8,0,0,0" FontSize="12"
                        x:Name="BtnAnalyze" IsEnabled="False"/>
            </Grid>
        </GroupBox>

        <!-- İstatistikler + Seçenekler -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Dosya İstatistikleri -->
            <GroupBox Header="Dosya Bilgileri" Foreground="#7AA0CC" BorderBrush="#252836" Padding="8" Margin="0,0,4,0">
                <StackPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="Format:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtFormat" Foreground="#D4D6E8" FontFamily="Consolas" FontWeight="Bold"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="Boyut:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtFileSize" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="Versiyon:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtVersion" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <Separator Background="#252836" Margin="0,6"/>
                    <DockPanel Margin="0,3"><TextBlock Text="Entity Sayısı:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtEntityCount" Foreground="#2ECC71" FontFamily="Consolas" FontWeight="Bold" FontSize="14"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="Katman Sayısı:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtLayerCount" Foreground="#0A84FF" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="Blok Sayısı:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtBlockCount" Foreground="#F39C12" FontFamily="Consolas"/></DockPanel>
                    <Separator Background="#252836" Margin="0,6"/>
                    <TextBlock Text="Entity Dağılımı:" Foreground="#7AA0CC" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,2"><TextBlock Text="  Çizgi:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtLines" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Daire/Yay:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtArcs" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Polyline:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtPolylines" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Metin:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtTexts" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Blok Ref:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtInserts" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Hatch:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtHatches" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="  Diğer:" Foreground="#858899" Width="90"/><TextBlock x:Name="TxtOther" Foreground="#D4D6E8" FontFamily="Consolas"/></DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- Import Seçenekleri -->
            <GroupBox Grid.Column="1" Header="Import Seçenekleri" Foreground="#7AA0CC" BorderBrush="#252836" Padding="8" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="Ölçek Dönüşümü:" Foreground="#858899" FontSize="11" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbAutoScale" Content="Otomatik Algıla" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4" GroupName="Scale"/>
                    <RadioButton x:Name="RbMetre" Content="Metre (ölçekleme yok)" Foreground="#D4D6E8" Margin="0,0,0,4" GroupName="Scale"/>
                    <RadioButton x:Name="RbMilimetre" Content="Milimetre (×0.001)" Foreground="#D4D6E8" Margin="0,0,0,4" GroupName="Scale"/>
                    <RadioButton x:Name="RbSantimetre" Content="Santimetre (×0.01)" Foreground="#D4D6E8" Margin="0,0,0,4" GroupName="Scale"/>

                    <Separator Background="#252836" Margin="0,8"/>
                    <TextBlock Text="Temizleme:" Foreground="#858899" FontSize="11" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkFlattenZ" Content="Z koordinatlarını sıfırla (2D)" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkRemoveOutliers" Content="Aşırı uzak nesneleri kaldır" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkRemoveShortLines" Content="Çok kısa çizgileri kaldır (&lt;0.01)" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkExplodeBlocks" Content="Blokları patlat (explode)" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>

                    <Separator Background="#252836" Margin="0,8"/>
                    <TextBlock Text="Katmanlar:" Foreground="#858899" FontSize="11" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkImportAllLayers" Content="Tüm katmanları import et" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkPreserveColors" Content="Orijinal renkleri koru (ACI)" Foreground="#D4D6E8" IsChecked="True" Margin="0,0,0,4"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Katman Listesi -->
        <GroupBox Grid.Row="3" Header="Katmanlar" Foreground="#7AA0CC" BorderBrush="#252836" Padding="4" Margin="0,8,0,0" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="LayerCheckList" Orientation="Horizontal"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Progress -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="ImportProgress" Height="6" Background="#12141A" Foreground="#0A84FF"
                         BorderThickness="0" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtProgress" Text="" Foreground="#6B6F88" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </Grid>

        <!-- Butonlar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" Text="" Foreground="#2ECC71" VerticalAlignment="Center" FontSize="11" Margin="0,0,16,0"/>
            <Button Content="İçeri Aktar" Click="OnImport_Click" Width="110" Height="34"
                    Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                    x:Name="BtnImport" IsEnabled="False"/>
            <Button Content="İptal" IsCancel="True" Width="80" Height="34"
                    Background="#24273A" Foreground="#858899" BorderThickness="0" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
