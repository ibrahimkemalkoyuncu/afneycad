<Window x:Class="Afney.Cad.Presentation.Dialogs.WBlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mimari Kat Hazırla (WBlock)" Height="480" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White" AllowsTransparency="False" WindowStyle="ThreeDBorderWindow">
    
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Base Point -->
            <RowDefinition Height="Auto"/> <!-- Entities -->
            <RowDefinition Height="*"/>    <!-- File Path -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="MİMARİ KAT HAZIRLAMA" FontSize="18" FontWeight="Bold" Foreground="Orange"/>
            <TextBlock Text="Kat planlarını üst üste binmesi için ortak bir nokta seçin." FontSize="11" Foreground="Gray"/>
        </StackPanel>

        <!-- TUTMA NOKTASI -->
        <GroupBox Header="Tutma Noktası (Base Point)" Grid.Row="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="PickPointBtn" Click="SelectPoint_Click" Width="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Margin="0,0,5,0"/>
                            <TextBlock Text="Nokta Seç"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PointStatusText" Text="Koordinat: Seçilmedi" Foreground="Cyan" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="2">
                        <TextBlock Text="X:" Foreground="Gray" FontSize="10"/>
                        <TextBox x:Name="TxtX" Text="0.00" IsReadOnly="True" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="2">
                        <TextBlock Text="Y:" Foreground="Gray" FontSize="10"/>
                        <TextBox x:Name="TxtY" Text="0.00" IsReadOnly="True" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="2">
                        <TextBlock Text="Z:" Foreground="Gray" FontSize="10"/>
                        <TextBox x:Name="TxtZ" Text="0.00" IsReadOnly="True" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="3"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- NESNE SEÇİMİ -->
        <GroupBox Header="Nesneler" Grid.Row="2">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="PickEntitiesBtn" Click="SelectEntities_Click" Width="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" Margin="0,0,5,0"/>
                            <TextBlock Text="Nesne Seç"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SelectionStatusText" Text="0 nesne seçildi" Foreground="Orange" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                   <RadioButton x:Name="RadioRetain" Content="Koru" IsChecked="True" Foreground="#AAA" Margin="0,0,15,0"/>
                   <RadioButton x:Name="RadioBlock" Content="Bloğa Çevir" Foreground="#AAA" Margin="0,0,15,0"/>
                   <RadioButton x:Name="RadioDelete" Content="Çizimden Sil" Foreground="#AAA"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- DOSYA ADI VE YOLU -->
        <GroupBox Header="Dosya Adı ve Yolu" Grid.Row="3">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" Grid.Column="0" Background="#2D2D2D" Foreground="White" BorderBrush="Cyan" BorderThickness="1" Padding="5" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="..." Width="40" Margin="5,0,0,0" Click="Browse_Click" VerticalAlignment="Stretch"/>
                </Grid>
                <TextBlock Text="Örn: ZEMINKAT, 1.KAT vb." FontSize="10" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- ACTIONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="TAMAM" Click="Save_Click" IsDefault="True" Width="100" Height="35" Background="Orange" Foreground="Black" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="İPTAL" IsCancel="True" Width="100" Height="35" Background="#333" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
