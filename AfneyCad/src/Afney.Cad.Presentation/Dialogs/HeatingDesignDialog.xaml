<Window x:Class="Afney.Cad.Presentation.Dialogs.HeatingDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔥 Isıtma Tesisat Tasarımı — TS 825 / TS EN 12831" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#5D1A00" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔥 Isıtma Tesisat Tasarımı" FontSize="15" FontWeight="Bold" Foreground="#FFCC80"/>
                <TextBlock Text="  TS 825 Isı Kaybı · TS EN 12831 Radyatör · Kazan Seçimi" FontSize="10" Foreground="#FF9966" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt butonlar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="🔥 Hesapla" Width="100" Margin="0,0,8,0" Click="Calculate_Click" Background="#BF360C"/>
                <Button Grid.Column="2" Content="📄 PDF Rapor" Width="100" Margin="0,0,8,0" Click="ExportPdf_Click" Background="#1B5E20"/>
                <Button Grid.Column="3" Content="📊 Excel" Width="80" Margin="0,0,8,0" Click="ExportExcel_Click" Background="#1B5E20"/>
                <Button Grid.Column="4" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <TabControl Background="#252535" BorderThickness="0">

            <!-- ───── SEKME 1: SİSTEM PARAMETRELERİ ───── -->
            <TabItem Header="⚙️ Sistem Parametreleri">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <!-- Sol: Dış Koşullar -->
                            <Border Grid.Column="0" Background="#1B2B3B" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="DIŞ TASARIM KOŞULLARI" Foreground="#FFCC80" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Şehir:" Margin="0,3"/>
                                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CboCity" Margin="0,3" SelectionChanged="City_Changed"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dış Tasarım Sıcaklığı (°C):" Margin="0,4,0,0"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtOutdoorTemp" Text="-12" Margin="0,4,0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="İklim Bölgesi:" Margin="0,4,0,0"/>
                                        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CboClimate" Margin="0,4,0,2">
                                            <ComboBoxItem Content="1. Bölge (Ege/Akdeniz)" IsSelected="True"/>
                                            <ComboBoxItem Content="2. Bölge (Karadeniz/İç Ege)"/>
                                            <ComboBoxItem Content="3. Bölge (İç Anadolu)"/>
                                            <ComboBoxItem Content="4. Bölge (Doğu Anadolu)"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sağ: Sistem Koşulları -->
                            <Border Grid.Column="2" Background="#1B2B3B" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ISITMA SİSTEMİ PARAMETRELERİ" Foreground="#FFCC80" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gidiş Sıcaklığı (°C):" Margin="0,3"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtSupplyTemp" Text="80" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dönüş Sıcaklığı (°C):" Margin="0,4,0,0"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtReturnTemp" Text="60" Margin="0,4,0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Güvenlik Katsayısı:" Margin="0,4,0,0"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtSafety" Text="1.2" Margin="0,4,0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sistem Tipi:" Margin="0,4,0,0"/>
                                        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CboSystemType" Margin="0,4,0,2">
                                            <ComboBoxItem Content="Çift Borulu — Paralel" IsSelected="True"/>
                                            <ComboBoxItem Content="Çift Borulu — Tik-Tak"/>
                                            <ComboBoxItem Content="Tek Borulu"/>
                                            <ComboBoxItem Content="Yerden Isıtma (55/45°C)"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───── SEKME 2: ODA TANIMLAMA ───── -->
            <TabItem Header="🏠 Oda Tanımlama">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="+ Oda Ekle" Width="90" Click="AddRoom_Click" Background="#BF360C" Margin="0,0,4,0"/>
                        <Button Content="Sil" Width="60" Click="DeleteRoom_Click" Background="#8B3A3A" Margin="0,0,4,0"/>
                        <Button Content="📋 Şablon" Width="90" Click="AddTemplate_Click" Background="#455A64" Margin="0,0,4,0" ToolTip="Standart konut şablonu ekle"/>
                        <ComboBox x:Name="CboRoomType" Width="160" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="RoomGrid" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Oda Adı"       Binding="{Binding Name}"            Width="110"/>
                            <DataGridTextColumn Header="Alan (m²)"     Binding="{Binding FloorAreaM2}"     Width="70"/>
                            <DataGridTextColumn Header="Yükseklik (m)" Binding="{Binding HeightM}"         Width="80"/>
                            <DataGridTextColumn Header="İç T (°C)"     Binding="{Binding DesignTempC}"     Width="65"/>
                            <DataGridTextColumn Header="Dış Duvar (m²)" Binding="{Binding ExternalWallM2}" Width="90"/>
                            <DataGridTextColumn Header="Pencere (m²)"  Binding="{Binding WindowM2}"        Width="80"/>
                            <DataGridTextColumn Header="Çatı (m²)"     Binding="{Binding ExternalRoofM2}"  Width="70"/>
                            <DataGridTextColumn Header="U_Duvar"       Binding="{Binding UWall}"           Width="65"/>
                            <DataGridTextColumn Header="U_Pencere"     Binding="{Binding UWindow}"         Width="70"/>
                            <DataGridTextColumn Header="Hav. (n/h)"    Binding="{Binding AirChangesPerHour}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ───── SEKME 3: HESAP SONUÇLARI ───── -->
            <TabItem Header="📊 Hesap Sonuçları">
                <DockPanel Margin="8">
                    <!-- Özet -->
                    <Border DockPanel.Dock="Top" Background="#5D1A00" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResTotalKw" Text="—" FontSize="22" FontWeight="Bold" Foreground="#FFCC80" HorizontalAlignment="Center"/>
                                <TextBlock Text="Toplam (kW)" Foreground="#FF9966" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResBoilerKw" Text="—" FontSize="22" FontWeight="Bold" Foreground="#FFA040" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kazan (kW)" Foreground="#FF9966" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResFlowM3h" Text="—" FontSize="18" FontWeight="Bold" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sistem Debisi (m³/h)" Foreground="#7799BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResWarnings" Text="—" FontSize="18" FontWeight="Bold" Foreground="#FF6666" HorizontalAlignment="Center"/>
                                <TextBlock Text="Uyarı" Foreground="#FF9966" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Oda sonuçları tablosu -->
                    <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" DockPanel.Dock="Top" Height="300" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Oda"            Binding="{Binding Room.Name}"              Width="110"/>
                            <DataGridTextColumn Header="İletim (W)"     Binding="{Binding TransmissionLossW, StringFormat=F0}" Width="80"/>
                            <DataGridTextColumn Header="Hav. (W)"       Binding="{Binding VentilationLossW, StringFormat=F0}"  Width="70"/>
                            <DataGridTextColumn Header="Toplam (W)"     Binding="{Binding TotalHeatLossW, StringFormat=F0}"    Width="80"/>
                            <DataGridTextColumn Header="Toplam (kW)"    Binding="{Binding TotalHeatLossKw, StringFormat=F3}"   Width="80"/>
                            <DataGridTextColumn Header="Radyatör"       Binding="{Binding Radiator.Model}"         Width="*"/>
                            <DataGridTextColumn Header="Debi (m³/h)"    Binding="{Binding RequiredFlowM3h, StringFormat=F4}"   Width="80"/>
                            <DataGridTextColumn Header="DN (mm)"        Binding="{Binding RecommendedDN, StringFormat=F0}"     Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Kazan ve pompa önerisi -->
                    <Border Background="#1B2B3B" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Önerilen Kazan:" Foreground="#FFCC80" FontWeight="Bold" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResBoilerModel" Text="—" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Önerilen Pompa:" Foreground="#90CAF9" FontWeight="Bold" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResPumpModel" Text="—" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Uyarılar:" Foreground="#FF9966" FontWeight="Bold" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResWarningText" Text="—" Foreground="#FFAA44" Margin="0,3" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
