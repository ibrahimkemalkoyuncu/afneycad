<Window x:Class="Afney.Cad.Presentation.Dialogs.ExpansionTankDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♻ Genleşme Tankı — TS EN 13831" Height="460" Width="540"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="♻ Genleşme Tankı Hesabı" FontSize="14" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  TS EN 13831 / TS EN 12828" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="⚙️ Hesapla" Width="100" Margin="0,0,8,0" Click="Calculate_Click" Background="#1B5E20"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- Sol: Giriş -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="GİRİŞ PARAMETRELERİ" Foreground="#90CAF9" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sistem Hacmi (L):"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtVolume" Text="100" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dolum Sıcaklığı (°C):" Margin="0,4,0,0"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtTCold" Text="10" Margin="0,4,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Maks. Sıcaklık (°C):" Margin="0,4,0,0"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtTHot" Text="80" Margin="0,4,0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Statik Yükseklik (m):" Margin="0,4,0,0"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtHead" Text="5" Margin="0,4,0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Emniyet Valfi (bar):" Margin="0,4,0,0"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtPmax" Text="3" Margin="0,4,0,2"/>
                </Grid>
            </StackPanel>
            <!-- Sağ: Sonuçlar -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="HESAP SONUÇLARI" Foreground="#90CAF9" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Δv (özgül hacim):" Foreground="#90CAF9" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResD" Text="—" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Genleşme Hac. (L):" Foreground="#90CAF9" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResVe" Text="—" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ön Şarj Basıncı:" Foreground="#90CAF9" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResPre" Text="—" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Min. Tank Hacmi:" Foreground="#FFA040" Margin="0,3" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResTank" Text="—" Margin="0,3" FontWeight="Bold" Foreground="#FFA040"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Önerilen Tank:" Foreground="#90CAF9" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ResModel" Text="—" Margin="0,3" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
