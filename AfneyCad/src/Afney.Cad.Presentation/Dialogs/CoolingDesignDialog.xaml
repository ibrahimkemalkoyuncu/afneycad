<Window x:Class="Afney.Cad.Presentation.Dialogs.CoolingDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="❄️ Soğutma Yük Hesabı — ASHRAE / TS EN 12831-3" Height="720" Width="980"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0D47A1"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#003060" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="❄️ Soğutma Yük Hesabı" FontSize="15" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  ASHRAE HOF · TS EN 12831-3 · Güneş Kazancı · İç Yükler · Chiller / VRF Seçimi"
                           FontSize="10" Foreground="#5599BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt butonlar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AACC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="❄️ Hesapla" Width="100" Margin="0,0,8,0" Click="Calculate_Click" Background="#0277BD"/>
                <Button Grid.Column="2" Content="📄 HTML Rapor" Width="100" Margin="0,0,8,0" Click="ExportHtml_Click" Background="#1B5E20"/>
                <Button Grid.Column="3" Content="📊 Excel" Width="80" Margin="0,0,8,0" Click="ExportExcel_Click" Background="#1B5E20"/>
                <Button Grid.Column="4" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <TabControl Background="#252535" BorderThickness="0">

            <!-- ───── SEKME 1: SİSTEM PARAMETRELERİ ───── -->
            <TabItem Header="⚙️ Sistem Parametreleri">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <!-- Sol: Dış Yaz Koşulları -->
                            <Border Grid.Column="0" Background="#0A2040" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="DIŞ YAZ TASARIM KOŞULLARI" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Şehir:" Margin="0,4"/>
                                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CboCity" Margin="0,4" SelectionChanged="City_Changed"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kuru Termometre (°C):" Margin="0,4"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtOutdoorDB" Text="34" Margin="0,4"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Yaş Termometre (°C):" Margin="0,4"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtOutdoorWB" Text="24" Margin="0,4"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pik Saat:" Margin="0,4"/>
                                        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CboPeakHour" Margin="0,4" SelectedIndex="3">
                                            <ComboBoxItem Content="12:00"/>
                                            <ComboBoxItem Content="13:00"/>
                                            <ComboBoxItem Content="14:00"/>
                                            <ComboBoxItem Content="15:00" IsSelected="True"/>
                                            <ComboBoxItem Content="16:00"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sağ: İç Koşullar -->
                            <Border Grid.Column="2" Background="#0A2040" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="İÇ TASARIM KOŞULLARI" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="İç Sıcaklık (°C):" Margin="0,4"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtIndoorTemp" Text="24" Margin="0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bağıl Nem (%):" Margin="0,4"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtIndoorRH" Text="50" Margin="0,4"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Güvenlik Katsayısı:" Margin="0,4"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtSafety" Text="1.15" Margin="0,4"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sistem Tipi:" Margin="0,4"/>
                                        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CboSystemType" Margin="0,4">
                                            <ComboBoxItem Content="VRF Sistemi" IsSelected="True"/>
                                            <ComboBoxItem Content="Hava Soğutmalı Chiller"/>
                                            <ComboBoxItem Content="Su Soğutmalı Chiller"/>
                                            <ComboBoxItem Content="Paket Klima Ünitesi"/>
                                            <ComboBoxItem Content="Monosplit / Multisplit"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bilgi kutusu -->
                        <Border Background="#0A2B0A" CornerRadius="4" Padding="10,6">
                            <TextBlock Foreground="#88BB88" TextWrapping="Wrap" FontSize="11">
                                <Run FontWeight="Bold">Standart:</Run>
                                <Run Text=" ASHRAE Handbook of Fundamentals (HOF) 2021 · TS EN 12831-3:2017 · Türkiye Yaz Tasarım Verileri"/>
                                <Run Text=" | İletim: CLTD yöntemi · Güneş: SHGC × I_solar × yön katsayısı · Gizil yük: Δw özgül nem farkı modeli"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───── SEKME 2: BÖLGE TANIMLAMA ───── -->
            <TabItem Header="🏢 Bölge Tanımlama">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" FlowDirection="LeftToRight">
                        <Button Content="+ Bölge Ekle" Width="100" Click="AddZone_Click" Background="#0277BD" Margin="0,0,4,0"/>
                        <Button Content="Sil" Width="60" Click="DeleteZone_Click" Background="#333" Margin="0,0,4,0"/>
                        <Button Content="📋 Ofis Şablonu" Width="110" Click="AddOfficeTemplate_Click" Background="#455A64" Margin="0,0,4,0"/>
                        <Button Content="📋 Konut Şablonu" Width="120" Click="AddResidentialTemplate_Click" Background="#455A64" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CboZoneType" Width="160" Margin="4,0" SelectionChanged="ZoneType_Changed"/>
                    </StackPanel>

                    <DataGrid x:Name="ZoneGrid" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bölge Adı"       Binding="{Binding Name}"              Width="110"/>
                            <DataGridTextColumn Header="Alan (m²)"       Binding="{Binding FloorAreaM2}"       Width="65"/>
                            <DataGridTextColumn Header="H (m)"           Binding="{Binding HeightM}"           Width="50"/>
                            <DataGridTextColumn Header="Dış Duvar (m²)"  Binding="{Binding ExternalWallM2}"    Width="90"/>
                            <DataGridTextColumn Header="Pencere (m²)"    Binding="{Binding WindowM2}"          Width="80"/>
                            <DataGridTextColumn Header="Çatı (m²)"       Binding="{Binding RoofM2}"            Width="65"/>
                            <DataGridTextColumn Header="SHGC"            Binding="{Binding SHGC}"              Width="55"/>
                            <DataGridTextColumn Header="Kişi"            Binding="{Binding OccupantCount}"     Width="45"/>
                            <DataGridTextColumn Header="Ayd. W/m²"       Binding="{Binding LightingWperm2}"    Width="70"/>
                            <DataGridTextColumn Header="Ekip. W/m²"      Binding="{Binding EquipmentWperm2}"   Width="75"/>
                            <DataGridTextColumn Header="Hav. n/h"        Binding="{Binding AirChangesPerHour}" Width="65"/>
                            <DataGridCheckBoxColumn Header="Gölge"       Binding="{Binding HasShading}"        Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ───── SEKME 3: HESAP SONUÇLARI ───── -->
            <TabItem Header="📊 Hesap Sonuçları">
                <DockPanel Margin="8">
                    <!-- Özet panel -->
                    <Border DockPanel.Dock="Top" Background="#003060" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResTotalKw" Text="—" FontSize="20" FontWeight="Bold" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                <TextBlock Text="Toplam (kW)" Foreground="#5599BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResTotalTR" Text="—" FontSize="20" FontWeight="Bold" Foreground="#7ECFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Toplam (TR)" Foreground="#5599BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResChillerKw" Text="—" FontSize="20" FontWeight="Bold" Foreground="#FFD740" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chiller Kapasitesi" Foreground="#5599BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResSHR" Text="—" FontSize="18" FontWeight="Bold" Foreground="#A5D6A7" HorizontalAlignment="Center"/>
                                <TextBlock Text="SHR (Duyulur Oran)" Foreground="#5599BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResWarnings" Text="—" FontSize="18" FontWeight="Bold" Foreground="#FF6666" HorizontalAlignment="Center"/>
                                <TextBlock Text="Uyarı" Foreground="#5599BB" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bölge sonuçları -->
                    <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" DockPanel.Dock="Top" Height="280" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bölge"          Binding="{Binding Zone.Name}"                               Width="100"/>
                            <DataGridTextColumn Header="İletim (W)"     Binding="{Binding TransmissionGainW, StringFormat=F0}"      Width="75"/>
                            <DataGridTextColumn Header="Güneş (W)"      Binding="{Binding SolarGainW, StringFormat=F0}"             Width="70"/>
                            <DataGridTextColumn Header="İç Duy. (W)"    Binding="{Binding InternalSensibleW, StringFormat=F0}"      Width="75"/>
                            <DataGridTextColumn Header="İç Gizil (W)"   Binding="{Binding InternalLatentW, StringFormat=F0}"        Width="75"/>
                            <DataGridTextColumn Header="Hav. Duy. (W)"  Binding="{Binding VentilationSensibleW, StringFormat=F0}"   Width="80"/>
                            <DataGridTextColumn Header="Top. Duy. (W)"  Binding="{Binding TotalSensibleW, StringFormat=F0}"         Width="80"/>
                            <DataGridTextColumn Header="Top. Yük (kW)"  Binding="{Binding TotalCoolingKw, StringFormat=F2}"         Width="80"/>
                            <DataGridTextColumn Header="(TR)"           Binding="{Binding TotalCoolingTR, StringFormat=F2}"         Width="60"/>
                            <DataGridTextColumn Header="Önerilen Ünite" Binding="{Binding RecommendedUnit}"                         Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Chiller önerisi -->
                    <Border Background="#0A2040" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Önerilen Soğutma Grubu:" Foreground="#90CAF9" FontWeight="Bold" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResChillerModel" Text="—" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Duyulur / Gizil (kW):" Foreground="#FFD740" FontWeight="Bold" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResSensLat" Text="—" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Uyarılar:" Foreground="#FF9966" FontWeight="Bold" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResWarningText" Text="—" Foreground="#FFAA44" Margin="0,4" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
