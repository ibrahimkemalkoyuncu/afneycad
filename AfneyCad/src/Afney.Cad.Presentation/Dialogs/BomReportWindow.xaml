<Window x:Class="Afney.Cad.Presentation.Dialogs.BomReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metraj (BOM) Raporu" Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Proje Metraj Listesi" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <DataGrid x:Name="BomGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="#2D2D30" Foreground="White"
                  AlternatingRowBackground="#3F3F46" RowBackground="#2D2D30"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#555555" VerticalGridLinesBrush="#555555"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#555555">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="#555555" />
                    <Setter Property="Padding" Value="5" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="120" />
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Malzeme Tipi" Binding="{Binding Material}" Width="120" />
                <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="80" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="CSV Olarak Dışa Aktar" Width="140" Height="26" Margin="0,0,10,0" x:Name="BtnExportCsv" Click="BtnExportCsv_Click"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Kapat" Width="80" Height="26" x:Name="BtnClose" Click="BtnClose_Click"
                    Background="#3F3F46" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
