<Window x:Class="Afney.Cad.Presentation.Dialogs.ViewportCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Çizimi — AfneyCAD"
        Height="440" Width="480" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="EKRAN ÇİZİMİ" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Seçili katı bağımsız blok olarak kaydet" FontSize="10" Foreground="#90CAF9"/>
            </StackPanel>
        </Border>

        <!-- İçerik -->
        <StackPanel Grid.Row="1" Margin="14">

            <!-- Dosya Adı -->
            <GroupBox Header="Blok Adı (benzersiz)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ad:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox   Grid.Column="1" x:Name="TxtName" Background="#2A2A3E" Foreground="White"
                               BorderBrush="#555" Padding="6,4" Text="001"
                               ToolTip="Örn: 001, ZEMIN, KAT1 — boşluk kullanmayın"/>
                </Grid>
            </GroupBox>

            <!-- Kat Kapsamı -->
            <GroupBox Header="Kat Kapsamı">
                <StackPanel>
                    <RadioButton x:Name="RbAllFloors" Content="Tüm Çizim (tüm katlar)" IsChecked="True" GroupName="FloorScope"/>
                    <RadioButton x:Name="RbOneFloor"  Content="Belirli Kat:" GroupName="FloorScope"/>
                    <ComboBox x:Name="CmbFloor" IsEnabled="False" Margin="20,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Sistem Filtresi -->
            <GroupBox Header="Sistem Filtresi">
                <StackPanel>
                    <RadioButton x:Name="RbSysAll"   Content="Tümü (Mimari + Temiz Su + Pis Su)" IsChecked="True" GroupName="SysFilter"/>
                    <RadioButton x:Name="RbSysCold"  Content="Yalnızca Temiz Su (CW + HW)" GroupName="SysFilter"/>
                    <RadioButton x:Name="RbSysWaste" Content="Yalnızca Pis Su (WW + RW)"  GroupName="SysFilter"/>
                </StackPanel>
            </GroupBox>

            <!-- Durum -->
            <Border x:Name="StatusBorder" Background="#0A1A0A" CornerRadius="4"
                    Padding="10,8" Visibility="Collapsed" BorderBrush="#2E7D32" BorderThickness="1">
                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="#A5D6A7" FontSize="11"/>
            </Border>
        </StackPanel>

        <!-- Butonlar -->
        <Border Grid.Row="2" Background="#1B1B2E" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Kaydet (Blok Oluştur)" Click="Save_Click"
                        Background="#2E7D32" Margin="0,0,8,0" Width="200"/>
                <Button Content="Kapat" Click="Close_Click" Background="#444" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
