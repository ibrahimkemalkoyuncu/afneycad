<Window x:Class="Afney.Cad.Presentation.Dialogs.AcousticAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔊 HVAC Gürültü Analizi — VDI 2081 / ASHRAE Ch.48" Height="620" Width="860"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A148C"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#2E1146" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.VolumeHigh}" Fill="#CE93D8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="HVAC Gürültü Analizi" FontSize="15" FontWeight="Bold" Foreground="#CE93D8"/>
                <TextBlock Text="  Fan · Kanal · Dallanma · Dirsek · Susturucu · Terminal (VDI 2081 / ASHRAE Ch.48)" FontSize="10" Foreground="#AB47BC" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Click="Calculate_Click" Background="#4A148C" Width="100" Margin="0,0,8,0" Content="Hesapla"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="#1B2B3B" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="FAN VE KANAL" FontSize="10" Foreground="#CE93D8" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Debi (m³/h):" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtAirFlow" Text="1000" Width="60"/>
                        <TextBlock Text="  Fan Basıncı (Pa):" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtFanPressure" Text="400" Width="60"/>
                        <TextBlock Text="  Fan Verimi (0-1):" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtFanEff" Text="0.7" Width="50"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kanal Genişliği (mm):" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtDuctWidth" Text="400" Width="60"/>
                        <TextBlock Text="  Kanal Uzunluğu (m):" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtDuctLength" Text="10" Width="50"/>
                        <CheckBox x:Name="ChkDuctLined" Content="Akustik Kaplı" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#1B2B3B" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="DALLANMA / DİRSEK / SUSTURUCU / TERMİNAL" FontSize="10" Foreground="#CE93D8" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dallanma Sayısı:" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtBranchCount" Text="2" Width="40"/>
                        <TextBlock Text="  Dirsek Sayısı:" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtElbowCount" Text="3" Width="40"/>
                        <TextBlock Text="  Susturucu Ek Kaybı (dB):" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtSilencerLoss" Text="0" Width="50"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Terminal Hızı (m/s):" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtTerminalVel" Text="3.0" Width="50"/>
                        <TextBlock Text="  Oda Hacmi (m³):" Margin="12,0,8,0"/>
                        <TextBox x:Name="TxtRoomVolume" Text="50" Width="55"/>
                        <TextBlock Text="  Oda Tipi:" Margin="12,0,8,0"/>
                        <ComboBox x:Name="CboRoomType" Width="160">
                            <ComboBoxItem Content="Yatak Odası"/>
                            <ComboBoxItem Content="Oturma Odası"/>
                            <ComboBoxItem Content="Ofis (Özel)" IsSelected="True"/>
                            <ComboBoxItem Content="Ofis (Açık Plan)"/>
                            <ComboBoxItem Content="Toplantı Odası"/>
                            <ComboBoxItem Content="Restoran"/>
                            <ComboBoxItem Content="Sınıf"/>
                            <ComboBoxItem Content="Kütüphane"/>
                            <ComboBoxItem Content="Hastane (Oda)"/>
                            <ComboBoxItem Content="Ameliyathane"/>
                            <ComboBoxItem Content="Konser Salonu"/>
                            <ComboBoxItem Content="Sinema"/>
                            <ComboBoxItem Content="Spor Salonu"/>
                            <ComboBoxItem Content="Endüstri"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#2E1146" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Text="Henüz hesap yapılmadı." Foreground="#CE93D8" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FAN SES GÜCÜ Lw" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResFanLw" Text="—" FontSize="13" FontWeight="Bold" Foreground="#E1BEE7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="KANAL ZAYIFLAMASI" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResDuctAtt" Text="—" FontSize="13" FontWeight="Bold" Foreground="#E1BEE7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TERMİNAL Lw" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResTerminalLw" Text="—" FontSize="13" FontWeight="Bold" Foreground="#E1BEE7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ODA DÜZELTMESİ" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResRoomCorr" Text="—" FontSize="13" FontWeight="Bold" Foreground="#E1BEE7"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ODA SES BASINCI Lp" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResRoomLp" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFD740"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NR SINIRI / DURUM" FontSize="9" Foreground="#888"/>
                            <TextBlock x:Name="ResNrStatus" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FFD740"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ResRecommendation" Text="" FontSize="12" Foreground="#A5D6A7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
