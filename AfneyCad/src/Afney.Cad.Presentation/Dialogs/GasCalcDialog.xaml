<Window x:Class="Afney.Cad.Presentation.Dialogs.GasCalcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doğalgaz Tesisat Hesabı — TS EN 1775 / TS 7363"
        Height="700" Width="1100" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="IsReadOnly" Value="False"/><Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/><Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="12,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔥 Doğalgaz Tesisat Hesabı" FontSize="15" FontWeight="Bold" Foreground="#FFB74D"/>
                <TextBlock Text="  TS EN 1775 / TS 7363  —  Düşük Basınç Sistemi" FontSize="11" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt buton çubuğu -->
        <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Hazır" Foreground="#99BBDD" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="HTML Rapor" Width="100" Margin="6,0,0,0" Click="ExportHtml_Click" Background="#1B5E20"/>
                <Button Grid.Column="2" Content="Hesapla" Width="90" Margin="6,0,0,0" Click="Calculate_Click"/>
                <Button Grid.Column="3" Content="Kapat"   Width="80" Margin="6,0,0,0" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <!-- Ana içerik: Sol (giriş) + Sağ (sonuç) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Parametreler + Cihazlar + Segmentler -->
            <DockPanel Grid.Column="0">
                <!-- Parametreler -->
                <GroupBox DockPanel.Dock="Top" Header="Hesap Parametreleri">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sayaç Çıkış Basıncı (mbar):" Margin="0,2,4,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSupplyP" Text="21"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min. Cihaz Basıncı (mbar):" Margin="0,2,4,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMinP" Text="17"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Maks. Hız (m/s):" Margin="0,2,4,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMaxV" Text="8.0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Gaz Yoğunluğu (kg/m³):" Margin="0,2,4,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDensity" Text="0.72"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Boru Malzemesi:" Margin="0,2,4,2" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbMaterial">
                            <ComboBoxItem Content="Çelik" IsSelected="True"/>
                            <ComboBoxItem Content="Bakır"/>
                            <ComboBoxItem Content="PE"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Cihaz Listesi -->
                <GroupBox DockPanel.Dock="Top" Header="Gaz Cihazları">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="+ Ekle" Width="70" Click="AddDevice_Click" Background="#1B5E20"/>
                            <Button Content="Sil"    Width="60" Margin="6,0,0,0" Click="RemoveDevice_Click" Background="#B71C1C"/>
                        </StackPanel>
                        <DataGrid x:Name="DeviceGrid" Height="160" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cihaz Adı"   Binding="{Binding Name}"            Width="*"/>
                                <DataGridTextColumn Header="Güç (kW)"    Binding="{Binding NominalPowerKw}"   Width="70"/>
                                <DataGridTextColumn Header="Yük Faktörü" Binding="{Binding LoadFactor}"       Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <!-- Segment Listesi -->
                <GroupBox Header="Hat Segmentleri">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="+ Ekle" Width="70" Click="AddSegment_Click" Background="#1B5E20"/>
                            <Button Content="Sil"    Width="60" Margin="6,0,0,0" Click="RemoveSegment_Click" Background="#B71C1C"/>
                        </StackPanel>
                        <DataGrid x:Name="SegmentGrid" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segment Adı" Binding="{Binding Name}"      Width="*"/>
                                <DataGridTextColumn Header="Uzunluk (m)" Binding="{Binding LengthM}"   Width="80"/>
                                <DataGridTextColumn Header="Cihaz İnd. (0,1,2)" Binding="{Binding DeviceIds}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- Sağ: Hesap Sonuçları -->
            <DockPanel Grid.Column="2">
                <GroupBox Header="Hesap Sonuç Tablosu" DockPanel.Dock="Top" Height="340">
                    <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No"      Binding="{Binding RowNo}"                         Width="35"/>
                            <DataGridTextColumn Header="Segment" Binding="{Binding SegmentName}"                   Width="110"/>
                            <DataGridTextColumn Header="L (m)"   Binding="{Binding LengthM,StringFormat=F2}"       Width="55"/>
                            <DataGridTextColumn Header="L_ekv"   Binding="{Binding EquivLengthM,StringFormat=F2}"  Width="55"/>
                            <DataGridTextColumn Header="Q (m³/h)" Binding="{Binding FlowM3h,StringFormat=F3}"      Width="70"/>
                            <DataGridTextColumn Header="DN (mm)" Binding="{Binding DiameterMm}"                    Width="60"/>
                            <DataGridTextColumn Header="V (m/s)" Binding="{Binding VelocityMs,StringFormat=F2}"    Width="60"/>
                            <DataGridTextColumn Header="ΔP (mbar)" Binding="{Binding PressureDropMbar,StringFormat=F3}" Width="75"/>
                            <DataGridTextColumn Header="P_kalan" Binding="{Binding RemainingPressureMbar,StringFormat=F2}" Width="65"/>
                            <DataGridTextColumn Header="Durum"   Binding="{Binding IsOk}"                         Width="50"/>
                            <DataGridTextColumn Header="Uyarılar" Binding="{Binding Warnings}"                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Özet -->
                <GroupBox Header="Özet &amp; Notlar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelNotes"/>
                    </ScrollViewer>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
