<Window x:Class="Afney.Cad.Presentation.Dialogs.WBlockWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akıllı Kat Hizalama Sihirbazı" Height="450" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White" WindowStyle="ThreeDBorderWindow" AllowsTransparency="False">
    
    <Window.Resources>
        <!-- Modern UI Stilleri -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Progress / Steps -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
            <RowDefinition Height="Auto"/> <!-- Footer / Navigation -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="20,15">
            <StackPanel>
                <TextBlock Text="MİMARİ KAT HİZALAMA SİHİRBAZI" FontSize="20" FontWeight="Bold" Foreground="Orange"/>
                <TextBlock Text="Kat planlarını BIM standartlarında 3D uzaya hatasız aktarma aracı." Foreground="#AAAAAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Step Indicator -->
        <Border Grid.Row="1" Background="#333333" Padding="10,5">
            <TextBlock x:Name="TxtStepIndicator" Text="Adım 1 / 4 • Kat Seçimi" Foreground="Cyan" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="30,20">
            
            <!-- ADIM 1: KAT BİLGİSİ -->
            <StackPanel x:Name="Step1Panel" Visibility="Visible">
                <TextBlock Text="Hangi katı kaydediyorsunuz?" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                <TextBlock Text="Bu adım mimari sınırları hangi isimle kaydedeceğinizi belirler." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>
                
                <TextBlock Text="Kayıt Yolu ve Dosya Adı:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFilePath" Grid.Column="0" Background="#2D2D2D" Foreground="White" BorderBrush="#007ACC" BorderThickness="1" Padding="8" FontSize="14"/>
                    <Button Grid.Column="1" Content="..." Width="40" Margin="5,0,0,0" Click="Browse_Click"/>
                </Grid>
                <TextBlock Text="Örn: C:\Projeler\Kule\BodrumKat.dwg" FontSize="11" Foreground="#888888" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ADIM 2: REFERANS NOKTASI -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="Sabit Referans (Orijin) Noktası" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                <TextBlock Text="Bütün kat planlarında her zaman ortak olan ve değişmeyen bir köşe seçmelisiniz (Örn: Asansör şaftının köşesi veya ana kolon aks kesişimi)." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>
                
                <Button Style="{StaticResource ActionButton}" Content="🎯 Ekranda Referans Noktasını Seç" Click="SelectPoint_Click" Padding="15" Margin="0,10,0,20"/>
                
                <Border Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock x:Name="TxtPointStatus" Text="Henüz nokta seçilmedi." Foreground="Orange" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCoordinates" Text="(X: -, Y: -, Z: -)" Foreground="Cyan" HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ADIM 3: NESNE SEÇİMİ -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <TextBlock Text="Katedilecek Mimari Objeler" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                <TextBlock Text="Plandaki yalnızca bu kata ait olan çizgileri (duvarlar, tefrişler) yeşil pencere içerisine alarak seçin." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>
                
                <Button Style="{StaticResource ActionButton}" Content="📐 Ekranda Çizgileri Seç" Click="SelectEntities_Click" Padding="15" Margin="0,10,0,20"/>

                <Border Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" Padding="15" CornerRadius="5">
                    <TextBlock x:Name="TxtSelectionStatus" Text="0 obje seçildi." Foreground="Orange" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- ADIM 4: TAMAMLA -->
            <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                <TextBlock Text="Aktarım Onayı" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                <TextBlock Text="Seçtiğiniz ayarlar doğrulandı. İşlemi bitirdiğinizde sistem bu katı belirlediğiniz o sıfır noktasına hizalayarak 3D ortama hazırlayacaktır." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>
                
                <Border Background="#2D2D2D" Margin="0,10" Padding="15">
                    <StackPanel>
                        <TextBlock x:Name="SummaryFloor" Text="Kat: -" Foreground="Cyan" Margin="0,0,0,5"/>
                        <TextBlock x:Name="SummaryPoint" Text="Nokta: -" Foreground="Cyan" Margin="0,0,0,5"/>
                        <TextBlock x:Name="SummaryEntities" Text="Nesne Sayısı: -" Foreground="Cyan"/>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="Devam etmek için BİTİR tuşuna basınız." Foreground="Orange" HorizontalAlignment="Center" Margin="0,20,0,0" FontWeight="Bold"/>
            </StackPanel>

        </Grid>

        <!-- Footer / Navigation -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#1C1C1C" BorderThickness="0,1,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnCancel" Grid.Column="0" Content="İptal" Click="Cancel_Click" Width="80"/>
                
                <Button x:Name="BtnBack" Grid.Column="2" Content="&lt; Geri" Click="Back_Click" Width="80" IsEnabled="False"/>
                <Button x:Name="BtnNext" Grid.Column="3" Content="İleri &gt;" Click="Next_Click" Width="100" Background="#007ACC" FontWeight="Bold"/>
                <Button x:Name="BtnFinish" Grid.Column="3" Content="KAYDET VE BİTİR" Click="Finish_Click" Width="130" Background="LimeGreen" Foreground="Black" FontWeight="Bold" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
