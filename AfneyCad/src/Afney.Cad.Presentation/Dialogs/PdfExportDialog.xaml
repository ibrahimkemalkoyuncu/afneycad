<Window x:Class="Afney.Cad.Presentation.Dialogs.PdfExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📄 PDF Rapor Çıktısı — AfneyCAD" Height="500" Width="560"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/><Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.FileDocument}" Fill="#90CAF9" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="PDF Rapor Çıktısı" FontSize="14" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  Antetli · Sistem Özeti · Metraj Cetveli" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="155" Margin="0,0,8,0"
                        Click="Export_Click" Background="#1B5E20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.FileDocument}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="PDF Oluştur ve Aç" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Proje -->
                <GroupBox Header="PROJE BİLGİLERİ">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Proje Adı:"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtProjectName" Text="AfneyCAD Projesi" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Proje No:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtProjeNo" Text="" Margin="0,4,0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Adres / Konum:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtAdres" Text="" Margin="0,4,0,2"/>
                    </Grid>
                </GroupBox>

                <!-- Firma / Mühendis -->
                <GroupBox Header="FİRMA VE MÜHENDİS (Antet)">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Firma Adı:"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtFirma" Text="" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mühendis Adı:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtMuhendis" Text="" Margin="0,4,0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Unvan:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtUnvan" Text="İnş. Müh." Margin="0,4,0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Çizen:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtCizdiren" Text="" Margin="0,4,0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Kontrol Eden:" Margin="0,4,0,0"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtKontrol" Text="" Margin="0,4,0,2"/>
                    </Grid>
                </GroupBox>

                <!-- Logo -->
                <GroupBox Header="ŞİRKET LOGOSU">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox   Grid.Column="0" x:Name="TxtLogoPath" IsReadOnly="True" Margin="0,0,6,0" ToolTip="PNG/JPG antet logosu"/>
                        <Button    Grid.Column="1" Content="Seç..." Width="70" Click="SelectLogo_Click" Margin="0,0,6,0"/>
                        <Button    Grid.Column="2" Content="Temizle" Width="70" Click="ClearLogo_Click"/>
                    </Grid>
                </GroupBox>

                <!-- İçerik -->
                <GroupBox Header="ÇIKTI İÇERİĞİ">
                    <StackPanel>
                        <CheckBox x:Name="ChkSummary" Content="Sistem Özeti (Boru/Vitrifiye/Vana dağılımı)" Foreground="White" IsChecked="True" Margin="0,2"/>
                        <CheckBox x:Name="ChkBoq"     Content="Metraj Cetveli (Poz numaralı)"              Foreground="White" IsChecked="True" Margin="0,2"/>
                        <CheckBox x:Name="ChkTitleBlock" Content="Antet Bloğu (Firma + Mühendis + Revizyon)" Foreground="White" IsChecked="True" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
