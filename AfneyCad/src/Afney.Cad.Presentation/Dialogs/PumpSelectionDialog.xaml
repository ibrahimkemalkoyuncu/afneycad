<Window x:Class="Afney.Cad.Presentation.Dialogs.PumpSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Pompa ve Hidrofor Seçim Modülü — AfneyCAD"
        Height="720" Width="1050" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#005A9C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL PANEL: Girişler + Kavitasyon -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="SİSTEM PARAMETRELERİ" FontWeight="Bold" FontSize="13"
                       Foreground="#AADDFF" Margin="0,0,0,10"/>

            <TextBlock Text="Debi Q (m³/h):" Margin="0,4,0,2"/>
            <TextBox x:Name="TxtFlow" Text="5.0" TextChanged="Inputs_Changed"/>

            <TextBlock Text="Basma Yüksekliği Hm (mSS):" Margin="0,8,0,2"/>
            <TextBox x:Name="TxtHead" Text="25.0" TextChanged="Inputs_Changed"/>

            <TextBlock Text="Statik Yükseklik (mSS):" Margin="0,8,0,2"/>
            <TextBox x:Name="TxtStaticHead" Text="10.0" TextChanged="Inputs_Changed"/>

            <TextBlock Text="Marka Filtresi:" Margin="0,12,0,2"/>
            <ComboBox x:Name="BrandCombo" SelectionChanged="Inputs_Changed">
                <ComboBoxItem Content="Tüm Markalar" IsSelected="True"/>
            </ComboBox>

            <TextBlock Text="Uygulama:" Margin="0,8,0,2"/>
            <ComboBox x:Name="AppCombo" SelectionChanged="Inputs_Changed">
                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                <ComboBoxItem Content="Sirkülasyon"/>
                <ComboBoxItem Content="Basınçlandırma"/>
                <ComboBoxItem Content="Hidrofor"/>
            </ComboBox>

            <Button Content="🔍 Pompa Seç" Click="SelectPump_Click"
                    Height="32" Margin="0,14,0,0" FontWeight="Bold"/>

            <Separator Background="#444" Margin="0,16,0,12"/>

            <!-- Kavitasyon Kontrolü -->
            <TextBlock Text="KAVİTASYON KONTROLÜ" FontWeight="Bold" FontSize="13"
                       Foreground="#FFDDAA" Margin="0,0,0,8"/>

            <TextBlock Text="Emme Yüksekliği (m):" Margin="0,4,0,2"/>
            <TextBox x:Name="TxtSuctionHeight" Text="-1.0"/>

            <TextBlock Text="Emme Hattı Kaybı (mSS):" Margin="0,8,0,2"/>
            <TextBox x:Name="TxtSuctionLoss" Text="0.5"/>

            <TextBlock Text="Su Sıcaklığı (°C):" Margin="0,8,0,2"/>
            <TextBox x:Name="TxtWaterTemp" Text="20"/>

            <Button Content="💧 Kavitasyon Kontrol Et" Click="CheckCavitation_Click"
                    Height="30" Margin="0,12,0,0"/>

            <Border Background="#1A2233" BorderBrush="#445" BorderThickness="1" Margin="0,10,0,0" Padding="8">
                <TextBlock x:Name="CavitationResult" TextWrapping="Wrap" FontSize="11"
                           Foreground="#AADDFF" Text="Pompa seçilince kavitasyon kontrolü yapılabilir."/>
            </Border>
        </StackPanel>

        <!-- SAĞ PANEL: Grafik + Tablo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- Q-H Grafiği -->
            <Border Grid.Row="0" BorderBrush="#445" BorderThickness="1" Margin="0,0,0,8">
                <Grid>
                    <skia:SKElement x:Name="PumpChart" PaintSurface="PumpChart_PaintSurface"
                                    Margin="0"/>
                    <TextBlock x:Name="ChartPlaceholder"
                               Text="Pompa seçmek için sol paneldeki parametreleri girin ve 'Pompa Seç' butonuna basın."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#666" FontSize="13" TextWrapping="Wrap" Margin="20"/>
                </Grid>
            </Border>

            <!-- Öneri Tablosu -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="ÖNERİLEN POMPALAR" FontWeight="Bold" FontSize="13"
                               Foreground="#AADDFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DutyPointLabel" Margin="20,0,0,0" FontSize="11"
                               Foreground="#AAFFAA" VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="PumpGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="PumpGrid_SelectionChanged"
                          HeadersVisibility="Column" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Marka"    Binding="{Binding Brand}"     Width="70"/>
                        <DataGridTextColumn Header="Model"    Binding="{Binding ModelName}"  Width="*"/>
                        <DataGridTextColumn Header="Q_max"   Binding="{Binding MaxFlowStr}"  Width="65"/>
                        <DataGridTextColumn Header="H_max"   Binding="{Binding MaxHeadStr}"  Width="65"/>
                        <DataGridTextColumn Header="Güç(kW)" Binding="{Binding PowerStr}"    Width="65"/>
                        <DataGridTextColumn Header="Verim"   Binding="{Binding EffStr}"      Width="55"/>
                        <DataGridTextColumn Header="Bağlantı" Binding="{Binding Connection}" Width="65"/>
                        <DataGridTextColumn Header="Uygulama" Binding="{Binding Application}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
