<Window x:Class="Afney.Cad.Presentation.Dialogs.WallParallelRouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧱 Duvara Paralel Boru Çizme — AfneyCAD" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="DUVARA PARALEL BORU ROTALAMA" FontSize="18" FontWeight="Bold" Foreground="#7CFC00" Margin="0,0,0,15"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Duvar Ofset (mm):" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="OffsetInput" Width="80" Text="150" Background="#333" Foreground="White" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Boru Çapı (mm):" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="DiameterInput" Width="80" Text="20" Background="#333" Foreground="White" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Duvar Seçimi:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="WallSourceCombo" Width="350" HorizontalAlignment="Left" Background="#333" Foreground="Black" SelectedIndex="0">
                <ComboBoxItem Content="Otomatik — Mimari tanımlı duvarlar"/>
                <ComboBoxItem Content="Manuel — Koordinat girişi"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#AAA" FontSize="12" TextWrapping="Wrap" Margin="0,10"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔨 Rotalama Yap" Click="Route_Click" Width="130" Height="32" Background="#2E8B57" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0"/>
            <Button Content="İptal" Click="Cancel_Click" Width="80" Height="32" Background="#555" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
