<Window x:Class="Afney.Cad.Presentation.Dialogs.ProjectInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proje Bilgileri" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C24" Foreground="#E1E4EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PROJE BİLGİLERİ" FontSize="14" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Proje Adı:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtProjeName" Foreground="#E1E4EE" VerticalAlignment="Center" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Text="Dosya Yolu:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFilePath" Foreground="#E1E4EE" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Row="2" Text="Oluşturma:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCreatedDate" Foreground="#E1E4EE" VerticalAlignment="Center" FontFamily="Consolas"/>

            <TextBlock Grid.Row="3" Text="Son Değişiklik:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtModifiedDate" Foreground="#E1E4EE" VerticalAlignment="Center" FontFamily="Consolas"/>

            <TextBlock Grid.Row="4" Text="Entity Sayısı:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtEntityCount" Foreground="#2ECC71" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold"/>

            <TextBlock Grid.Row="5" Text="Katman Sayısı:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtLayerCount" Foreground="#E1E4EE" VerticalAlignment="Center" FontFamily="Consolas"/>

            <TextBlock Grid.Row="6" Text="Sürüm:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="AfneyCAD v4.0.0" Foreground="#0A84FF" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold"/>

            <TextBlock Grid.Row="7" Text="Motor:" Foreground="#858899" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text=".NET 10 / WPF / SkiaSharp" Foreground="#858899" VerticalAlignment="Center" FontFamily="Consolas"/>
        </Grid>

        <Button Grid.Row="2" Content="Tamam" Width="90" Height="32" HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                IsDefault="True" Click="Ok_Click"/>
    </Grid>
</Window>
