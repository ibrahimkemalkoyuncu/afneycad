<Window x:Class="Afney.Cad.Presentation.Dialogs.WaterMeterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💧 Su Sayacı Seçimi — TS EN 14154" Height="500" Width="580"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💧 Su Sayacı Seçimi" FontSize="14" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  TS EN 14154 — DN'e göre Qnom + Δp" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="⚙️ Hesapla" Width="100" Margin="0,0,8,0" Click="Calculate_Click" Background="#1B5E20"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <StackPanel>
            <Border Background="#252535" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="TxtPeakFlow" Text="Pik debi: — (DB'den hesaplanacak)" Foreground="#FFA040" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtRecommended" Text="Önerilen: —" Foreground="#90CAF9" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPressureLoss" Text="Kayıp Basınç: —" Foreground="#90CAF9"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="OptionsGrid" Height="240" AutoGenerateColumns="False" Margin="0,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DN"          Binding="{Binding DN}"             Width="50"/>
                    <DataGridTextColumn Header="Qnom (m³/h)" Binding="{Binding QnomM3h}"        Width="90"/>
                    <DataGridTextColumn Header="Qmax (m³/h)" Binding="{Binding QmaxM3h}"        Width="90"/>
                    <DataGridTextColumn Header="Δp (mSS)"    Binding="{Binding PressureLossM}"  Width="80"/>
                    <DataGridTextColumn Header="Uygun mu?"   Binding="{Binding SuitableText}"   Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
