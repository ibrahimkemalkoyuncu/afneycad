<Window x:Class="Afney.Cad.Presentation.Dialogs.FixtureLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔧 Reseptör Kütüphanesi — AfneyCAD" Height="600" Width="750"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="VİTRİFİYE KATALOĞU (TS 1258 / DIN 1988)" FontSize="18" FontWeight="Bold" Foreground="#7CFC00" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CategoryFilter" Width="200" Background="#333" Foreground="Black" SelectionChanged="CategoryFilter_Changed">
                <ComboBoxItem Content="Tümü" IsSelected="True"/>
            </ComboBox>
            <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="200" Background="#333" Foreground="White" TextChanged="SearchBox_Changed"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#AAA"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="FixtureGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#252535" Foreground="White" RowBackground="#2A2A3A" AlternatingRowBackground="#1E1E2E"
                  BorderBrush="#555" GridLinesVisibility="All" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                <DataGridTextColumn Header="İsim (TR)" Binding="{Binding NameTR}" Width="170"/>
                <DataGridTextColumn Header="İsim (EN)" Binding="{Binding NameEN}" Width="150"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="90"/>
                <DataGridTextColumn Header="LU" Binding="{Binding LoadUnit}" Width="45"/>
                <DataGridTextColumn Header="Soğuk DN" Binding="{Binding MinColdWaterDN}" Width="70"/>
                <DataGridTextColumn Header="Sıcak DN" Binding="{Binding MinHotWaterDN}" Width="70"/>
                <DataGridTextColumn Header="Pis Su DN" Binding="{Binding WasteDN}" Width="70"/>
                <DataGridTextColumn Header="Q (l/s)" Binding="{Binding FlowRateLps}" Width="60"/>
                <DataGridTextColumn Header="Standart" Binding="{Binding Standard}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kapat" Click="Close_Click" Width="80" Height="32" Background="#555" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
