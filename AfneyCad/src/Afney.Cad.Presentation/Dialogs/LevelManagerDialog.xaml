<Window x:Class="Afney.Cad.Presentation.Dialogs.LevelManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kat Yöneticisi - Level Manager" 
        Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🏢" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Proje Katları" FontSize="20" FontWeight="Bold" Foreground="#00AAFF" VerticalAlignment="Center"/>
            <TextBlock Text=" — Level Manager" FontSize="13" Foreground="#666" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
        </StackPanel>
        
        <!-- KAT LİSTESİ -->
        <DataGrid x:Name="LevelsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                  Background="#252526" RowBackground="#2D2D30" AlternatingRowBackground="#333333"
                  Foreground="White" BorderThickness="1" BorderBrush="#3E3E42"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3E3E42" 
                  Margin="0,0,0,10" RowHeight="32"
                  SelectionChanged="LevelsGrid_SelectionChanged"
                  ItemsSource="{Binding Levels}">
            
            <DataGrid.Resources>
                <!-- Column Header -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1B1B1C"/>
                    <Setter Property="Foreground" Value="#FFA500"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter Property="BorderBrush" Value="#444"/>
                </Style>
                <!-- Selection Colors -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3E3E42"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CCC"/>
                
                <!-- Row Style -->
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3E3E42"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <!-- Cell Style -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Kat Adı" Binding="{Binding Name}" Width="*" FontSize="13">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kot (mm)" Binding="{Binding Elevation, StringFormat=F0}" Width="120" FontSize="13">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#44DD88"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Yük (mm)" Binding="{Binding Height, StringFormat=F0}" Width="120" FontSize="13">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#66BBFF"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Input Panel -->
        <Border Grid.Row="2" Background="#2B2B2C" Padding="12" Margin="0,0,0,12" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Kat Adı:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,8,0" FontSize="12"/>
                <TextBox Grid.Column="1" x:Name="NameTextBox" Margin="0,0,12,0" Padding="6,4" 
                         Background="#1E1E1E" Foreground="White" BorderBrush="#555" BorderThickness="1"
                         FontSize="12" CaretBrush="White"/>
                
                <TextBlock Grid.Column="2" Text="Kot:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,8,0" FontSize="12"/>
                <TextBox Grid.Column="3" x:Name="ElevationTextBox" Margin="0,0,12,0" Padding="6,4" 
                         Background="#1E1E1E" Foreground="#44DD88" BorderBrush="#555" BorderThickness="1"
                         FontSize="12" Text="0" CaretBrush="White"/>
                
                <TextBlock Grid.Column="4" Text="Yükseklik:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,8,0" FontSize="12"/>
                <TextBox Grid.Column="5" x:Name="HeightTextBox" Padding="6,4" 
                         Background="#1E1E1E" Foreground="#66BBFF" BorderBrush="#555" BorderThickness="1"
                         FontSize="12" Text="3000" CaretBrush="White"/>
            </Grid>
        </Border>
        
        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: İsim Değiştir -->
            <Button Grid.Column="0" Content="✏️ İsim Değiştir" Click="RenameButton_Click" Width="120"
                    Background="#4A3A6A" Foreground="White" Padding="8,6" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" ToolTip="Seçili katın ismini değiştir"/>

            <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="#44DD88" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- Sağ: Ana butonlar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="➕ Ekle" Click="AddButton_Click" Width="90" Margin="0,0,5,0" 
                        Background="#2A7A2A" Foreground="White" Padding="8,6" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="✏️ Güncelle" Click="UpdateButton_Click" Width="100" Margin="0,0,5,0" 
                        Background="#2A5A7A" Foreground="White" Padding="8,6" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="🗑️ Sil" Click="DeleteButton_Click" Width="80" Margin="0,0,5,0" 
                        Background="#7A2A2A" Foreground="White" Padding="8,6" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Rectangle Width="8"/>
                <Button Content="💾 Kaydet" Click="SaveButton_Click" Width="100" Margin="0,0,5,0" 
                        Background="#1A6A1A" Foreground="#44FF88" Padding="8,6" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        ToolTip="Kat bilgilerini projeye kaydet"/>
                <Button Content="Kapat" Click="CloseButton_Click" Width="80" 
                        Background="#555" Foreground="White" Padding="8,6" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
