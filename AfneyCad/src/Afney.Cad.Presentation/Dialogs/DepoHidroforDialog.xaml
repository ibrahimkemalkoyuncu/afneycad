<Window x:Class="Afney.Cad.Presentation.Dialogs.DepoHidroforDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏗️ Su Deposu / Hidrofor Seçimi — TS 1258" Height="620" Width="640"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/><Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Ico.OfficeBuilding}" Fill="#90CAF9" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Su Deposu / Hidrofor Seçimi" FontSize="14" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  TS 1258 / TS EN 806-3" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt buton çubuğu -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77AA77" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="Calculate_Click" Background="#1B5E20" Width="110" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Cog}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Hesapla" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Giriş Parametreleri -->
                <GroupBox Header="GİRİŞ PARAMETRELERİ">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Kişi Sayısı:" Margin="0,3"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtPersons" Text="50" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kişi Başı Su (L/gün):" Margin="0,3"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtLpd" Text="150" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="TS 1258" Foreground="#667" FontSize="9" Margin="4,3,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Depolama Günü:" Margin="0,3"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtDays" Text="1.5" Margin="0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Statik Yükseklik (m):" Margin="0,3"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtHead" Text="20" Margin="0,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pompa Güvenlik Kat.:" Margin="0,3"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtSafety" Text="1.2" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- Sonuçlar -->
                <GroupBox Header="HESAP SONUÇLARI">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Günlük Su İhtiyacı:" Foreground="#90CAF9"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResDailyDemand" Text="—" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Depo Hacmi (hesap):" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResTankVol" Text="—" FontWeight="Bold" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Önerilen Depo:" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResTankModel" Text="—" Margin="0,3,0,0" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Toplam LU (DB):" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResLU" Text="—" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Pik Debi (Walther):" Foreground="#FFA040" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResPeakFlow" Text="—" FontWeight="Bold" Foreground="#FFA040" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Pompa Debisi:" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ResPumpFlow" Text="—" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Manometrik Yükseklik:" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ResPumpHead" Text="—" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Önerilen Pompa/Hidrofor:" Foreground="#90CAF9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ResPumpModel" Text="—" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

                <!-- Uyarılar -->
                <Border x:Name="WarningPanel" Visibility="Collapsed" Background="#332200" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource Ico.Warning}" Fill="#FFA040" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="UYARILAR" Foreground="#FFA040" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="WarningText" Foreground="#FFCC80" TextWrapping="Wrap" FontSize="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
