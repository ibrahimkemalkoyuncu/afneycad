<Window x:Class="Afney.Cad.Presentation.Dialogs.ClashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Çakışma Analizi Raporu" Height="450" Width="800"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333337"/>
                        <Setter Property="Foreground" Value="LightGray"/>
                        <Setter Property="Padding" Value="5,5,5,5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryTextBlock" Text="Çakışma analiz sonuçları yükleniyor..." FontSize="16" FontWeight="Bold" Foreground="#32CD32"/>
            <TextBlock Text="Bulunan çakışmalar (Clashes) aşağıda listelenmiştir. İşaretli varlıkları 3D modelleme ekranında kırmızıyla vurgulanmış halde görebilirsiniz." Foreground="LightGray" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid x:Name="ClashesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ClashesDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Durum" Binding="{Binding IsApproved}" Width="60"/>
                <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="150"/>
                <DataGridTextColumn Header="Şiddet" Binding="{Binding Severity}" Width="100"/>
                <DataGridTextColumn Header="Varlık (Entity A)" Binding="{Binding EntityA_Id}" Width="250"/>
                <DataGridTextColumn Header="Detay/Mesaj" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✅ Seçili Olanı Onayla (Yoksay)" Click="ApproveClash_Click" Width="200" Height="30" Margin="0,0,10,0" Background="#44DD88" Foreground="Black" BorderThickness="0"/>
            <Button Content="CSV'ye Aktar" Click="ExportCsv_Click" Width="100" Height="30" Margin="0,0,10,0" Background="#333337" Foreground="White" BorderBrush="#3F3F46"/>
            <Button Content="Kapat" Click="Close_Click" Width="100" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
