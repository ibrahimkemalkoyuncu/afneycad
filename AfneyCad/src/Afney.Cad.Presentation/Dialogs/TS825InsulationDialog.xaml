<Window x:Class="Afney.Cad.Presentation.Dialogs.TS825InsulationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧱 TS 825 Isı Yalıtım Hesabı — Binalarda Isı Yalıtım Kuralları"
        Height="640" Width="1040"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252530" BorderBrush="#555" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#2A2A3E"/><Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,4"/>
            <Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
            <Setter Property="CanUserAddRows" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="14,8">
            <StackPanel>
                <TextBlock Text="TS 825 — Isı Yalıtım ve Isı Kaybı Hesabı" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="TS 825:2013 Tablo 2 (max U) · TS EN ISO 6946 (yüzeysel direnç) · 4 iklim bölgesi"
                           FontSize="11" Foreground="#BBD6FF" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- İçerik: 3 kolon -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: Girdiler -->
            <Border Grid.Column="0" Background="#232334" Padding="12" Margin="0,0,8,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Genel Parametreler" FontWeight="Bold" Foreground="#90CAF9" Margin="0,0,0,8"/>

                    <TextBlock Text="İklim Bölgesi (TS 825)"/>
                    <ComboBox x:Name="CmbZone" Margin="0,2,0,8" SelectionChanged="OnZoneOrElementChanged">
                        <ComboBoxItem Content="1. Bölge — İzmir, Antalya, Adana"/>
                        <ComboBoxItem Content="2. Bölge — İstanbul, Balıkesir"/>
                        <ComboBoxItem Content="3. Bölge — Ankara, Bursa, Konya" IsSelected="True"/>
                        <ComboBoxItem Content="4. Bölge — Erzurum, Kars, Ağrı"/>
                    </ComboBox>

                    <TextBlock Text="Yapı Elemanı"/>
                    <ComboBox x:Name="CmbElement" Margin="0,2,0,8" SelectionChanged="OnZoneOrElementChanged">
                        <ComboBoxItem Content="Dış Duvar" IsSelected="True"/>
                        <ComboBoxItem Content="Çatı / Teras"/>
                        <ComboBoxItem Content="Döşeme (Zemin)"/>
                        <ComboBoxItem Content="Pencere / Kapı"/>
                    </ComboBox>

                    <TextBlock Text="Alan (m²)"/>
                    <TextBox x:Name="TxtArea" Text="100" Margin="0,2,0,8"/>

                    <TextBlock Text="İç Sıcaklık (°C)"/>
                    <TextBox x:Name="TxtIndoor" Text="20" Margin="0,2,0,8"/>

                    <TextBlock Text="Dış Sıcaklık (°C) — boş = TS 825 bölge"/>
                    <TextBox x:Name="TxtOutdoor" Text="" Margin="0,2,0,8"/>

                    <TextBlock Text="Yalıtım λ (W/mK)  (EPS≈0.035)"/>
                    <TextBox x:Name="TxtInsLambda" Text="0.035" Margin="0,2,0,8"/>

                    <Border x:Name="WindowUPanel" Background="#2A2A3E" Padding="8" CornerRadius="3" Margin="0,4,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Pencere/Kapı U (W/m²K)" Foreground="#FFD740"/>
                            <TextBox x:Name="TxtWindowU" Text="1.80" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtLimitInfo" Margin="0,10,0,0" FontSize="11" Foreground="#A5D6A7"
                               TextWrapping="Wrap" Text="TS 825 sınır U: —"/>
                </StackPanel>
            </Border>

            <!-- ORTA: Katman tablosu -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Yapı Katmanları (iç → dış)" FontWeight="Bold" Foreground="#90CAF9" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" x:Name="LayerGrid" AutoGenerateColumns="False" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda}" Width="110"/>
                        <DataGridTextColumn Header="Kalınlık (m)" Binding="{Binding Kalinlik}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Click="OnFillSampleLayers" Background="#455A64">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.Plus}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Örnek Katmanlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnClearLayers" Background="#5D4037">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.Trash}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Temizle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Not: Pencere/Kapı seçilirse U doğrudan sol panelden girilir." FontSize="11"
                               Foreground="#8FA3C0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- SAĞ: Sonuçlar -->
            <Border Grid.Column="2" Background="#232334" Padding="12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Sonuçlar" FontWeight="Bold" Foreground="#90CAF9" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtResults" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="#1B1B2A" BorderThickness="0" Height="470"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                             Text="Hesaplamak için 'Hesapla' butonuna basın."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alt butonlar -->
        <Border Grid.Row="2" Background="#1B1B2E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnCalculate" Background="#2E7D32">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Calculator}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Hesapla" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnHtmlReport">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.Globe}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="HTML Rapor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnAddToDrawing" Background="#455A64">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.FileDocument}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Çizime Metin Ekle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Kapat" Click="OnClose" Background="#37474F"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
