<Window x:Class="Afney.Cad.Presentation.Dialogs.FireFightingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔥 Yangın Söndürme (Sprinkler) Hesabı — AfneyCAD" Height="550" Width="650"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="SPRİNKLER SİSTEMİ TASARIMI (NFPA 13 / EN 12845)" FontSize="16" FontWeight="Bold" Foreground="#FF4444" Margin="0,0,0,15"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Margin="0,5"><TextBlock Text="Koruma Alanı (m²):" Width="150"/><TextBox x:Name="AreaInput" Width="80" Text="500" Background="#333" Foreground="White"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5"><TextBlock Text="Tavan Yüksekliği (m):" Width="150"/><TextBox x:Name="HeightInput" Width="80" Text="3.0" Background="#333" Foreground="White"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5"><TextBlock Text="Dış Basınç (mSS):" Width="150"/><TextBox x:Name="PressureInput" Width="80" Text="0" Background="#333" Foreground="White"/></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Tehlike Sınıfı:" Margin="0,5"/>
                <ComboBox x:Name="HazardCombo" Width="220" Background="#333" Foreground="Black" SelectedIndex="0">
                    <ComboBoxItem Content="Hafif Tehlike (Ofis, Konut)"/>
                    <ComboBoxItem Content="Orta Tehlike G1 (Otopark)"/>
                    <ComboBoxItem Content="Orta Tehlike G2 (Ağır Depo)"/>
                    <ComboBoxItem Content="Yüksek Tehlike (Kimyasal)"/>
                </ComboBox>
                <CheckBox x:Name="WetSystemCheck" Content="Islak Sistem" IsChecked="True" Foreground="White" Margin="0,10"/>
                <Button Content="🔄 Hesapla" Click="Calculate_Click" Width="150" Height="32" Margin="0,10" Background="#FF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="ResultText" Foreground="#00FF88" FontSize="13" TextWrapping="Wrap" Margin="0,10"/>
        <Button Grid.Row="3" Content="Kapat" Click="Close_Click" Width="80" Height="30" HorizontalAlignment="Right" Background="#555" Foreground="White" BorderThickness="0"/>
    </Grid>
</Window>
