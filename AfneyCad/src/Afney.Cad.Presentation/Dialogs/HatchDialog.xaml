<Window x:Class="Afney.Cad.Presentation.Dialogs.HatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hatch / Alan Dolgulama" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C24" Foreground="#E1E4EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="HATCH PATTERN SEÇİMİ" FontSize="14" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,0,12"/>

        <!-- Pattern Listesi -->
        <ListBox x:Name="PatternList" Grid.Row="1"
                 Background="#12141A" Foreground="#E1E4EE"
                 BorderBrush="#252836" BorderThickness="1"
                 SelectionChanged="PatternList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,3">
                        <Border Width="28" Height="28" CornerRadius="3" Margin="0,0,10,0"
                                Background="{Binding ColorBrush}" BorderBrush="#444" BorderThickness="1"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#E1E4EE"/>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#858899"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Ayarlar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ölçek:" VerticalAlignment="Center" Foreground="#858899" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtScale" Grid.Column="1" Text="1.0" Height="28"
                     Background="#12141A" Foreground="#E1E4EE" BorderBrush="#0A84FF" BorderThickness="1"
                     FontFamily="Consolas" Padding="6,0" VerticalContentAlignment="Center"/>
            <TextBlock Text="Açı:" Grid.Column="2" VerticalAlignment="Center" Foreground="#858899" Margin="16,0,8,0"/>
            <TextBox x:Name="TxtAngle" Grid.Column="3" Text="0" Height="28"
                     Background="#12141A" Foreground="#E1E4EE" BorderBrush="#252836" BorderThickness="1"
                     FontFamily="Consolas" Padding="6,0" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Butonlar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtInfo" Text="" Foreground="#2ECC71" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Uygula" Click="Apply_Click" Width="90" Height="32"
                    Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="İptal" IsCancel="True" Width="80" Height="32"
                    Background="#24273A" Foreground="#858899" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
