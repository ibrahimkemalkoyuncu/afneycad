<Window x:Class="Afney.Cad.Presentation.Dialogs.WasteWaterCalcSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pis Su Hesap Föyü — AfneyCAD"
        Height="720" Width="1100" WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252530" BorderBrush="#555" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="26"/>
                    <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252530"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
</Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="#252535"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/>
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCEE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="🔵" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="PİS SU TESİSAT HESAPLARI (HESAP FÖYİ)" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="TS EN 12056-2 · Manning Formülü · DU Yöntemi / DIN Normu"
                               FontSize="10" Foreground="#90CAF9"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Çizimden Güncelle" Click="UpdateFromDrawing_Click"
                            Background="#2E7D32" Margin="0,0,8,0"/>
                    <Button Content="⚙ Hesapla" Click="Calculate_Click"
                            Background="#1565C0" Margin="0,0,8,0"/>
                    <Button Content="✅ Tesisatı Kabul Et" Click="AcceptSystem_Click"
                            Background="#4A148C"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sekmeler -->
        <TabControl Grid.Row="1" Background="#1E1E2E" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#252535"/>
                    <Setter Property="Foreground" Value="#888"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#0D47A1"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ── SEKME 1: HESAP FÖYİ ── -->
            <TabItem Header="📋 Hesap Föyü">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="CalcGrid" AutoGenerateColumns="False" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"             Binding="{Binding SegmentNo}"     Width="40"/>
                            <DataGridTextColumn Header="Segment ID"    Binding="{Binding SegmentId}"     Width="90"/>
                            <DataGridTextColumn Header="Tür"           Binding="{Binding PipeType}"      Width="65"/>
                            <DataGridTextColumn Header="Boy (m)"       Binding="{Binding LengthM}"       Width="70"/>
                            <DataGridTextColumn Header="DU"            Binding="{Binding LoadUnits}"     Width="55"/>
                            <DataGridTextColumn Header="Q (l/s)"       Binding="{Binding DesignFlowLs}"  Width="70"/>
                            <DataGridTextColumn Header="DN (mm)"       Binding="{Binding DiameterMm}"    Width="65"/>
                            <DataGridTextColumn Header="Eğim %"        Binding="{Binding SlopePct}"      Width="65"/>
                            <DataGridTextColumn Header="Hız (m/s)"     Binding="{Binding VelocityMs}"    Width="75"/>
                            <DataGridTextColumn Header="Doluluk %"     Binding="{Binding FillRatio}"     Width="80"/>
                            <DataGridTextColumn Header="Kap. (l/s)"    Binding="{Binding CapacityLs}"    Width="80"/>
                            <DataGridTextColumn Header="Durum / Uyarı" Binding="{Binding Warnings}"      Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="False">
                                        <Setter Property="Foreground" Value="#FFD54F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Özet Şerit -->
                    <Border Grid.Row="1" Background="#0A1A2A" Padding="12,8" BorderBrush="#1565C0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A2A3A" CornerRadius="4" Padding="8,5" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM SEGMENT" FontSize="9" Foreground="#90CAF9"/>
                                        <TextBlock x:Name="TxtTotalSegments" Text="—" FontSize="13" FontWeight="Bold" Foreground="#90CAF9"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1A2A3A" CornerRadius="4" Padding="8,5" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM BOY" FontSize="9" Foreground="#80CBC4"/>
                                        <TextBlock x:Name="TxtTotalLength" Text="—" FontSize="13" FontWeight="Bold" Foreground="#80CBC4"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1A2A3A" CornerRadius="4" Padding="8,5" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="UYARI SAYISI" FontSize="9" Foreground="#EF9A9A"/>
                                        <TextBlock x:Name="TxtWarningCount" Text="—" FontSize="13" FontWeight="Bold" Foreground="#EF9A9A"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtCalcStatus" Text=""
                                       Foreground="#69F0AE" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── SEKME 2: DEVRE SEÇENEKLERİ ── -->
            <TabItem Header="⚙ Devre Seçenekleri">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <GroupBox Header="Hesap Yöntemi">
                            <StackPanel>
                                <RadioButton x:Name="RbDU" Content="Sarfiyat Birimi (DU) Yöntemi — TS EN 12056-2"
                                             Foreground="White" IsChecked="True" Margin="0,4"/>
                                <RadioButton x:Name="RbDIN" Content="DIN Normu — DIN 1986 / K=1.0"
                                             Foreground="White" Margin="0,4"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bina ve Sistem Parametreleri">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Bina Tipi:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbBuildingType" Margin="0,4">
                                    <ComboBoxItem Content="Konut" IsSelected="True"/>
                                    <ComboBoxItem Content="Ofis"/>
                                    <ComboBoxItem Content="Otel"/>
                                    <ComboBoxItem Content="Hastane"/>
                                    <ComboBoxItem Content="Endüstriyel"/>
                                </ComboBox>

                                <Label Grid.Row="0" Grid.Column="2" Content="Akış Katsayısı (K):"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtKFactor" Text="0.5" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Boru Cinsi:"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbPipeMaterial" Margin="0,4">
                                    <ComboBoxItem Content="PVC" IsSelected="True"/>
                                    <ComboBoxItem Content="HDPE"/>
                                    <ComboBoxItem Content="PP"/>
                                    <ComboBoxItem Content="Beton"/>
                                    <ComboBoxItem Content="DökmeDemir"/>
                                    <ComboBoxItem Content="Vitrify"/>
                                </ComboBox>

                                <Label Grid.Row="1" Grid.Column="2" Content="Pürüzlülük (Manning n):"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtManningN" Text="0.011" Margin="0,4"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Ana Eğim (%):"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDefaultSlope" Text="2.0" Margin="0,4"/>

                                <Label Grid.Row="2" Grid.Column="2" Content="Branşman Max Doluluk:"/>
                                <TextBox Grid.Row="2" Grid.Column="3" x:Name="TxtMaxFill" Text="50" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="TS EN 12056-2 Boru Tablosu (Referans)">
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      FontSize="11" RowHeaderWidth="0" Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DN (mm)"       Width="80"  Binding="{Binding DN}"/>
                                    <DataGridTextColumn Header="Min Eğim (%)"  Width="100" Binding="{Binding MinSlope}"/>
                                    <DataGridTextColumn Header="Max Q (l/s)"   Width="100" Binding="{Binding MaxQ}"/>
                                    <DataGridTextColumn Header="Kullanım"      Width="*"   Binding="{Binding Usage}"/>
                                </DataGrid.Columns>
                                <DataGrid.Items>
                                    <x:Array Type="{x:Type system:Object}" xmlns:system="clr-namespace:System;assembly=mscorlib"/>
                                </DataGrid.Items>
                                <DataGrid.Tag>RefTable</DataGrid.Tag>
                            </DataGrid>
                        </GroupBox>

                        <Button Content="Seçenekleri Uygula ve Hesapla" Click="Calculate_Click"
                                Width="250" HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── SEKME 3: KAPALICROIX / FOSEPTİK ── -->
            <TabItem Header="🔵 Çukur / Foseptik / Pompa">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <GroupBox Header="Kapalı Çukur &amp; Foseptik Hesabı (TS 8358)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Çukur Tipi:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbPitType" Margin="0,4">
                                    <ComboBoxItem Content="Foseptik" IsSelected="True"/>
                                    <ComboBoxItem Content="Kapalı Çukur"/>
                                    <ComboBoxItem Content="Emdirme Çukuru"/>
                                </ComboBox>

                                <Label Grid.Row="0" Grid.Column="2" Content="Kişi Sayısı:"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtPersonCount" Text="10" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Kişi Başı Günlük Su (lt/kişi/gün):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDailyWater" Text="150" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="2" Content="Bekleme Süresi (gün):"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtRetentionDays" Text="3" Margin="0,4"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Çamur Faktörü:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSludgeFactor" Text="1.5" Margin="0,4"/>

                                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                        Content="Foseptik Hesapla" Click="CalcSeptic_Click"
                                        Background="#4A148C" Margin="0,8,8,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- Foseptik Sonucu -->
                        <Border x:Name="SepticResultPanel" Background="#0A1A2A" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,12" BorderBrush="#4A148C" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="FOSEPTİK HESAP SONUCU" FontSize="11" FontWeight="Bold"
                                           Foreground="#CE93D8" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtSepticResult" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#E1BEE7" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Emdirme Çukuru (Perkolasyon) -->
                        <GroupBox Header="Emdirme Çukuru Hesabı (Perkolasyon) — TS 7880">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Perkolasyon Hızı (L/m²/gün):"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPercolationRate" Text="50" Margin="0,4"/>

                                <Label Grid.Row="0" Grid.Column="2" Content="Güvenlik Faktörü:"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtSoakSafetyFactor" Text="2.0" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Çukur Derinliği (m):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPitDepth" Text="2.0" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="2" Content="Çukur Çapı (m):"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtPitDiameter" Text="1.5" Margin="0,4"/>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Content="Emdirme Hesapla" Click="CalcSoakPit_Click"
                                        Background="#00695C" Margin="0,8,8,0"/>
                            </Grid>
                        </GroupBox>

                        <Border x:Name="SoakPitResultPanel" Background="#081A18" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,12" BorderBrush="#00695C" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="EMDİRME ÇUKURU HESAP SONUCU" FontSize="11" FontWeight="Bold"
                                           Foreground="#80CBC4" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtSoakPitResult" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#B2DFDB" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="Pis Su Pompası Hesabı">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Giriş Debisi (l/s):"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtInflowLs" Text="1.0" Margin="0,4"/>

                                <Label Grid.Row="0" Grid.Column="2" Content="Statik Yük (m):"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtStaticH" Text="8.0" Margin="0,4"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Sump Hacmi (m³, 0=oto):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSumpVolume" Text="0" Margin="0,4"/>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Content="Pompa Hesapla" Click="CalcPump_Click"
                                        Background="#1B5E20" Margin="0,8,8,0"/>
                            </Grid>
                        </GroupBox>

                        <Border x:Name="PumpResultPanel" Background="#0A1A0A" CornerRadius="6"
                                Padding="14,10" BorderBrush="#2E7D32" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtPumpResult" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#A5D6A7" LineHeight="20"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── SEKME 4: KEŞİF LİSTESİ ── -->
            <TabItem Header="📦 Keşif Listesi">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Content="🔄 Listele" Click="RefreshBOM_Click" Margin="0,0,8,0"/>
                        <Button Content="📊 CSV Dışa Aktar" Click="ExportBomCsv_Click"
                                Background="#2E7D32" Margin="0,0,8,0"/>
                        <Button Content="🌐 HTML Keşif" Click="ExportBomHtml_Click"
                                Background="#005A9C"/>
                        <TextBlock x:Name="TxtCatalogInfo" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11" Foreground="#8FA3C0"
                                   Text="Katalog: dahili 2024 listesi"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="BomGrid" AutoGenerateColumns="False" Margin="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poz No"        Binding="{Binding PozNo}"      Width="90"/>
                            <DataGridTextColumn Header="Malzeme / Tanım" Binding="{Binding Material}" Width="*"/>
                            <DataGridTextColumn Header="DN"            Binding="{Binding Dn}"         Width="55"/>
                            <DataGridTextColumn Header="Miktar"        Binding="{Binding Length}"     Width="80"/>
                            <DataGridTextColumn Header="Adet"          Binding="{Binding Count}"      Width="55"/>
                            <DataGridTextColumn Header="Birim"         Binding="{Binding Unit}"       Width="55"/>
                            <DataGridTextColumn Header="B.Fiyat (₺)"   Binding="{Binding UnitPrice}"  Width="90"/>
                            <DataGridTextColumn Header="Toplam (₺)"    Binding="{Binding TotalPrice}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Kabul Durumu Şeridi -->
        <Border Grid.Row="2" x:Name="AcceptanceBar" Background="#1A2A1A"
                Padding="12,6" Visibility="Collapsed">
            <TextBlock x:Name="TxtAcceptanceStatus" Text="" Foreground="#69F0AE"
                       FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Butonlar -->
        <Border Grid.Row="3" Background="#1B1B2E" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📄 HTML Rapor" Click="ExportHtml_Click" Margin="0,0,8,0"/>
                <Button Content="🏛 Kolon Şeması" Click="RiserDiagram_Click"
                        Background="#4A148C" Margin="0,0,8,0"/>
                <Button Content="✏ Çizimi Güncelle" Click="UpdateDrawing_Click"
                        Background="#2E7D32" Margin="0,0,8,0"/>
                <Button Content="Kapat" Click="Close_Click" Background="#444" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
