<Window x:Class="Afney.Cad.Presentation.Dialogs.ManufacturerCatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📦 Üretici Ekipman Kataloğu — Grundfos · Wilo · Valsir · Wavin · Geberit"
        Height="680" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#1A2A1A" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦 Üretici Ekipman Kataloğu" FontSize="15" FontWeight="Bold" Foreground="#A5D6A7"/>
                <TextBlock Text="  Grundfos · Wilo · Valsir · Wavin · Geberit · Honeywell · Danfoss"
                           FontSize="10" Foreground="#66AA66" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt butonlar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#77CC77" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✅ Seç ve Kapat" Width="130" Margin="0,0,8,0" Click="SelectAndClose_Click" Background="#2E7D32"/>
                <Button Grid.Column="2" Content="📄 Detay Rapor" Width="110" Margin="0,0,8,0" Click="ExportReport_Click" Background="#455A64"/>
                <Button Grid.Column="3" Content="Kapat" Width="80" Click="Close_Click" Background="#333"/>
            </Grid>
        </Border>

        <TabControl Background="#252535" BorderThickness="0">

            <!-- ───── SEKME 1: POMPALAR ───── -->
            <TabItem Header="🔄 Pompalar">
                <DockPanel Margin="8">
                    <!-- Filtre satırı -->
                    <Border DockPanel.Dock="Top" Background="#0A2040" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Üretici:" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboPumpMfr" Width="120" Margin="0,0,12,0" SelectionChanged="PumpFilter_Changed">
                                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                                <ComboBoxItem Content="Grundfos"/>
                                <ComboBoxItem Content="Wilo"/>
                            </ComboBox>
                            <TextBlock Text="Debi (m³/h):" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPumpFlow" Text="" Width="70" Margin="0,0,12,0"/>
                            <TextBlock Text="Basma Yük. (m):" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPumpHead" Text="" Width="70" Margin="0,0,12,0"/>
                            <Button Content="🔍 Filtrele" Width="90" Click="PumpFilter_Changed" Background="#0277BD"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="PumpGrid" Grid.Column="0" AutoGenerateColumns="False"
                                  SelectionChanged="PumpGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Model"           Binding="{Binding ModelName}"   Width="160"/>
                                <DataGridTextColumn Header="Üretici"         Binding="{Binding Manufacturer}" Width="85"/>
                                <DataGridTextColumn Header="Max Q (m³/h)"    Binding="{Binding MaxFlowM3h, StringFormat=F1}"  Width="85"/>
                                <DataGridTextColumn Header="Max H (m)"       Binding="{Binding MaxHeadM, StringFormat=F1}"    Width="70"/>
                                <DataGridTextColumn Header="Motor (kW)"      Binding="{Binding NomPowerKw, StringFormat=F3}"  Width="75"/>
                                <DataGridTextColumn Header="Verim (%)"       Binding="{Binding MaxEffPct, StringFormat=F0}"   Width="65"/>
                                <DataGridTextColumn Header="Bağlantı"        Binding="{Binding ConnectionDN}" Width="70"/>
                                <DataGridTextColumn Header="Uygulama"        Binding="{Binding Application}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Sağ: Seçilen pompa detayı -->
                        <Border Grid.Column="2" Background="#0A2040" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="SEÇİLEN POMPA" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock x:Name="PumpDetailName" Text="—" FontSize="13" FontWeight="Bold" Foreground="#FFD740" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Seri:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PumpDetailSeries" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Debi:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PumpDetailFlow" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Basma Yük.:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PumpDetailHead" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Motor Gücü:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PumpDetailPower" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Verim:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PumpDetailEff" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Devir:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PumpDetailRPM" Text="—" Margin="0,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Ağırlık:" Foreground="#90CAF9" Margin="0,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PumpDetailWeight" Text="—" Margin="0,3"/>
                                </Grid>
                                <!-- Q/H Eğrisi metin -->
                                <TextBlock Text="Q/H Eğrisi Noktaları:" Foreground="#90CAF9" Margin="0,8,0,4" FontSize="11"/>
                                <TextBlock x:Name="PumpCurveText" Text="—" Foreground="#A5D6A7" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ───── SEKME 2: BORULAR ───── -->
            <TabItem Header="🔧 Borular">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="#0A2040" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Üretici:" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboPipeMfr" Width="120" Margin="0,0,12,0" SelectionChanged="PipeFilter_Changed">
                                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                                <ComboBoxItem Content="Valsir"/>
                                <ComboBoxItem Content="Wavin"/>
                                <ComboBoxItem Content="Geberit"/>
                            </ComboBox>
                            <TextBlock Text="Malzeme:" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboPipeMat" Width="120" Margin="0,0,12,0" SelectionChanged="PipeFilter_Changed">
                                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                                <ComboBoxItem Content="PPR"/>
                                <ComboBoxItem Content="PEX"/>
                                <ComboBoxItem Content="HDPE"/>
                            </ComboBox>
                            <TextBlock Text="Min DN:" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtMinDN" Text="" Width="60" Margin="0,0,12,0"/>
                            <Button Content="🔍 Filtrele" Width="90" Click="PipeFilter_Changed" Background="#0277BD"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PipeGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model"         Binding="{Binding ModelName}"               Width="180"/>
                            <DataGridTextColumn Header="Üretici"       Binding="{Binding Manufacturer}"            Width="80"/>
                            <DataGridTextColumn Header="Malzeme"       Binding="{Binding Material}"                Width="70"/>
                            <DataGridTextColumn Header="DN"            Binding="{Binding DN}"                      Width="45"/>
                            <DataGridTextColumn Header="OD (mm)"       Binding="{Binding OD, StringFormat=F1}"     Width="65"/>
                            <DataGridTextColumn Header="Et (mm)"       Binding="{Binding WallThickMm, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="ID (mm)"       Binding="{Binding ID, StringFormat=F1}"     Width="60"/>
                            <DataGridTextColumn Header="PN (bar)"      Binding="{Binding PN, StringFormat=F0}"     Width="55"/>
                            <DataGridTextColumn Header="T_max (°C)"    Binding="{Binding TempMaxC, StringFormat=F0}" Width="70"/>
                            <DataGridTextColumn Header="Pürüzlülük (m)" Binding="{Binding RoughnessM, StringFormat=E1}" Width="90"/>
                            <DataGridTextColumn Header="Standart"      Binding="{Binding Standard}"                Width="120"/>
                            <DataGridTextColumn Header="TL/m"          Binding="{Binding PricePerMtr, StringFormat=F0}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ───── SEKME 3: VANALAR ───── -->
            <TabItem Header="🔩 Vanalar">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="#0A2040" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Üretici:" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboValveMfr" Width="120" Margin="0,0,12,0" SelectionChanged="ValveFilter_Changed">
                                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                                <ComboBoxItem Content="Honeywell"/>
                                <ComboBoxItem Content="Danfoss"/>
                                <ComboBoxItem Content="Oventrop"/>
                            </ComboBox>
                            <TextBlock Text="Tip:" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboValveType" Width="160" Margin="0,0,12,0" SelectionChanged="ValveFilter_Changed">
                                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                                <ComboBoxItem Content="Küresel Vana"/>
                                <ComboBoxItem Content="Dengeleme Vanası"/>
                                <ComboBoxItem Content="Ayar Vanası"/>
                            </ComboBox>
                            <TextBlock Text="Q (m³/h):" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtValveFlow" Text="" Width="60" Margin="0,0,12,0"/>
                            <Button Content="🔍 ΔP Hesapla" Width="100" Click="ValveFilter_Changed" Background="#0277BD"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ValveGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model"           Binding="{Binding ModelName}"             Width="200"/>
                            <DataGridTextColumn Header="Üretici"         Binding="{Binding Manufacturer}"          Width="90"/>
                            <DataGridTextColumn Header="Tip"             Binding="{Binding ValveType}"             Width="130"/>
                            <DataGridTextColumn Header="DN"              Binding="{Binding DN}"                    Width="45"/>
                            <DataGridTextColumn Header="Kv (m³/h)"      Binding="{Binding Kv, StringFormat=F1}"   Width="80"/>
                            <DataGridTextColumn Header="PN (bar)"        Binding="{Binding PN, StringFormat=F0}"   Width="65"/>
                            <DataGridTextColumn Header="T_max (°C)"      Binding="{Binding TempMaxC, StringFormat=F0}" Width="70"/>
                            <DataGridTextColumn Header="Gövde"           Binding="{Binding BodyMaterial}"          Width="80"/>
                            <DataGridTextColumn Header="ΔP (kPa)"       Binding="{Binding DeltaPKpa, StringFormat=F2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
