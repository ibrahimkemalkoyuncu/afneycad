<Window x:Class="Afney.Cad.Presentation.Dialogs.ValveLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vana Kütüphanesi — AfneyCAD" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="#252535"/><Setter Property="AlternatingRowBackground" Value="#2A2A3E"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D3060"/><Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Başlık -->
        <Border DockPanel.Dock="Top" Background="#0D3060" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔧 Vana Kütüphanesi" FontSize="15" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock Text="  TS EN 1074 / TS EN 1776" FontSize="10" Foreground="#7799BB" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Alt buton çubuğu -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="" Foreground="#77AA77" VerticalAlignment="Center"/>
                <Button x:Name="BtnInsert" Grid.Column="1" Content="+ Çizime Ekle" Width="120" Margin="0,0,8,0"
                        Click="Insert_Click" Background="#1B5E20" IsEnabled="False"/>
                <Button Grid.Column="2" Content="Kapat" Width="80" Click="Cancel_Click" Background="#333"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Katalog tablosu -->
            <DataGrid Grid.Column="0" x:Name="ValveGrid" AutoGenerateColumns="False"
                      SelectionChanged="ValveGrid_SelectionChanged"
                      MouseDoubleClick="ValveGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kod"      Binding="{Binding Id}"              Width="75"/>
                    <DataGridTextColumn Header="Vana Adı" Binding="{Binding NameTR}"           Width="*"/>
                    <DataGridTextColumn Header="Tip"      Binding="{Binding Type}"             Width="90"/>
                    <DataGridTextColumn Header="DN (mm)"  Binding="{Binding NominalDiameter}"  Width="65"/>
                    <DataGridTextColumn Header="Zeta ζ"   Binding="{Binding LossCoefficient}"  Width="60"/>
                    <DataGridTextColumn Header="Standart" Binding="{Binding Standard}"         Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- Detay + Yerleştirme -->
            <Border Grid.Column="2" Background="#252535" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="VANA DETAYI" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DtlName"   Text="—" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DtlId"     Text="" Foreground="#667" FontSize="10" Margin="0,0,0,8"/>
                    <Separator Background="#444" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Çap (DN):" Foreground="#90CAF9" FontSize="11"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DtlDN" Text="—" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Zeta (ζ):" Foreground="#90CAF9" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DtlZeta" Text="—" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tip:" Foreground="#90CAF9" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DtlType" Text="—" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Standart:" Foreground="#90CAF9" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DtlStd" Text="—" Margin="0,4,0,0"/>
                    </Grid>

                    <Separator Background="#444" Margin="0,10,0,8"/>
                    <TextBlock Text="YERLEŞTİRME KONUMU" Foreground="#90CAF9" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X:"/>
                        <TextBox   Grid.Column="1" x:Name="TxtX" Text="0"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y:"/>
                        <TextBox   Grid.Column="1" x:Name="TxtY" Text="0"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dönüş °:" Margin="0,0,4,0"/>
                        <TextBox   Grid.Column="1" x:Name="TxtRot" Text="0"/>
                    </Grid>
                    <TextBlock Text="(Boru üstüne denk gelirse otomatik bölünür)" Foreground="#667"
                               FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
