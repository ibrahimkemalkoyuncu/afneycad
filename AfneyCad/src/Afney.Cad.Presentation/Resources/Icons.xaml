    <!-- ══ Yeniden Kullanılabilir DataTrigger Stilleri (Katman satırları) ══════
         AutoCAD 2026 kuralı: ikonlar varsayılan durumda da RENKLİ (soluk gri değil) —
         ampul=sarı, güneş/kartanesi=turuncu/camgöbeği, kilit=camgöbeği-mavi. -->
    <Style x:Key="Icon.LayerVisibility" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Ico.Lightbulb}"/>
        <Setter Property="Fill" Value="#FFD24B"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <Setter Property="Data" Value="{StaticResource Ico.LightbulbOff}"/>
                <Setter Property="Fill" Value="{StaticResource IconFillMuted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Icon.LayerFreeze" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Ico.Sun}"/>
        <Setter Property="Fill" Value="#FF9F45"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                <Setter Property="Data" Value="{StaticResource Ico.Snowflake}"/>
                <Setter Property="Fill" Value="{StaticResource IconFillAccent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Icon.LayerLock" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Ico.LockOutline}"/>
        <Setter Property="Fill" Value="#5AC8FA"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                <Setter Property="Data" Value="{StaticResource Ico.LockClosed}"/>
                <Setter Property="Fill" Value="{StaticResource IconFillWarning}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
