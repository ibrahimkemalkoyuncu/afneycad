<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        NE: Merkezi İkon Kütüphanesi (Icons.xaml)
        NEDEN: Uygulama genelinde tutarlı, net, font'tan bağımsız vektör ikonlar kullanmak için.
               Emoji glifleri sistem/tema bağımlı render edilip bulanık/okunaksız görünebiliyordu;
               bu dosya her ikonu tek noktadan yönetir (Material Design 24x24 viewBox geometrileri).
        KULLANIM: App.xaml içinde merge edilir. Bir dialogda şöyle kullanılır:
               <Viewbox Width="16" Height="16">
                   <Path Data="{StaticResource Ico.Eye}" Fill="{StaticResource IconFillDefault}"/>
               </Viewbox>
    -->

    <!-- ══ İkon Renk Paleti ══════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="IconFillDefault"  Color="#E4E8F0"/>
    <SolidColorBrush x:Key="IconFillMuted"    Color="#7C8494"/>
    <SolidColorBrush x:Key="IconFillAccent"   Color="#5AC8FA"/>
    <SolidColorBrush x:Key="IconFillWarning"  Color="#FFC24B"/>
    <SolidColorBrush x:Key="IconFillDanger"   Color="#FF6B60"/>
    <SolidColorBrush x:Key="IconFillSuccess"  Color="#5FD08A"/>

    <!-- İkon butonu için yuvarlak hover/basılı arka planı — tüm ikon butonlarında paylaşılır -->
    <Style x:Key="IconButtonRound" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E3646"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#39435A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

