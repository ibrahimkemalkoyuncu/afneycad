<Project Sdk="Microsoft.NET.Sdk">

  <!--
     NE: Lisans Anahtarı Üretme Aracı (Afney.Cad.LicenseTool)
     NEDEN: LicenseManager.GenerateKey önceden `public`ti ve müşteriye sevk edilen
            Afney.Cad.Application.dll içinde duruyordu — herhangi bir kullanıcı reflection ile
            kendi lisansını üretebilirdi. Anahtar üretimi artık SADECE bu ayrı, satış/aktivasyon
            ekibi dışında kimseye dağıtılmayan konsol aracından yapılabiliyor (Application projesindeki
            InternalsVisibleTo ile yetkilendirilmiş internal metoda erişerek).
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Afney.Cad.Application\Afney.Cad.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Afney.Cad.LicenseTool</AssemblyName>
    <RootNamespace>Afney.Cad.LicenseTool</RootNamespace>
  </PropertyGroup>

</Project>
